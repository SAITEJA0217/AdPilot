      "html": "\n<div class=\"min-h-screen bg-[var(--k-color-bg-page)] text-[var(--k-color-text-primary)] font-[var(--k-font-family-body)] selection:bg-[var(--k-color-accent)] selection:text-black overflow-x-clip relative\" data-kid=\"0\">\n    \n    \n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"1\">\n    <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"2\">\n    <style data-kid=\"3\">\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Sans:wght@400;500;700&display=swap');\n\n        /* Noise Grain */\n        .noise-grain::after {\n            content: \"\";\n            position: absolute;\n            inset: 0;\n            z-index: 50;\n            pointer-events: none;\n            opacity: 0.04;\n            background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n        }\n\n        /* Custom Utilities */\n        .glass-highlight {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 1px;\n            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);\n            pointer-events: none;\n        }\n\n        .neon-glow-border {\n            position: absolute;\n            inset: -1.5px;\n            border-radius: inherit;\n            border: 1.5px solid var(--k-color-accent);\n            pointer-events: none;\n            box-shadow: 0 0 12px rgba(223, 0, 255, 0.2), 0 0 36px rgba(223, 0, 255, 0.06);\n        }\n\n        /* Accordion Custom Styles */\n        .accordion-content {\n            display: grid;\n            grid-template-rows: 0fr;\n            transition: grid-template-rows 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n        .accordion-item[data-state=\"open\"] .accordion-content {\n            grid-template-rows: 1fr;\n        }\n        .accordion-item[data-state=\"open\"] .accordion-trigger i {\n            transform: rotate(180deg);\n        }\n\n        /* Diagonal Ramp Line */\n        .diagonal-ramp-line {\n            position: absolute;\n            top: 55%;\n            left: 50%;\n            width: 150%;\n            height: 2px;\n            background: linear-gradient(90deg, transparent, rgba(223, 0, 255, 0.08), transparent);\n            transform: translate(-50%, -50%) rotate(-10deg);\n            z-index: 0;\n            pointer-events: none;\n        }\n\n        .ramp-card {\n            box-shadow: var(--k-shadow-md);\n            position: relative;\n            overflow: hidden;\n        }\n        .ramp-card::before {\n            content: \"\";\n            position: absolute;\n            inset: 0;\n            background: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\");\n            opacity: 0.02;\n            pointer-events: none;\n        }\n    </style>\n\n    <div class=\"noise-grain fixed inset-0 pointer-events-none z-50\" data-kid=\"4\"></div>\n\n    \n    <header class=\"fixed top-0 left-0 right-0 z-40 bg-[var(--k-color-bg-page)]/80 backdrop-blur-md border-b border-[var(--k-color-border)]\" data-kid=\"5\">\n        <div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\" data-kid=\"6\">\n            <div class=\"flex items-center gap-3\" data-kid=\"7\">\n                <div class=\"w-10 h-10 bg-[var(--k-color-accent)] rounded-lg flex items-center justify-center\" data-kid=\"8\">\n                    <i class=\"ti ti-chart-dots-3 text-black text-2xl\" data-kid=\"9\"></i>\n                </div>\n                <span class=\"font-[var(--k-font-family-heading)] font-bold text-xl tracking-tight\" data-kid=\"10\">AdAudit AI</span>\n            </div>\n            <nav class=\"hidden md:flex items-center gap-8 text-[var(--k-color-text-muted)] text-sm font-medium\" data-kid=\"11\">\n                <a href=\"#\" class=\"hover:text-[var(--k-color-text-primary)] transition-colors\" data-kid=\"12\">Product</a>\n                <a href=\"#\" class=\"hover:text-[var(--k-color-text-primary)] transition-colors\" data-kid=\"13\">Solution</a>\n                <a href=\"#\" class=\"text-[var(--k-color-text-primary)]\" data-kid=\"14\">Pricing</a>\n                <a href=\"#\" class=\"hover:text-[var(--k-color-text-primary)] transition-colors\" data-kid=\"15\">Resources</a>\n            </nav>\n            <div class=\"flex items-center gap-4\" data-kid=\"16\">\n                <button class=\"px-5 py-2 text-sm font-medium text-[var(--k-color-text-secondary)] hover:text-[var(--k-color-text-primary)] transition-colors\" data-kid=\"17\">Log In</button>\n                <button class=\"px-5 py-2 text-sm font-bold bg-[var(--k-color-accent)] text-black rounded-lg hover:bg-[var(--k-color-primary-hover)] transition-all shadow-[0_0_20px_rgba(223,0,255,0.2)]\" data-kid=\"18\">Get Started</button>\n            </div>\n        </div>\n    </header>\n\n    <main data-kid=\"19\">\n        \n        <section class=\"relative pt-32 pb-24 overflow-hidden\" data-kid=\"20\">\n            <div class=\"absolute top-0 right-0 w-2/3 h-full bg-[radial-gradient(circle_at_80%_20%,rgba(223,0,255,0.08),transparent_60%)] pointer-events-none\" data-kid=\"21\"></div>\n            <div class=\"max-w-7xl mx-auto px-6 relative z-10 flex flex-col lg:flex-row items-center gap-16\" data-kid=\"22\">\n                <div class=\"lg:w-3/5\" data-kid=\"23\">\n                    <div class=\"inline-flex items-center gap-2 px-3 py-1 bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)] text-[var(--k-color-accent)] text-[10px] font-black uppercase tracking-[0.3em] mb-8 gsap-reveal-hero\" data-kid=\"24\">\n                        Transparent Billing\n                    </div>\n                    <h1 class=\"font-[var(--k-font-family-heading)] text-6xl md:text-7xl font-bold tracking-tight mb-8 gsap-reveal-hero leading-[1.05]\" data-kid=\"25\">\n                        Simple pricing for <br data-kid=\"26\">\n                        <span class=\"italic font-normal font-sans opacity-80\" data-kid=\"27\">complex</span> performance.\n                    </h1>\n                    <p class=\"text-xl text-[var(--k-color-text-muted)] max-w-xl leading-relaxed gsap-reveal-hero mb-10\" data-kid=\"28\">\n                        We built AdAudit AI to be accessible for everyone from the solo buyer to the global agency. No per-user fees, just audit power.\n                    </p>\n                    <div class=\"flex items-center gap-6 gsap-reveal-hero\" data-kid=\"29\">\n                        <div class=\"flex -space-x-3\" data-kid=\"30\">\n                            <img src=\"https://i.pravatar.cc/40?u=1\" class=\"w-10 h-10 rounded-full border-2 border-black\" alt=\"user\" decoding=\"async\" loading=\"lazy\" data-kid=\"31\">\n                            <img src=\"https://i.pravatar.cc/40?u=2\" class=\"w-10 h-10 rounded-full border-2 border-black\" alt=\"user\" decoding=\"async\" loading=\"lazy\" data-kid=\"32\">\n                            <img src=\"https://i.pravatar.cc/40?u=3\" class=\"w-10 h-10 rounded-full border-2 border-black\" alt=\"user\" decoding=\"async\" loading=\"lazy\" data-kid=\"33\">\n                        </div>\n                        <div class=\"text-sm font-medium\" data-kid=\"34\">\n                            <span class=\"text-[var(--k-color-text-primary)]\" data-kid=\"35\">Used by 2.5k+ marketers</span>\n                            <div class=\"text-[var(--k-color-text-muted)] flex items-center gap-1\" data-kid=\"36\">\n                                <i class=\"ti ti-star-filled text-[var(--k-color-warning)] text-xs\" data-kid=\"37\"></i> 4.9/5 satisfaction rate\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"lg:w-2/5 relative gsap-reveal-hero\" data-kid=\"38\">\n                    \n                    <div class=\"relative bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)] p-6 rounded-2xl shadow-2xl rotate-3\" data-kid=\"39\">\n                        <div class=\"flex items-center justify-between mb-6\" data-kid=\"40\">\n                            <div class=\"text-xs font-bold uppercase tracking-widest text-[var(--k-color-text-muted)]\" data-kid=\"41\">Live Audit Status</div>\n                            <div class=\"w-2 h-2 rounded-full bg-[var(--k-color-success)] animate-pulse\" data-kid=\"42\"></div>\n                        </div>\n                        <div class=\"space-y-4\" data-kid=\"43\">\n                            <div class=\"h-2 w-full bg-[var(--k-color-border)] rounded-full overflow-hidden\" data-kid=\"44\">\n                                <div class=\"h-full bg-[var(--k-color-accent)] w-3/4\" data-kid=\"45\"></div>\n                            </div>\n                            <div class=\"flex justify-between items-center text-sm font-bold\" data-kid=\"46\">\n                                <span data-kid=\"47\">Wasted Spend Found</span>\n                                <span class=\"text-[var(--k-color-error)]\" data-kid=\"48\">$1,240.50</span>\n                            </div>\n                            <div class=\"grid grid-cols-2 gap-3 pt-2\" data-kid=\"49\">\n                                <div class=\"p-3 bg-black/40 rounded-lg border border-white/5\" data-kid=\"50\">\n                                    <div class=\"text-[10px] text-[var(--k-color-text-muted)]\" data-kid=\"51\">Efficiency</div>\n                                    <div class=\"text-lg\" data-kid=\"52\">+18%</div>\n                                </div>\n                                <div class=\"p-3 bg-black/40 rounded-lg border border-white/5\" data-kid=\"53\">\n                                    <div class=\"text-[10px] text-[var(--k-color-text-muted)]\" data-kid=\"54\">ROAS Lift</div>\n                                    <div class=\"text-lg\" data-kid=\"55\">2.4x</div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"absolute -bottom-6 -left-6 bg-[var(--k-color-accent)] text-black p-4 rounded-xl shadow-xl -rotate-6 font-black text-center\" data-kid=\"56\">\n                        <div class=\"text-[10px] uppercase tracking-tighter\" data-kid=\"57\">Savings Potential</div>\n                        <div class=\"text-3xl\" data-kid=\"58\">$12k+</div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-24 relative\" data-kid=\"59\">\n            <div class=\"max-w-7xl mx-auto px-6 relative z-10\" data-kid=\"60\">\n                <div class=\"flex flex-col lg:flex-row items-end justify-center gap-8\" data-kid=\"61\">\n                    \n                    \n                    <div class=\"ramp-card w-full lg:w-[330px] h-[480px] bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)] rounded-2xl p-10 relative flex flex-col gsap-pricing-card hover:bg-[var(--k-color-bg-surface-hover)] group\" data-kid=\"62\">\n                        <div class=\"glass-highlight\" data-kid=\"63\"></div>\n                        <div class=\"mb-auto\" data-kid=\"64\">\n                            <div class=\"flex items-center gap-2 mb-4\" data-kid=\"65\">\n                                <i class=\"ti ti-seedling text-[var(--k-color-text-muted)]\" data-kid=\"66\"></i>\n                                <h3 class=\"font-[var(--k-font-family-heading)] text-lg font-bold\" data-kid=\"67\">Free</h3>\n                            </div>\n                            <p class=\"text-[var(--k-color-text-muted)] text-sm mb-10 leading-relaxed\" data-kid=\"68\">Essential auditing for independent experimenters.</p>\n                            <div class=\"mb-10\" data-kid=\"69\">\n                                <span class=\"text-5xl font-bold tracking-tighter\" data-kid=\"70\">$0</span>\n                                <span class=\"text-sm text-[var(--k-color-text-muted)]\" data-kid=\"71\">/ forever</span>\n                            </div>\n                            <ul class=\"space-y-4 border-t border-[var(--k-color-border)] pt-8\" data-kid=\"72\">\n                                <li class=\"flex items-center gap-3 text-sm text-[var(--k-color-text-secondary)]\" data-kid=\"73\">\n                                    <i class=\"ti ti-check text-[var(--k-color-success)]\" data-kid=\"74\"></i> 1 CSV Audit / month\n                                </li>\n                                <li class=\"flex items-center gap-3 text-sm text-[var(--k-color-text-secondary)]\" data-kid=\"75\">\n                                    <i class=\"ti ti-check text-[var(--k-color-success)]\" data-kid=\"76\"></i> Basic Health Score\n                                </li>\n                                <li class=\"flex items-center gap-3 text-sm text-[var(--k-color-text-muted)] opacity-50\" data-kid=\"77\">\n                                    <i class=\"ti ti-lock\" data-kid=\"78\"></i> AI Recommendations\n                                </li>\n                            </ul>\n                        </div>\n                        <button class=\"w-full py-4 rounded-xl border border-[var(--k-color-border)] font-bold transition-all text-xs uppercase tracking-widest group-hover:border-[var(--k-color-text-primary)]\" data-kid=\"79\">Start Now</button>\n                    </div>\n\n                    \n                    <div class=\"ramp-card w-full lg:w-[360px] h-[580px] bg-[#1A171A] border border-[var(--k-color-accent)]/40 rounded-2xl p-12 relative flex flex-col gsap-pricing-card z-20 shadow-[0_30px_100px_-30px_rgba(223,0,255,0.12)] group\" data-kid=\"80\">\n                        <div class=\"neon-glow-border !opacity-40\" data-kid=\"81\"></div>\n                        <div class=\"glass-highlight\" data-kid=\"82\"></div>\n                        \n                        <div class=\"mb-auto\" data-kid=\"83\">\n                            <div class=\"flex items-center justify-between mb-4\" data-kid=\"84\">\n                                <div class=\"flex items-center gap-2\" data-kid=\"85\">\n                                    <i class=\"ti ti-rocket text-[var(--k-color-accent)]\" data-kid=\"86\"></i>\n                                    <h3 class=\"font-[var(--k-font-family-heading)] text-2xl font-bold text-[var(--k-color-accent)]\" data-kid=\"87\">Pro</h3>\n                                </div>\n                                <span class=\"px-3 py-1 bg-[var(--k-color-accent)] text-black text-[9px] font-black uppercase tracking-widest rounded-full\" data-kid=\"88\">Recommended</span>\n                            </div>\n                            <p class=\"text-[var(--k-color-text-muted)] text-sm mb-10 leading-relaxed font-medium\" data-kid=\"89\">Advanced tools for serious growth marketers.</p>\n                            <div class=\"mb-10\" data-kid=\"90\">\n                                <span class=\"text-7xl font-bold tracking-tighter\" data-kid=\"91\">$49</span>\n                                <span class=\"text-lg text-[var(--k-color-text-muted)] font-medium\" data-kid=\"92\">/mo</span>\n                            </div>\n                            <ul class=\"space-y-5 border-t border-[var(--k-color-accent)]/20 pt-8\" data-kid=\"93\">\n                                <li class=\"flex items-center gap-4 text-sm\" data-kid=\"94\">\n                                    <i class=\"ti ti-check text-[var(--k-color-accent)] text-xl\" data-kid=\"95\"></i>\n                                    <span class=\"font-bold\" data-kid=\"96\">Unlimited CSV Audits</span>\n                                </li>\n                                <li class=\"flex items-center gap-4 text-sm\" data-kid=\"97\">\n                                    <i class=\"ti ti-check text-[var(--k-color-accent)] text-xl\" data-kid=\"98\"></i>\n                                    <span class=\"font-bold\" data-kid=\"99\">AI Action Items</span>\n                                </li>\n                                <li class=\"flex items-center gap-4 text-sm\" data-kid=\"100\">\n                                    <i class=\"ti ti-check text-[var(--k-color-accent)] text-xl\" data-kid=\"101\"></i>\n                                    <span class=\"font-bold\" data-kid=\"102\">Multi-network support</span>\n                                </li>\n                            </ul>\n                        </div>\n                        <button class=\"w-full py-5 rounded-xl bg-[var(--k-color-accent)] text-black font-black hover:scale-[1.02] transition-transform shadow-[0_12px_40px_-10px_rgba(223,0,255,0.4)] text-xs uppercase tracking-[0.2em]\" data-kid=\"103\">Scale Faster</button>\n                    </div>\n\n                    \n                    <div class=\"ramp-card w-full lg:w-[330px] h-[680px] bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)] rounded-2xl p-10 relative flex flex-col gsap-pricing-card hover:bg-[var(--k-color-bg-surface-hover)] group\" data-kid=\"104\">\n                        <div class=\"glass-highlight\" data-kid=\"105\"></div>\n                        <div class=\"mb-auto\" data-kid=\"106\">\n                            <div class=\"flex items-center gap-2 mb-4\" data-kid=\"107\">\n                                <i class=\"ti ti-building text-[var(--k-color-text-muted)]\" data-kid=\"108\"></i>\n                                <h3 class=\"font-[var(--k-font-family-heading)] text-xl font-bold\" data-kid=\"109\">Enterprise</h3>\n                            </div>\n                            <p class=\"text-[var(--k-color-text-muted)] text-sm mb-10 leading-relaxed font-medium\" data-kid=\"110\">Custom high-volume agency solutions.</p>\n                            <div class=\"mb-10\" data-kid=\"111\">\n                                <span class=\"text-5xl font-bold tracking-tighter text-[var(--k-color-text-primary)]\" data-kid=\"112\">Custom</span>\n                                <span class=\"text-sm text-[var(--k-color-text-muted)] block mt-2\" data-kid=\"113\">Tailored pricing</span>\n                            </div>\n                            <ul class=\"space-y-4 border-t border-[var(--k-color-border)] pt-8\" data-kid=\"114\">\n                                <li class=\"flex items-center gap-3 text-sm text-[var(--k-color-text-secondary)]\" data-kid=\"115\">\n                                    <i class=\"ti ti-check text-[var(--k-color-success)]\" data-kid=\"116\"></i> Everything in Pro\n                                </li>\n                                <li class=\"flex items-center gap-3 text-sm text-[var(--k-color-text-secondary)]\" data-kid=\"117\">\n                                    <i class=\"ti ti-check text-[var(--k-color-success)]\" data-kid=\"118\"></i> Account Manager\n                                </li>\n                                <li class=\"flex items-center gap-3 text-sm text-[var(--k-color-text-secondary)]\" data-kid=\"119\">\n                                    <i class=\"ti ti-check text-[var(--k-color-success)]\" data-kid=\"120\"></i> API & Webhooks\n                                </li>\n                                <li class=\"flex items-center gap-3 text-sm text-[var(--k-color-text-secondary)]\" data-kid=\"121\">\n                                    <i class=\"ti ti-check text-[var(--k-color-success)]\" data-kid=\"122\"></i> White-labeling\n                                </li>\n                            </ul>\n                        </div>\n                        <button class=\"w-full py-4 rounded-xl border border-[var(--k-color-border)] font-bold transition-all text-xs uppercase tracking-widest group-hover:border-[var(--k-color-text-primary)]\" data-kid=\"123\">Contact Sales</button>\n                    </div>\n\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-32 bg-[var(--k-color-bg-surface)]/30\" data-kid=\"124\">\n            <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"125\">\n                <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-20\" data-kid=\"126\">\n                    <div data-kid=\"127\">\n                        <div class=\"inline-block px-3 py-1 rounded-full bg-[var(--k-color-border)] border border-white/5 text-[var(--k-color-text-muted)] text-[10px] font-bold uppercase tracking-widest mb-4\" data-kid=\"128\">Support</div>\n                        <h2 class=\"font-[var(--k-font-family-heading)] text-4xl md:text-5xl font-bold mb-6\" data-kid=\"129\">Frequently <br data-kid=\"130\"><span class=\"text-[var(--k-color-accent)]\" data-kid=\"131\">Asked</span> Questions</h2>\n                        <p class=\"text-[var(--k-color-text-muted)] text-lg max-w-md leading-relaxed mb-10\" data-kid=\"132\">\n                            Can't find what you're looking for? Reach out to our dedicated support team for help.\n                        </p>\n                        <a href=\"#\" class=\"inline-flex items-center gap-2 text-[var(--k-color-accent)] font-bold hover:gap-3 transition-all\" data-kid=\"133\">\n                            Visit Help Center <i class=\"ti ti-arrow-right\" data-kid=\"134\"></i>\n                        </a>\n                    </div>\n\n                    <div class=\"space-y-2\" data-kid=\"135\">\n                        \n                        <div class=\"accordion-item border-b border-[var(--k-color-border)]\" data-state=\"closed\" data-kid=\"136\">\n                            <button class=\"accordion-trigger w-full flex items-center justify-between py-6 text-left focus:outline-hidden group\" data-kid=\"137\">\n                                <span class=\"text-xl font-medium group-hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"138\">How many networks do you support?</span>\n                                <div class=\"w-8 h-8 rounded-full border border-[var(--k-color-border)] flex items-center justify-center group-hover:border-[var(--k-color-accent)] transition-all\" data-kid=\"139\">\n                                    <i class=\"ti ti-chevron-down text-lg transition-transform duration-300\" data-kid=\"140\"></i>\n                                </div>\n                            </button>\n                            <div class=\"accordion-content overflow-hidden\" data-kid=\"141\">\n                                <div class=\"pb-6 pr-12 text-[var(--k-color-text-secondary)] leading-relaxed\" data-kid=\"142\">\n                                    AdAudit AI currently supports Google Ads, Meta Ads (Facebook & Instagram), and TikTok Ads. We are launching LinkedIn and Twitter support in Q4 2024.\n                                </div>\n                            </div>\n                        </div>\n\n                        \n                        <div class=\"accordion-item border-b border-[var(--k-color-border)]\" data-state=\"closed\" data-kid=\"143\">\n                            <button class=\"accordion-trigger w-full flex items-center justify-between py-6 text-left focus:outline-hidden group\" data-kid=\"144\">\n                                <span class=\"text-xl font-medium group-hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"145\">Is my ad data secure with you?</span>\n                                <div class=\"w-8 h-8 rounded-full border border-[var(--k-color-border)] flex items-center justify-center group-hover:border-[var(--k-color-accent)] transition-all\" data-kid=\"146\">\n                                    <i class=\"ti ti-chevron-down text-lg transition-transform duration-300\" data-kid=\"147\"></i>\n                                </div>\n                            </button>\n                            <div class=\"accordion-content overflow-hidden\" data-kid=\"148\">\n                                <div class=\"pb-6 pr-12 text-[var(--k-color-text-secondary)] leading-relaxed\" data-kid=\"149\">\n                                    Absolutely. We use enterprise-grade encryption for all data transfers. Your CSV files are processed in a secure environment and are automatically deleted after the audit is complete. We do not sell or share your campaign data with anyone.\n                                </div>\n                            </div>\n                        </div>\n\n                        \n                        <div class=\"accordion-item border-b border-[var(--k-color-border)]\" data-state=\"closed\" data-kid=\"150\">\n                            <button class=\"accordion-trigger w-full flex items-center justify-between py-6 text-left focus:outline-hidden group\" data-kid=\"151\">\n                                <span class=\"text-xl font-medium group-hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"152\">What kind of \"Action Items\" do you provide?</span>\n                                <div class=\"w-8 h-8 rounded-full border border-[var(--k-color-border)] flex items-center justify-center group-hover:border-[var(--k-color-accent)] transition-all\" data-kid=\"153\">\n                                    <i class=\"ti ti-chevron-down text-lg transition-transform duration-300\" data-kid=\"154\"></i>\n                                </div>\n                            </button>\n                            <div class=\"accordion-content overflow-hidden\" data-kid=\"155\">\n                                <div class=\"pb-6 pr-12 text-[var(--k-color-text-secondary)] leading-relaxed\" data-kid=\"156\">\n                                    Our AI identifies wasted spend on duplicate keywords, poor-performing placements, budget-draining non-converting hours, and audience overlap across different networks. Each audit gives you a step-by-step list of exactly what to pause, increase, or fix.\n                                </div>\n                            </div>\n                        </div>\n\n                        \n                        <div class=\"accordion-item border-b border-[var(--k-color-border)]\" data-state=\"closed\" data-kid=\"157\">\n                            <button class=\"accordion-trigger w-full flex items-center justify-between py-6 text-left focus:outline-hidden group\" data-kid=\"158\">\n                                <span class=\"text-xl font-medium group-hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"159\">Can I use this for my clients?</span>\n                                <div class=\"w-8 h-8 rounded-full border border-[var(--k-color-border)] flex items-center justify-center group-hover:border-[var(--k-color-accent)] transition-all\" data-kid=\"160\">\n                                    <i class=\"ti ti-chevron-down text-lg transition-transform duration-300\" data-kid=\"161\"></i>\n                                </div>\n                            </button>\n                            <div class=\"accordion-content overflow-hidden\" data-kid=\"162\">\n                                <div class=\"pb-6 pr-12 text-[var(--k-color-text-secondary)] leading-relaxed\" data-kid=\"163\">\n                                    Yes! The Pro and Enterprise plans are designed for agency use. The Enterprise plan specifically allows for white-labeled reporting so you can send professional PDF audits directly to your clients with your own branding.\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"py-40 relative bg-black border-t border-[var(--k-color-border)]\" data-kid=\"164\">\n            <div class=\"absolute inset-0 bg-[radial-gradient(circle_at_50%_100%,rgba(223,0,255,0.1),transparent_50%)]\" data-kid=\"165\"></div>\n            <div class=\"max-w-7xl mx-auto px-6 text-center relative z-10\" data-kid=\"166\">\n                <h2 class=\"font-[var(--k-font-family-heading)] text-5xl md:text-8xl font-bold tracking-tighter mb-8 max-w-4xl mx-auto leading-[1.1]\" data-kid=\"167\">\n                    Reclaim your <br class=\"hidden md:block\" data-kid=\"168\"> <span class=\"text-[var(--k-color-accent)]\" data-kid=\"169\">ad budget</span> today.\n                </h2>\n                <p class=\"text-xl text-[var(--k-color-text-muted)] mb-12 max-w-2xl mx-auto leading-relaxed\" data-kid=\"170\">\n                    Start your first audit in seconds. No credit card required to begin.\n                </p>\n                <div class=\"flex flex-col sm:flex-row items-center justify-center gap-6\" data-kid=\"171\">\n                    <button class=\"w-full sm:w-auto px-12 py-6 bg-[var(--k-color-accent)] text-black font-black rounded-2xl hover:scale-105 transition-transform shadow-[0_25px_50px_-12px_rgba(223,0,255,0.4)] text-xs uppercase tracking-[0.25em]\" data-kid=\"172\">Start Free Audit</button>\n                    <button class=\"w-full sm:w-auto px-12 py-6 border border-[var(--k-color-border)] text-[var(--k-color-text-primary)] font-black rounded-2xl hover:bg-white/5 transition-all text-xs uppercase tracking-[0.25em]\" data-kid=\"173\">View Enterprise Demo</button>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    \n    <footer class=\"py-20 border-t border-[var(--k-color-border)] bg-black\" data-kid=\"174\">\n        <div class=\"max-w-7xl mx-auto px-6\" data-kid=\"175\">\n            <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-12 mb-20\" data-kid=\"176\">\n                <div class=\"col-span-2\" data-kid=\"177\">\n                    <div class=\"flex items-center gap-3 mb-6\" data-kid=\"178\">\n                        <div class=\"w-8 h-8 bg-[var(--k-color-accent)] rounded flex items-center justify-center\" data-kid=\"179\">\n                            <i class=\"ti ti-chart-dots-3 text-black text-xl\" data-kid=\"180\"></i>\n                        </div>\n                        <span class=\"font-[var(--k-font-family-heading)] font-bold text-lg tracking-tight\" data-kid=\"181\">AdAudit AI</span>\n                    </div>\n                    <p class=\"text-[var(--k-color-text-muted)] text-sm max-w-xs leading-relaxed mb-6\" data-kid=\"182\">\n                        Advanced AI-driven auditing for modern advertising teams. Optimize spend, reduce waste, and scale what works.\n                    </p>\n                    <div class=\"flex items-center gap-4\" data-kid=\"183\">\n                        <a href=\"#\" class=\"w-10 h-10 rounded-lg border border-[var(--k-color-border)] flex items-center justify-center hover:border-[var(--k-color-accent)] transition-colors\" data-kid=\"184\"><i class=\"ti ti-brand-twitter text-xl\" data-kid=\"185\"></i></a>\n                        <a href=\"#\" class=\"w-10 h-10 rounded-lg border border-[var(--k-color-border)] flex items-center justify-center hover:border-[var(--k-color-accent)] transition-colors\" data-kid=\"186\"><i class=\"ti ti-brand-linkedin text-xl\" data-kid=\"187\"></i></a>\n                        <a href=\"#\" class=\"w-10 h-10 rounded-lg border border-[var(--k-color-border)] flex items-center justify-center hover:border-[var(--k-color-accent)] transition-colors\" data-kid=\"188\"><i class=\"ti ti-brand-github text-xl\" data-kid=\"189\"></i></a>\n                    </div>\n                </div>\n                <div data-kid=\"190\">\n                    <h4 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-[var(--k-color-text-muted)]\" data-kid=\"191\">Product</h4>\n                    <ul class=\"space-y-4 text-sm text-[var(--k-color-text-secondary)]\" data-kid=\"192\">\n                        <li data-kid=\"193\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"194\">Features</a></li>\n                        <li data-kid=\"195\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"196\">Integrations</a></li>\n                        <li data-kid=\"197\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"198\">Pricing</a></li>\n                        <li data-kid=\"199\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"200\">Changelog</a></li>\n                    </ul>\n                </div>\n                <div data-kid=\"201\">\n                    <h4 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-[var(--k-color-text-muted)]\" data-kid=\"202\">Company</h4>\n                    <ul class=\"space-y-4 text-sm text-[var(--k-color-text-secondary)]\" data-kid=\"203\">\n                        <li data-kid=\"204\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"205\">About Us</a></li>\n                        <li data-kid=\"206\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"207\">Careers</a></li>\n                        <li data-kid=\"208\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"209\">Contact</a></li>\n                        <li data-kid=\"210\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"211\">Privacy</a></li>\n                    </ul>\n                </div>\n                <div data-kid=\"212\">\n                    <h4 class=\"font-bold text-sm mb-6 uppercase tracking-widest text-[var(--k-color-text-muted)]\" data-kid=\"213\">Resources</h4>\n                    <ul class=\"space-y-4 text-sm text-[var(--k-color-text-secondary)]\" data-kid=\"214\">\n                        <li data-kid=\"215\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"216\">Documentation</a></li>\n                        <li data-kid=\"217\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"218\">Help Center</a></li>\n                        <li data-kid=\"219\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"220\">Blog</a></li>\n                        <li data-kid=\"221\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"222\">API Reference</a></li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"flex flex-col md:flex-row items-center justify-between pt-10 border-t border-[var(--k-color-border)] text-[var(--k-color-text-muted)] text-xs\" data-kid=\"223\">\n                <p data-kid=\"224\">© 2024 AdAudit AI Inc. All rights reserved.</p>\n                <div class=\"flex items-center gap-6 mt-4 md:mt-0\" data-kid=\"225\">\n                    <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"226\">Terms of Service</a>\n                    <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"227\">Cookie Policy</a>\n                </div>\n            </div>\n        </div>\n    </footer>\n\n    \n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"228\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"229\"></script>\n    <script type=\"module\" data-kid=\"230\">\n        import Lenis from \"https://esm.sh/lenis@1\"\n        \n        // Initialize Lenis\n        const lenis = new Lenis()\n        function raf(time) {\n            lenis.raf(time)\n            requestAnimationFrame(raf)\n        }\n        requestAnimationFrame(raf)\n\n        // GSAP Animations\n        gsap.registerPlugin(ScrollTrigger);\n\n        // Hero reveal\n        gsap.from(\".gsap-reveal-hero\", {\n            y: 40,\n            autoAlpha: 0,\n            duration: 1.2,\n            stagger: 0.15,\n            ease: \"expo.out\",\n            delay: 0.2\n        });\n\n        // Pricing cards reveal\n        gsap.from(\".gsap-pricing-card\", {\n            scrollTrigger: {\n                trigger: \".ramp-card\",\n                start: \"top 90%\",\n            },\n            y: 40,\n            autoAlpha: 0,\n            duration: 1,\n            stagger: 0.1,\n            ease: \"back.out(1.4)\"\n        });\n\n        // FAQ Interaction\n        document.querySelectorAll('.accordion-trigger').forEach(button => {\n            button.addEventListener('click', () => {\n                const item = button.closest('.accordion-item');\n                const isOpen = item.getAttribute('data-state') === 'open';\n                \n                if (isOpen) {\n                    item.setAttribute('data-state', 'closed');\n                } else {\n                    // Close all others\n                    document.querySelectorAll('.accordion-item').forEach(otherItem => {\n                        otherItem.setAttribute('data-state', 'closed');\n                    });\n                    item.setAttribute('data-state', 'open');\n                }\n            });\n        });\n    </script>\n</div>\n",
