      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Sans:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\">\n\n  body {\n    background-color: var(--k-color-bg-page);\n    color: var(--k-color-text-primary);\n    font-family: var(--k-font-family-body);\n    margin: 0;\n    overflow-x: clip;\n  }\n\n  .font-heading {\n    font-family: var(--k-font-family-heading);\n  }\n\n  /* Noise Grain Effect */\n  .noise-grain::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    opacity: 0.2;\n    mix-blend-mode: soft-light;\n    background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E\");\n    z-index: 1;\n  }\n\n  .dashed-border {\n    border: 2px dashed rgba(255, 255, 255, 0.15);\n  }\n\n  .glass-card {\n    background: rgba(26, 23, 26, 0.4);\n    backdrop-filter: blur(16px);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n  }\n\n  /* Custom Scrollbar for activity panel */\n  .custom-scrollbar::-webkit-scrollbar {\n    width: 4px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb {\n    background: var(--k-color-border);\n    border-radius: 10px;\n  }\n\n  /* Glow effect for dropzone */\n  .dropzone-glow {\n    box-shadow: 0 0 0px transparent;\n    transition: box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n  .dropzone-active .dropzone-glow {\n    box-shadow: 0 0 60px rgba(223, 0, 255, 0.15);\n    border-color: var(--k-color-primary) !important;\n  }\n\n  #drop-zone-container {\n    transform-origin: center;\n  }\n\n  .platform-chip {\n    @apply flex items-center gap-2 px-3 py-1.5 rounded-full border border-white/10 bg-white/5 text-[10px] font-bold uppercase tracking-wider text-[var(--k-color-text-muted)] hover:border-[var(--k-color-primary)]/40 hover:text-[var(--k-color-text-primary)] transition-all;\n  }\n</style>\n\n<div class=\"flex min-h-[100vh] w-full\" data-kid=\"1\">\n  \n  <aside class=\"w-[40%] sticky top-0 h-screen flex flex-col p-12 border-r border-[var(--k-color-border)] bg-[var(--k-color-bg-page)] z-20 overflow-y-auto custom-scrollbar\" data-kid=\"2\">\n    <nav class=\"mb-20 flex items-center justify-between shrink-0\" data-kid=\"3\">\n      <div class=\"flex items-center gap-2\" data-kid=\"4\">\n        <div class=\"w-8 h-8 bg-[var(--k-color-primary)] rounded flex items-center justify-center\" data-kid=\"5\">\n          <i class=\"ti ti-cpu text-black text-xl\" data-kid=\"6\"></i>\n        </div>\n        <span class=\"font-heading font-bold text-xl tracking-tight text-[var(--k-color-text-primary)]\" data-kid=\"7\">AdAudit AI</span>\n      </div>\n    </nav>\n\n    <div class=\"flex-grow space-y-16\" data-kid=\"8\">\n      <header class=\"space-y-4 reveal-item\" data-kid=\"9\">\n        <h1 class=\"text-6xl font-heading font-bold leading-[1.1] tracking-tighter text-[var(--k-color-text-primary)]\" data-kid=\"10\">\n          Audit your <br data-kid=\"11\">\n          <span class=\"text-[var(--k-color-primary)]\" data-kid=\"12\">Campaigns</span>\n        </h1>\n        <p class=\"text-[var(--k-color-text-secondary)] text-lg leading-relaxed max-w-sm\" data-kid=\"13\">\n          Deep-scan your advertising data for hidden inefficiencies and scaling opportunities in real-time.\n        </p>\n      </header>\n\n      <section class=\"reveal-item space-y-6\" data-kid=\"14\">\n        <h4 class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--k-color-text-muted)]\" data-kid=\"15\">Supported Networks</h4>\n        <div class=\"grid grid-cols-2 gap-3\" data-kid=\"16\">\n          <div class=\"group flex flex-col p-4 rounded-2xl bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)] hover:border-[var(--k-color-primary)]/50 transition-all cursor-default\" data-kid=\"17\">\n             <i class=\"ti ti-brand-google text-2xl text-[var(--k-color-primary)] mb-3 opacity-60 group-hover:opacity-100\" data-kid=\"18\"></i>\n             <span class=\"font-bold text-sm text-[var(--k-color-text-primary)]\" data-kid=\"19\">Google Ads</span>\n             <span class=\"text-[10px] text-[var(--k-color-text-muted)] mt-1\" data-kid=\"20\">Full Search & Display support</span>\n          </div>\n          <div class=\"group flex flex-col p-4 rounded-2xl bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)] hover:border-[var(--k-color-primary)]/50 transition-all cursor-default\" data-kid=\"21\">\n             <i class=\"ti ti-brand-meta text-2xl text-[var(--k-color-primary)] mb-3 opacity-60 group-hover:opacity-100\" data-kid=\"22\"></i>\n             <span class=\"font-bold text-sm text-[var(--k-color-text-primary)]\" data-kid=\"23\">Meta Ads</span>\n             <span class=\"text-[10px] text-[var(--k-color-text-muted)] mt-1\" data-kid=\"24\">Direct FB/IG export parsing</span>\n          </div>\n          <div class=\"group flex flex-col p-4 rounded-2xl bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)] hover:border-[var(--k-color-primary)]/50 transition-all cursor-default\" data-kid=\"25\">\n             <i class=\"ti ti-brand-tiktok text-2xl text-[var(--k-color-primary)] mb-3 opacity-60 group-hover:opacity-100\" data-kid=\"26\"></i>\n             <span class=\"font-bold text-sm text-[var(--k-color-text-primary)]\" data-kid=\"27\">TikTok Ads</span>\n             <span class=\"text-[10px] text-[var(--k-color-text-muted)] mt-1\" data-kid=\"28\">Creative-level CSV support</span>\n          </div>\n          <div class=\"group flex flex-col p-4 rounded-2xl bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)] hover:border-[var(--k-color-primary)]/50 transition-all cursor-default opacity-50\" data-kid=\"29\">\n             <i class=\"ti ti-cloud-upload text-2xl text-[var(--k-color-text-muted)] mb-3\" data-kid=\"30\"></i>\n             <span class=\"font-bold text-sm text-[var(--k-color-text-primary)]\" data-kid=\"31\">Universal</span>\n             <span class=\"text-[10px] text-[var(--k-color-text-muted)] mt-1\" data-kid=\"32\">Generic CSV Mapping</span>\n          </div>\n        </div>\n      </section>\n\n      <div class=\"pt-12 border-t border-[var(--k-color-border)] reveal-item shrink-0\" data-kid=\"33\">\n        <div class=\"flex items-start gap-3 p-5 rounded-2xl bg-white/[0.02] border border-white/5\" data-kid=\"34\">\n          <i class=\"ti ti-shield-check text-2xl text-[var(--k-color-success)] mt-0.5\" data-kid=\"35\"></i>\n          <p class=\"text-[13px] text-[var(--k-color-text-secondary)] leading-relaxed\" data-kid=\"36\">\n            <strong class=\"text-[var(--k-color-text-primary)] block mb-1\" data-kid=\"37\">Privacy Shield Active</strong>\n            End-to-end encrypted local processing. Your raw financial data never touches our persistent storage.\n          </p>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"mt-auto pt-10 reveal-item flex flex-col gap-6\" data-kid=\"38\">\n      <div class=\"flex items-center justify-between px-1\" data-kid=\"39\">\n         <span class=\"text-[10px] font-bold text-[var(--k-color-text-muted)] tracking-widest uppercase\" data-kid=\"40\">Version 1.4.2</span>\n         <span class=\"text-[10px] font-bold text-[var(--k-color-text-muted)] tracking-widest uppercase\" data-kid=\"41\">Internal Node</span>\n      </div>\n      <button id=\"toggle-activity\" class=\"w-full flex items-center justify-between p-4 rounded-xl bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)] hover:bg-[var(--k-color-bg-surface-hover)] hover:border-[var(--k-color-primary)]/30 transition-all group\" data-kid=\"42\">\n        <div class=\"flex items-center gap-3\" data-kid=\"43\">\n          <div class=\"relative\" data-kid=\"44\">\n            <i class=\"ti ti-history text-lg text-[var(--k-color-text-muted)] group-hover:text-[var(--k-color-primary)]\" data-kid=\"45\"></i>\n            <span class=\"absolute -top-1 -right-1 w-2 h-2 bg-[var(--k-color-primary)] rounded-full animate-pulse\" data-kid=\"46\"></span>\n          </div>\n          <span class=\"text-sm font-medium text-[var(--k-color-text-primary)]\" data-kid=\"47\">Audit History</span>\n        </div>\n        <div class=\"flex items-center gap-2\" data-kid=\"48\">\n           <span class=\"text-[10px] font-bold text-[var(--k-color-text-muted)] bg-white/5 px-1.5 py-0.5 rounded\" data-kid=\"49\">3</span>\n           <i class=\"ti ti-chevron-right text-xs text-[var(--k-color-text-muted)]\" data-kid=\"50\"></i>\n        </div>\n      </button>\n    </div>\n  </aside>\n\n  \n  <main class=\"w-[60%] h-screen relative flex items-center justify-center p-12 overflow-hidden bg-black noise-grain\" data-kid=\"51\">\n    <input type=\"file\" id=\"file-input\" class=\"hidden\" multiple accept=\".csv\" data-kid=\"52\">\n    \n    \n    <div class=\"absolute top-10 right-10 flex items-center gap-4 text-[10px] font-bold tracking-[0.1em] text-[var(--k-color-text-muted)] z-20\" data-kid=\"53\">\n      <span class=\"bg-white/5 px-2 py-1 rounded border border-white/5\" data-kid=\"54\">WORKSPACE ID: AD-9923</span>\n      <div class=\"flex items-center gap-2 text-[var(--k-color-success)] bg-[var(--k-color-success)]/5 px-2 py-1 rounded border border-[var(--k-color-success)]/10\" data-kid=\"55\">\n        <span class=\"w-1.5 h-1.5 rounded-full bg-current animate-pulse\" data-kid=\"56\"></span>\n        <span data-kid=\"57\">SYSTEMS ONLINE</span>\n      </div>\n    </div>\n\n    <div id=\"drop-zone-container\" class=\"w-full h-full relative z-10 group\" data-kid=\"58\">\n      <label for=\"file-input\" id=\"drop-zone\" class=\"w-full h-full flex flex-col items-center justify-center rounded-[3rem] dashed-border bg-white/[0.01] hover:bg-white/[0.03] cursor-pointer transition-all duration-700 dropzone-glow\" data-kid=\"59\">\n        \n        \n        <div class=\"relative z-10 text-center space-y-8 max-w-md px-6\" data-kid=\"60\">\n          <div class=\"relative mx-auto w-32 h-32 mb-6 group/icon\" data-kid=\"61\">\n             \n            <div class=\"absolute inset-0 bg-[var(--k-color-primary)] opacity-10 blur-3xl group-hover:opacity-20 transition-opacity\" data-kid=\"62\"></div>\n            <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/paper-tray.svg\" class=\"relative w-full h-full filter invert brightness-200 opacity-60 group-hover:opacity-100 transition-all duration-700 scale-90 group-hover:scale-100\" style=\"color: var(--k-color-primary);\" alt=\"Upload Tray\" data-kid=\"63\">\n            <div class=\"absolute -bottom-4 left-1/2 -translate-x-1/2 bg-[var(--k-color-primary)] text-black rounded-full px-4 py-1.5 text-[10px] font-bold uppercase tracking-[0.15em] opacity-0 group-hover:opacity-100 transition-all translate-y-2 group-hover:translate-y-0\" data-kid=\"64\">\n              Drop File\n            </div>\n          </div>\n          \n          <div class=\"space-y-4\" data-kid=\"65\">\n            <h2 class=\"text-5xl font-heading font-bold text-white tracking-tighter\" data-kid=\"66\">\n              Ready to <span class=\"text-[var(--k-color-primary)]\" data-kid=\"67\">Audit</span>?\n            </h2>\n            <p class=\"text-[var(--k-color-text-secondary)] text-lg font-medium opacity-60 group-hover:opacity-100 transition-opacity max-w-xs mx-auto leading-relaxed\" data-kid=\"68\">\n              Drag your CSV export anywhere in this zone or browse files.\n            </p>\n          </div>\n\n          <div class=\"pt-6\" data-kid=\"69\">\n            <div class=\"inline-flex flex-wrap justify-center gap-3 max-w-sm\" data-kid=\"70\">\n               <span class=\"platform-chip\" data-kid=\"71\"><i class=\"ti ti-brand-google\" data-kid=\"72\"></i> Google</span>\n               <span class=\"platform-chip\" data-kid=\"73\"><i class=\"ti ti-brand-meta\" data-kid=\"74\"></i> Meta</span>\n               <span class=\"platform-chip\" data-kid=\"75\"><i class=\"ti ti-brand-tiktok\" data-kid=\"76\"></i> TikTok</span>\n               <span class=\"platform-chip\" data-kid=\"77\"><i class=\"ti ti-file-text\" data-kid=\"78\"></i> Max 50MB</span>\n            </div>\n          </div>\n        </div>\n      </label>\n    </div>\n  </main>\n</div>\n\n\n<div id=\"activity-sheet\" class=\"fixed inset-y-0 right-0 w-[400px] glass-card z-50 transform translate-x-full transition-transform duration-500 ease-in-out flex flex-col shadow-2xl\" data-kid=\"79\">\n  <div class=\"p-8 border-b border-white/10 flex items-center justify-between\" data-kid=\"80\">\n    <div class=\"flex items-center gap-3\" data-kid=\"81\">\n      <i class=\"ti ti-history text-2xl text-[var(--k-color-primary)]\" data-kid=\"82\"></i>\n      <h3 class=\"text-xl font-heading font-bold\" data-kid=\"83\">Recent Audits</h3>\n    </div>\n    <button id=\"close-activity\" class=\"p-2 hover:bg-white/10 rounded-lg transition-colors\" data-kid=\"84\">\n      <i class=\"ti ti-x\" data-kid=\"85\"></i>\n    </button>\n  </div>\n\n  <div class=\"flex-grow overflow-y-auto p-6 space-y-4 custom-scrollbar\" data-kid=\"86\">\n    \n    <div class=\"p-4 rounded-xl bg-white/[0.03] border border-white/5 hover:bg-white/[0.05] transition-colors group\" data-kid=\"87\">\n      <div class=\"flex items-start justify-between mb-3\" data-kid=\"88\">\n        <div class=\"flex items-center gap-2\" data-kid=\"89\">\n          <div class=\"w-2 h-2 rounded-full bg-[var(--k-color-success)] shadow-[0_0_8px_var(--k-color-success)]\" data-kid=\"90\"></div>\n          <span class=\"font-medium text-sm\" data-kid=\"91\">Q3_GoogleAds_Main.csv</span>\n        </div>\n        <span class=\"text-[10px] text-[var(--k-color-text-muted)] font-mono\" data-kid=\"92\">2M AGO</span>\n      </div>\n      <div class=\"space-y-2\" data-kid=\"93\">\n        <div class=\"flex items-center justify-between text-[10px] text-[var(--k-color-text-muted)] font-bold tracking-wider uppercase\" data-kid=\"94\">\n          <span data-kid=\"95\">Processing</span>\n          <span data-kid=\"96\">100%</span>\n        </div>\n        <div class=\"h-1 w-full bg-white/5 rounded-full overflow-hidden\" data-kid=\"97\">\n          <div class=\"h-full bg-[var(--k-color-success)] w-full\" data-kid=\"98\"></div>\n        </div>\n      </div>\n      <div class=\"mt-4 flex items-center justify-between\" data-kid=\"99\">\n        <span class=\"text-xs text-[var(--k-color-primary)] font-medium\" data-kid=\"100\">14 Issues Found</span>\n        <button class=\"text-xs font-bold px-3 py-1.5 rounded-md bg-white/5 hover:bg-[var(--k-color-primary)] hover:text-black transition-all\" data-kid=\"101\">View Audit</button>\n      </div>\n    </div>\n\n    \n    <div class=\"p-4 rounded-xl bg-white/[0.03] border border-white/5 hover:bg-white/[0.05] transition-colors group\" data-kid=\"102\">\n      <div class=\"flex items-start justify-between mb-3\" data-kid=\"103\">\n        <div class=\"flex items-center gap-2\" data-kid=\"104\">\n          <div class=\"w-2 h-2 rounded-full bg-[var(--k-color-warning)] shadow-[0_0_8px_var(--k-color-warning)] animate-pulse\" data-kid=\"105\"></div>\n          <span class=\"font-medium text-sm\" data-kid=\"106\">Meta_Retargeting_June.csv</span>\n        </div>\n        <span class=\"text-[10px] text-[var(--k-color-text-muted)] font-mono\" data-kid=\"107\">ANALYZING</span>\n      </div>\n      <div class=\"space-y-2\" data-kid=\"108\">\n        <div class=\"flex items-center justify-between text-[10px] text-[var(--k-color-text-muted)] font-bold tracking-wider uppercase\" data-kid=\"109\">\n          <span data-kid=\"110\">Parsing Rows</span>\n          <span data-kid=\"111\">64%</span>\n        </div>\n        <div class=\"h-1 w-full bg-white/5 rounded-full overflow-hidden\" data-kid=\"112\">\n          <div class=\"h-full bg-[var(--k-color-warning)] w-2/3\" data-kid=\"113\"></div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"p-4 rounded-xl bg-white/[0.03] border border-white/5 opacity-60 hover:opacity-100 transition-opacity\" data-kid=\"114\">\n      <div class=\"flex items-start justify-between mb-2\" data-kid=\"115\">\n        <div class=\"flex items-center gap-2\" data-kid=\"116\">\n          <div class=\"w-2 h-2 rounded-full bg-white/20\" data-kid=\"117\"></div>\n          <span class=\"font-medium text-sm\" data-kid=\"118\">TikTok_Campaigns.csv</span>\n        </div>\n        <span class=\"text-[10px] text-[var(--k-color-text-muted)] font-mono\" data-kid=\"119\">YESTERDAY</span>\n      </div>\n      <p class=\"text-xs text-[var(--k-color-text-muted)] mb-3\" data-kid=\"120\">Audit completed with 7 high-priority recommendations.</p>\n      <button class=\"w-full text-xs font-bold py-2 rounded-md border border-white/10 hover:border-[var(--k-color-primary)] transition-all\" data-kid=\"121\">Re-run Analysis</button>\n    </div>\n  </div>\n\n  <div class=\"p-6 border-t border-white/10 bg-white/[0.02]\" data-kid=\"122\">\n    <button class=\"w-full py-4 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 font-bold transition-all text-sm tracking-wide\" data-kid=\"123\">\n      EXPORT ALL HISTORY (ZIP)\n    </button>\n  </div>\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"124\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"125\"></script>\n<script type=\"module\" data-kid=\"126\">\n  import { animate as motionAnimate } from 'https://cdn.jsdelivr.net/npm/motion@12/+esm';\n  import Lenis from \"https://esm.sh/lenis@1\";\n  import Snap from \"https://esm.sh/lenis@1/snap\";\n  import { animate as animeAnimate } from 'https://esm.sh/animejs@4';\n\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Initialize Lenis for smooth scroll with Snap per instructions\n  const lenis = new Lenis();\n  const snap = new Snap(lenis);\n  function raf(time) {\n    lenis.raf(time);\n    requestAnimationFrame(raf);\n  }\n  requestAnimationFrame(raf);\n\n  // Entrance Animations\n  gsap.from(\".reveal-item\", {\n    y: 30,\n    autoAlpha: 0,\n    duration: 1,\n    stagger: 0.2,\n    ease: \"power4.out\",\n    delay: 0.3\n  });\n\n  gsap.from(\"#drop-zone-container\", {\n    scale: 0.95,\n    autoAlpha: 0,\n    duration: 1.5,\n    ease: \"expo.out\",\n    delay: 0.5\n  });\n\n  // Drop Zone Interaction (Anime.js Spring Pop)\n  const dropZone = document.getElementById('drop-zone');\n  const dropZoneContainer = document.getElementById('drop-zone-container');\n\n  dropZone.addEventListener('dragover', (e) => {\n    e.preventDefault();\n    dropZone.classList.add('dropzone-active');\n    \n    // #anime-spring-pop effect using animejs v4 named import\n    animeAnimate('#drop-zone-container', {\n      scale: 0.98,\n      duration: 400,\n      ease: 'outQuad'\n    });\n  });\n\n  dropZone.addEventListener('dragleave', () => {\n    dropZone.classList.remove('dropzone-active');\n    \n    animeAnimate('#drop-zone-container', {\n      scale: 1,\n      duration: 600,\n      ease: 'outElastic(1, .8)'\n    });\n  });\n\n  dropZone.addEventListener('drop', (e) => {\n    e.preventDefault();\n    dropZone.classList.remove('dropzone-active');\n    \n    animeAnimate('#drop-zone-container', {\n      scale: 1,\n      duration: 600,\n      ease: 'outElastic(1, .8)'\n    });\n    \n    // Simulate upload\n    alert(\"File detected! Processing your audit...\");\n  });\n\n  // Activity Sheet Controls\n  const toggleBtn = document.getElementById('toggle-activity');\n  const closeBtn = document.getElementById('close-activity');\n  const sheet = document.getElementById('activity-sheet');\n\n  toggleBtn.addEventListener('click', () => {\n    sheet.classList.remove('translate-x-full');\n  });\n\n  closeBtn.addEventListener('click', () => {\n    sheet.classList.add('translate-x-full');\n  });\n\n  // Close sheet on escape\n  window.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape') {\n      sheet.classList.add('translate-x-full');\n    }\n  });\n</script>\n",
