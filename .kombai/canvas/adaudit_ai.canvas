      "html": "\n<div id=\"smooth-wrapper\" class=\"bg-[var(--k-color-bg-page)] text-[var(--k-color-text-primary)] font-[var(--k-font-family-body)] overflow-x-clip\" data-kid=\"0\">\n    \n    \n    <nav class=\"fixed top-0 left-0 w-full z-50 flex justify-between items-center px-8 py-5 backdrop-blur-md bg-[var(--k-color-bg-page)]/40 border-b border-white/5\" data-kid=\"1\">\n        <div class=\"flex items-center gap-3 group cursor-pointer\" data-kid=\"2\">\n            <div class=\"w-10 h-10 rounded-xl bg-gradient-to-br from-[var(--k-color-accent)] to-[var(--k-color-secondary)] flex items-center justify-center shadow-lg shadow-[var(--k-color-accent)]/20 group-hover:rotate-12 transition-transform\" data-kid=\"3\">\n                <i class=\"ri-rhythm-line text-white text-xl\" data-kid=\"4\"></i>\n            </div>\n            <span class=\"font-[var(--k-font-family-heading)] font-bold text-xl tracking-tighter\" data-kid=\"5\">AdAudit AI</span>\n        </div>\n        <div class=\"hidden md:flex items-center gap-10 text-sm font-medium text-[var(--k-color-text-secondary)]\" data-kid=\"6\">\n            <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"7\">Platform</a>\n            <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"8\">Solutions</a>\n            <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"9\">Enterprise</a>\n            <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"10\">Pricing</a>\n        </div>\n        <div class=\"flex items-center gap-4\" data-kid=\"11\">\n            <button class=\"px-6 py-2.5 rounded-full text-sm font-semibold hover:bg-white/5 transition-colors\" data-kid=\"12\">Log in</button>\n            <button class=\"px-6 py-2.5 rounded-full bg-[var(--k-color-accent)] text-[var(--k-color-bg-page)] text-sm font-bold shadow-lg shadow-[var(--k-color-accent)]/20 hover:scale-105 transition-transform\" data-kid=\"13\">Get Started</button>\n        </div>\n    </nav>\n\n    <main data-scroll-container data-kid=\"14\">\n        \n        \n        <section id=\"hero\" class=\"relative min-h-[110vh] flex flex-col justify-center px-8 pt-32 pb-24 overflow-hidden\" data-kid=\"15\">\n            \n            <div class=\"absolute inset-0 -z-10\" data-scroll data-scroll-speed=\"-0.2\" data-kid=\"16\">\n                <div class=\"absolute top-[10%] left-[20%] w-[60vw] h-[60vw] bg-[var(--k-color-secondary)]/30 rounded-full blur-[160px] animate-pulse\" data-kid=\"17\"></div>\n                <div class=\"absolute -bottom-[20%] -right-[10%] w-[50vw] h-[50vw] bg-[var(--k-color-accent)]/20 rounded-full blur-[140px]\" data-kid=\"18\"></div>\n                <div class=\"absolute top-[40%] right-[10%] w-[40vw] h-[40vw] bg-[var(--k-color-bg-surface-hover)]/40 rounded-full blur-[180px]\" data-kid=\"19\"></div>\n            </div>\n\n            <div class=\"max-w-7xl mx-auto w-full relative z-10\" data-kid=\"20\">\n                <div class=\"inline-flex items-center gap-3 px-5 py-2 rounded-full border border-white/10 bg-white/5 backdrop-blur-lg text-[var(--k-color-text-primary)] text-[var(--k-font-size-xs)] font-bold uppercase tracking-widest mb-10\" data-scroll data-scroll-speed=\"0.05\" data-kid=\"21\">\n                    <span class=\"flex h-2 w-2\" data-kid=\"22\">\n                        <span class=\"animate-ping absolute inline-flex h-2 w-2 rounded-full bg-[var(--k-color-accent)] opacity-75\" data-kid=\"23\"></span>\n                        <span class=\"relative inline-flex rounded-full h-2 w-2 bg-[var(--k-color-accent)]\" data-kid=\"24\"></span>\n                    </span>\n                    $4.2M identified in leaked spend today\n                </div>\n\n                <h1 class=\"font-[var(--k-font-family-heading)] text-[clamp(4rem,14vw,11rem)] font-bold leading-[0.78] tracking-tighter text-[var(--k-color-text-primary)]\" data-scroll da