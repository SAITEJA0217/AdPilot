      "html": "\n<section class=\"min-h-screen bg-[var(--k-color-bg-page)] text-[var(--k-color-text-primary)] font-[var(--k-font-family-body)] flex flex-col relative overflow-x-clip selection:bg-[var(--k-color-primary)] selection:text-[var(--k-color-bg-page)]\" data-kid=\"0\">\n  \n  \n  <div class=\"fixed inset-0 pointer-events-none z-[100] opacity-[0.04] mix-blend-overlay\" style=\"background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');\" data-kid=\"1\"></div>\n\n  \n  <header class=\"flex border-b border-[var(--k-color-border)] z-50 bg-[var(--k-color-bg-page)]\" data-kid=\"2\">\n    <div class=\"w-[340px] border-r border-[var(--k-color-border)] p-10 flex items-center gap-4 shrink-0\" data-kid=\"3\">\n      <div class=\"w-12 h-12 bg-[var(--k-color-primary)] flex items-center justify-center shrink-0\" data-kid=\"4\">\n        <span class=\"text-black font-[var(--k-font-family-heading)] font-black text-2xl\" data-kid=\"5\">A</span>\n      </div>\n      <span class=\"font-[var(--k-font-family-heading)] text-3xl font-black tracking-tighter uppercase whitespace-nowrap\" data-kid=\"6\">AdAudit AI</span>\n    </div>\n    <div class=\"flex-1 flex justify-between items-center p-10 min-w-0\" data-kid=\"7\">\n      <div class=\"flex items-center gap-6 text-[var(--k-font-size-xs)] font-mono text-[var(--k-color-text-muted)] min-w-0 overflow-hidden\" data-kid=\"8\">\n        <span class=\"flex items-center gap-2 shrink-0\" data-kid=\"9\">\n          <span class=\"w-2 h-2 bg-[var(--k-color-success)] animate-pulse\" data-kid=\"10\"></span>\n          SYS_STATUS: ONLINE\n        </span>\n        <span class=\"hidden md:inline text-[var(--k-color-border)] shrink-0\" data-kid=\"11\">/</span>\n        <div class=\"relative overflow-hidden whitespace-nowrap\" data-kid=\"12\">\n          <span class=\"terminal-header-text tracking-tight uppercase\" data-kid=\"13\">READY_FOR_DATA_SOURCE_X88</span>\n          <span class=\"terminal-cursor inline-block w-1.5 h-3 bg-[var(--k-color-primary)] ml-1 align-middle\" data-kid=\"14\"></span>\n        </div>\n      </div>\n      <div class=\"flex items-center gap-8\" data-kid=\"15\">\n        <button class=\"text-[var(--k-font-size-xs)] font-mono hover:text-[var(--k-color-primary)] transition-colors tracking-widest uppercase\" data-kid=\"16\">Documentation</button>\n        <button class=\"px-6 py-2 border-2 border-black bg-[var(--k-color-primary)] text-black text-[var(--k-font-size-xs)] font-black font-[var(--k-font-family-heading)] hover:bg-white transition-colors uppercase tracking-widest shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]\" data-kid=\"17\">Logout</button>\n      </div>\n    </div>\n  </header>\n\n  \n  <main class=\"flex flex-1 overflow-x-clip\" data-kid=\"18\">\n    \n    \n    <aside class=\"w-[340px] bg-[var(--k-color-bg-surface)] border-r border-[var(--k-color-border)] flex flex-col p-10 shrink-0\" data-scroll-section data-kid=\"19\">\n      <div class=\"mb-16 reveal-stagger\" style=\"--i: 0\" data-kid=\"20\">\n        <p class=\"text-[var(--k-font-size-xs)] font-mono text-[var(--k-color-primary)] mb-3 uppercase tracking-[0.2em] font-bold\" data-kid=\"21\">Process Workflow</p>\n        <h2 id=\"pipeline-title\" class=\"font-[var(--k-font-family-heading)] text-7xl font-black leading-[0.75] uppercase tracking-tighter\" data-kid=\"22\">DATA<br data-kid=\"23\">INGEST</h2>\n      </div>\n\n      \n      <nav class=\"relative flex flex-col gap-12 flex-1\" data-kid=\"24\">\n        \n        <div class=\"absolute left-[11px] top-4 bottom-4 w-[2px] bg-[var(--k-color-border)] opacity-20\" data-kid=\"25\"></div>\n        \n        \n        <div class=\"relative flex items-start gap-6 group reveal-stagger\" style=\"--i: 1\" data-kid=\"26\">\n          <div class=\"relative z-10 w-6 h-6 bg-[var(--k-color-primary)] border-4 border-[var(--k-color-bg-surface)] outline outline-1 outline-[var(--k-color-primary)] flex items-center justify-center shrink-0\" data-kid=\"27\">\n            <i class=\"ti ti-check text-black text-[10px] font-black\" data-kid=\"28\"></i>\n          </div>\n          <div class=\"space-y-3\" data-kid=\"29\">\n            <div class=\"flex items-center gap-2\" data-kid=\"30\">\n              <span class=\"px-2 py-1 bg-[var(--k-color-primary)] text-black text-[10px] font-black font-mono\" data-kid=\"31\">ACTIVE</span>\n              <p class=\"font-black text-[var(--k-color-primary)] text-sm uppercase tracking-tight\" data-kid=\"32\">01. Source Upload</p>\n            </div>\n            <p class=\"text-xs text-[var(--k-color-text-secondary)] leading-relaxed opacity-80\" data-kid=\"33\">Prepare CSV export from Google Ads, Meta, or TikTok Ads Manager.</p>\n          </div>\n        </div>\n\n        \n        <div class=\"relative flex items-start gap-6 opacity-30 reveal-stagger\" style=\"--i: 2\" data-kid=\"34\">\n          <div class=\"relative z-10 w-6 h-6 bg-[var(--k-color-bg-surface)] border-2 border-[var(--k-color-border)] flex items-center justify-center shrink-0\" data-kid=\"35\"></div>\n          <div class=\"space-y-2\" data-kid=\"36\">\n            <p class=\"font-bold uppercase tracking-tight text-sm\" data-kid=\"37\">02. Schema Mapping</p>\n            <p class=\"text-xs text-[var(--k-color-text-muted)] leading-relaxed\" data-kid=\"38\">AI auto-detects column headers and normalizes currency data.</p>\n          </div>\n        </div>\n\n        \n        <div class=\"relative flex items-start gap-6 opacity-30 reveal-stagger\" style=\"--i: 3\" data-kid=\"39\">\n          <div class=\"relative z-10 w-6 h-6 bg-[var(--k-color-bg-surface)] border-2 border-[var(--k-color-border)] flex items-center justify-center shrink-0\" data-kid=\"40\"></div>\n          <div class=\"space-y-2\" data-kid=\"41\">\n            <p class=\"font-bold uppercase tracking-tight text-sm\" data-kid=\"42\">03. Audit Generation</p>\n            <p class=\"text-xs text-[var(--k-color-text-muted)] leading-relaxed\" data-kid=\"43\">Deep-dive analysis of bidding and creative performance metrics.</p>\n          </div>\n        </div>\n      </nav>\n\n      <div class=\"mt-auto pt-10 border-t border-[var(--k-color-border)] reveal-stagger\" style=\"--i: 4\" data-kid=\"44\">\n        <p class=\"text-[10px] font-mono text-[var(--k-color-text-muted)] uppercase tracking-tighter\" data-kid=\"45\">Verified Connectors:</p>\n        <div class=\"flex flex-wrap gap-3 mt-4 opacity-50 grayscale hover:grayscale-0 transition-all cursor-default\" data-kid=\"46\">\n          <i class=\"ti ti-brand-google text-xl\" title=\"Google Ads\" data-kid=\"47\"></i>\n          <i class=\"ti ti-brand-facebook text-xl\" title=\"Meta Ads\" data-kid=\"48\"></i>\n          <i class=\"ti ti-brand-tiktok text-xl\" title=\"TikTok Ads\" data-kid=\"49\"></i>\n          <i class=\"ti ti-brand-linkedin text-xl\" title=\"LinkedIn Ads\" data-kid=\"50\"></i>\n        </div>\n      </div>\n    </aside>\n\n    \n    <section class=\"flex-1 bg-[var(--k-color-bg-page)] relative flex items-center justify-center p-8 md:p-12 lg:p-20 overflow-visible\" data-kid=\"51\">\n      \n      \n      <div id=\"upload-card\" class=\"relative w-full max-w-4xl aspect-[16/10] border-[var(--k-border-width-thick)] border-[var(--k-color-border)] bg-[var(--k-color-bg-surface)] p-2 group overflow-visible shadow-[30px_30px_0px_0px_rgba(0,0,0,1)]\" data-kid=\"52\">\n        \n        \n        <div class=\"washi-tape absolute -top-6 -left-12 w-64 h-14 bg-[var(--k-color-primary)] -rotate-[4deg] z-40 pointer-events-none flex items-center justify-center border-x-4 border-black/20 shadow-lg\" data-kid=\"53\">\n          <span class=\"text-[12px] font-[var(--k-font-family-heading)] font-black text-black uppercase tracking-[0.2em]\" data-kid=\"54\">SECURE_UPLOAD_01</span>\n        </div>\n        <div class=\"washi-tape absolute -bottom-8 -right-10 w-52 h-12 bg-[var(--k-color-primary)] rotate-[3deg] z-40 pointer-events-none border-x-4 border-black/20 shadow-lg\" data-kid=\"55\"></div>\n        <div class=\"washi-tape absolute top-16 -right-12 w-40 h-10 bg-[var(--k-color-text-muted)] rotate-[15deg] z-40 pointer-events-none border-x-4 border-black/10\" data-kid=\"56\"></div>\n\n        \n        <div class=\"w-full h-full border-4 border-dashed border-[var(--k-color-border)] flex flex-col items-center justify-center relative overflow-hidden transition-all duration-700 group-hover:border-[var(--k-color-primary)]/60\" data-kid=\"57\">\n          \n          \n          <div class=\"absolute inset-0 opacity-[0.08] pointer-events-none\" style=\"background-image: radial-gradient(var(--k-color-border) 2px, transparent 1px); background-size: 24px 24px;\" data-kid=\"58\"></div>\n          <div class=\"absolute inset-0 pointer-events-none opacity-[0.03]\" style=\"background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06)); background-size: 100% 2px, 3px 100%;\" data-kid=\"59\"></div>\n\n          \n          <div class=\"upload-icon-container relative z-10 mb-10\" data-kid=\"60\">\n            <div class=\"w-32 h-32 bg-[var(--k-color-bg-page)] border-2 border-[var(--k-color-border)] flex items-center justify-center group-hover:bg-[var(--k-color-primary)] group-hover:border-black transition-all duration-500 transform group-hover:scale-110 group-hover:-rotate-[10deg] shadow-[8px_8px_0px_0px_rgba(0,0,0,0.5)]\" data-kid=\"61\">\n              <i class=\"ti ti-file-spreadsheet text-6xl text-[var(--k-color-text-muted)] group-hover:text-black transition-colors duration-500\" data-kid=\"62\"></i>\n            </div>\n            \n            <div class=\"absolute -top-4 -right-4 w-6 h-6 bg-[var(--k-color-primary)] hidden group-hover:block animate-ping\" data-kid=\"63\"></div>\n          </div>\n\n          <div class=\"text-center z-10 px-10 max-w-2xl\" data-kid=\"64\">\n            <h3 class=\"font-[var(--k-font-family-heading)] text-5xl md:text-7xl font-black uppercase tracking-tighter leading-[0.8] mb-8\" data-kid=\"65\">\n              DROP CAMPAIGN<br data-kid=\"66\">LOGS HERE\n            </h3>\n            <p class=\"text-[var(--k-color-text-muted)] font-mono text-[13px] tracking-tight mb-12 leading-relaxed uppercase font-bold\" data-kid=\"67\">\n              FORMATS: .CSV, .XLSX, .TSV <span class=\"text-[var(--k-color-text-primary)] px-2\" data-kid=\"68\">|</span> ENCRYPTED AES-256 <span class=\"text-[var(--k-color-text-primary)] px-2\" data-kid=\"69\">|</span> VOLATILE STORAGE\n            </p>\n          </div>\n\n          \n          <div class=\"relative z-10\" data-kid=\"70\">\n            <button id=\"cta-upload\" class=\"group/btn relative px-20 py-8 bg-[var(--k-color-primary)] text-black font-[var(--k-font-family-heading)] font-black text-3xl uppercase tracking-tighter cursor-pointer overflow-hidden border-4 border-black active:translate-y-2 transition-all\" data-kid=\"71\">\n              <span class=\"relative z-20\" data-kid=\"72\">SELECT LOGS</span>\n              <div class=\"absolute inset-0 bg-white translate-y-full hover-sweep-layer z-10 transition-transform duration-300 group-hover/btn:translate-y-0\" data-kid=\"73\"></div>\n            </button>\n            \n            <div class=\"absolute inset-0 bg-black translate-x-3 translate-y-3 -z-10 group-hover:translate-x-1.5 group-hover:translate-y-1.5 transition-all\" data-kid=\"74\"></div>\n          </div>\n\n          \n          <div class=\"absolute bottom-6 right-6 flex items-center gap-6 z-10 opacity-60\" data-kid=\"75\">\n            <div class=\"flex items-center gap-2 text-[10px] font-mono text-[var(--k-color-text-muted)] uppercase\" data-kid=\"76\">\n              <span class=\"w-1.5 h-1.5 bg-[var(--k-color-success)] rounded-full\" data-kid=\"77\"></span>\n              Encrypted\n            </div>\n            <div class=\"flex items-center gap-2 text-[10px] font-mono text-[var(--k-color-text-muted)] uppercase\" data-kid=\"78\">\n              <span class=\"w-1.5 h-1.5 bg-[var(--k-color-warning)] rounded-full\" data-kid=\"79\"></span>\n              250MB Limit\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"absolute -bottom-8 left-0 flex items-center gap-px text-[10px] font-mono text-[var(--k-color-text-muted)]\" data-kid=\"80\">\n          <span class=\"px-2 py-1 bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)]\" data-kid=\"81\">CHNL: SECURE_1</span>\n          <span class=\"px-2 py-1 bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)]\" data-kid=\"82\">PRTCL: HTTPS/TLS1.3</span>\n          <span class=\"px-2 py-1 bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)]\" data-kid=\"83\">CID: 88-102-X</span>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <style data-kid=\"84\">\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;900&family=Fira+Sans:wght@400;500;600&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n      /* Theme override safety */\n      --k-color-primary: #E3FF00;\n      --k-color-bg-page: #1B1B1B;\n      --k-color-bg-surface: #262626;\n      --k-color-border: #404040;\n    }\n\n    /* Custom Brutalist Accents */\n    .washi-tape {\n      clip-path: polygon(\n        0% 15%, 5% 5%, 12% 10%, 20% 0%, 30% 10%, 40% 0%, 50% 15%, 60% 5%, 70% 15%, 80% 0%, 90% 10%, 95% 5%, 100% 15%, \n        100% 85%, 95% 95%, 90% 85%, 80% 100%, 70% 85%, 60% 95%, 50% 80%, 40% 95%, 30% 85%, 20% 100%, 10% 85%, 0% 95%\n      );\n    }\n\n    /* Animation States */\n    .reveal-stagger {\n      opacity: 0;\n      transform: translateY(20px);\n    }\n\n    #upload-card {\n      opacity: 0;\n      transform: scale(0.95);\n    }\n\n    /* Prevent text wrap for small screens on grid items */\n    .terminal-header-text {\n      white-space: nowrap;\n      display: inline-block;\n    }\n  </style>\n\n  \n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"85\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/TextPlugin.min.js\" data-kid=\"86\"></script>\n  <script type=\"module\" data-kid=\"87\">\n    import { animate, hover } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n    // GSAP Entrance\n    gsap.registerPlugin(TextPlugin);\n\n    window.addEventListener('DOMContentLoaded', () => {\n      // Entrance Timeline\n      const tl = gsap.timeline();\n      \n      tl.to(\"#upload-card\", {\n        opacity: 1,\n        scale: 1,\n        duration: 1,\n        ease: \"power4.out\",\n        delay: 0.2\n      })\n      .to(\".reveal-stagger\", {\n        opacity: 1,\n        y: 0,\n        stagger: 0.1,\n        duration: 0.8,\n        ease: \"power3.out\"\n      }, \"-=0.6\");\n\n      // Typewriter Effect for header\n      gsap.to(\".terminal-header-text\", {\n        duration: 2.5,\n        text: \"CHANNEL_ESTABLISHED // STANDBY_FOR_LOGS...\",\n        ease: \"none\",\n        delay: 1.5\n      });\n\n      // Blinking Cursor\n      gsap.to(\".terminal-cursor\", {\n        opacity: 0,\n        duration: 0.5,\n        repeat: -1,\n        yoyo: true,\n        ease: \"steps(1)\"\n      });\n\n      // Hover Interaction for the CTA Upload Button using MotionJS\n      const cta = document.querySelector('#cta-upload');\n      const sweep = document.querySelector('.hover-sweep-layer');\n      \n      // Handled by CSS transition now for better reliability in this environment\n\n      // Animated \"SYSTEM READY\" text in side-flush\n      const pipelineTitle = document.querySelector('#pipeline-title');\n      hover(pipelineTitle, () => {\n        gsap.to(pipelineTitle, { text: \"GO LIVE\", duration: 0.5 });\n        return () => gsap.to(pipelineTitle, { text: \"Data Ingest\", duration: 0.5 });\n      });\n    });\n  </script>\n</section>\n",
