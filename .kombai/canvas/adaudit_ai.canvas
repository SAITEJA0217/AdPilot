xt-lg hover:bg-slate-200 transition-colors\" data-kid=\"144\">\n                                    Talk to Sales\n                                </button>\n                            </div>\n                        </div>\n\n                        <div class=\"grid grid-cols-2 gap-6 md:gap-8\" data-kid=\"145\">\n                            <div class=\"p-8 rounded-3xl bg-slate-50 border border-slate-100 hover:border-[var(--k-color-accent)] transition-colors\" data-kid=\"146\">\n                                <div class=\"text-4xl font-bold text-[var(--k-color-bg-page)] mb-2 tracking-tighter\" data-kid=\"147\">$400M+</div>\n                                <p class=\"text-sm text-slate-500 uppercase tracking-wider font-bold\" data-kid=\"148\">Spend Audited</p>\n                            </div>\n                            <div class=\"p-8 rounded-3xl bg-slate-50 border border-slate-100\" data-kid=\"149\">\n                                <div class=\"text-4xl font-bold text-[var(--k-color-bg-page)] mb-2\" data-kid=\"150\">99.8%</div>\n                                <p class=\"text-sm text-slate-500 uppercase tracking-wider font-bold\" data-kid=\"151\">Data Accuracy</p>\n                            </div>\n                            <div class=\"p-8 rounded-3xl bg-slate-50 border border-slate-100\" data-kid=\"152\">\n                                <div class=\"text-4xl font-bold text-[var(--k-color-bg-page)] mb-2\" data-kid=\"153\">12s</div>\n                                <p class=\"text-sm text-slate-500 uppercase tracking-wider font-bold\" data-kid=\"154\">Analysis Speed</p>\n                            </div>\n                            <div class=\"p-8 rounded-3xl bg-slate-50 border border-slate-100\" data-kid=\"155\">\n                                <div class=\"text-4xl font-bold text-[var(--k-color-bg-page)] mb-2\" data-kid=\"156\">24/7</div>\n                                <p class=\"text-sm text-slate-500 uppercase tracking-wider font-bold\" data-kid=\"157\">Active Monitoring</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <footer class=\"bg-[var(--k-color-bg-page)] pt-48 pb-16 px-8 relative z-10\" data-kid=\"158\">\n            <div class=\"max-w-7xl mx-auto\" data-kid=\"159\">\n                <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-12 mb-20\" data-kid=\"160\">\n                    <div class=\"col-span-2\" data-kid=\"161\">\n                        <div class=\"flex items-center gap-3 mb-8\" data-kid=\"162\">\n                            <div class=\"w-10 h-10 rounded-xl bg-gradient-to-br from-[var(--k-color-accent)] to-[var(--k-color-secondary)] flex items-center justify-center\" data-kid=\"163\">\n                                <i class=\"ri-rhythm-line text-white text-xl\" data-kid=\"164\"></i>\n                            </div>\n                            <span class=\"font-[var(--k-font-family-heading)] font-bold text-2xl tracking-tighter text-white\" data-kid=\"165\">AdAudit AI</span>\n                        </div>\n                        <p class=\"text-[var(--k-color-text-muted)] max-w-xs mb-8\" data-kid=\"166\">\n                            The intelligent layer for performance marketing teams. Real-time auditing for Meta, Google, and TikTok Ads.\n                        </p>\n                        <div class=\"flex gap-4\" data-kid=\"167\">\n                            <a href=\"#\" class=\"w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white/50 hover:bg-[var(--k-color-accent)] hover:text-[var(--k-color-bg-page)] transition-all\" data-kid=\"168\"><i class=\"ri-twitter-x-line\" data-kid=\"169\"></i></a>\n                            <a href=\"#\" class=\"w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white/50 hover:bg-[var(--k-color-accent)] hover:text-[var(--k-color-bg-page)] transition-all\" data-kid=\"170\"><i class=\"ri-linkedin-fill\" data-kid=\"171\"></i></a>\n                            <a href=\"#\" class=\"w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-white/50 hover:bg-[var(--k-color-accent)] hover:text-[var(--k-color-bg-page)] transition-all\" data-kid=\"172\"><i class=\"ri-github-line\" data-kid=\"173\"></i></a>\n                        </div>\n                    </div>\n                    <div data-kid=\"174\">\n                        <h5 class=\"font-bold text-white mb-6\" data-kid=\"175\">Product</h5>\n                        <ul class=\"space-y-4 text-[var(--k-color-text-muted)]\" data-kid=\"176\">\n                            <li data-kid=\"177\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"178\">Features</a></li>\n                            <li data-kid=\"179\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"180\">Integrations</a></li>\n                            <li data-kid=\"181\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"182\">Pricing</a></li>\n                            <li data-kid=\"183\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"184\">Changelog</a></li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"185\">\n                        <h5 class=\"font-bold text-white mb-6\" data-kid=\"186\">Resources</h5>\n                        <ul class=\"space-y-4 text-[var(--k-color-text-muted)]\" data-kid=\"187\">\n                            <li data-kid=\"188\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"189\">Documentation</a></li>\n                            <li data-kid=\"190\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"191\">Help Center</a></li>\n                            <li data-kid=\"192\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"193\">API Reference</a></li>\n                            <li data-kid=\"194\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"195\">Blog</a></li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"196\">\n                        <h5 class=\"font-bold text-white mb-6\" data-kid=\"197\">Company</h5>\n                        <ul class=\"space-y-4 text-[var(--k-color-text-muted)]\" data-kid=\"198\">\n                            <li data-kid=\"199\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"200\">About Us</a></li>\n                            <li data-kid=\"201\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"202\">Careers</a></li>\n                            <li data-kid=\"203\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"204\">Privacy</a></li>\n                            <li data-kid=\"205\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"206\">Terms</a></li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"207\">\n                        <h5 class=\"font-bold text-white mb-6\" data-kid=\"208\">Support</h5>\n                        <ul class=\"space-y-4 text-[var(--k-color-text-muted)]\" data-kid=\"209\">\n                            <li data-kid=\"210\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"211\">Contact</a></li>\n                            <li data-kid=\"212\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"213\">Status</a></li>\n                            <li data-kid=\"214\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"215\">Security</a></li>\n                        </ul>\n                    </div>\n                </div>\n                <div class=\"pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6\" data-kid=\"216\">\n                    <p class=\"text-white/30 text-xs\" data-kid=\"217\">© 2026 AdAudit AI Inc. Built for the data-first marketer.</p>\n                    <div class=\"flex items-center gap-6\" data-kid=\"218\">\n                        <span class=\"flex items-center gap-2 text-[10px] font-bold text-[var(--k-color-success)] uppercase tracking-widest\" data-kid=\"219\">\n                            <span class=\"w-1.5 h-1.5 rounded-full bg-[var(--k-color-success)] animate-pulse\" data-kid=\"220\"></span>\n                            Systems Nominal\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </footer>\n\n    </main>\n</div>\n\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css\" data-kid=\"221\">\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"222\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"223\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.min.js\" data-kid=\"224\"></script>\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.css\" data-kid=\"225\">\n\n<script type=\"module\" data-kid=\"226\">\n    import { animate, scroll, inView, stagger } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n    // Initialize Locomotive Scroll v5\n    const locomotiveScroll = new LocomotiveScroll();\n\n    // #logo-marquee Animation with GSAP (for infinite loop)\n    gsap.to(\".logo-marquee\", {\n        xPercent: -50,\n        ease: \"none\",\n        duration: 35, // Slower marquee for better readability\n        repeat: -1\n    });\n\n    // #motion-sticky-image-reveal for Bento Cells\n    inView(\".bento-cell\", (info) => {\n        animate(info.target, \n            { opacity: [0, 1], y: [60, 0], scale: [0.92, 1] }, \n            { duration: 1, delay: stagger(0.15), ease: [0.22, 1, 0.36, 1] }\n        );\n    });\n\n    // Scroll-linked progress for specific elements if needed\n    // Example: Shrink navigation on scroll\n    scroll(\n        animate(\"nav\", { paddingBlock: [\"24px\", \"16px\"], backgroundColor: [\"rgba(1, 31, 91, 0)\", \"rgba(1, 31, 91, 0.8)\"] }),\n        { offset: [\"0px\", \"100px\"] }\n    );\n\n    // Fade in text elements\n    inView(\"h2, p\", (info) => {\n        animate(info.target, { opacity: [0, 1], y: [20, 0] }, { duration: 0.6, delay: 0.2 });\n    });\n\n</script>\n\n<style data-kid=\"227\">\n    /* Custom Shader Gradient Mesh Animation */\n    @keyframes move-orb {\n        0% { transform: translate(0, 0) scale(1); }\n        33% { transform: translate(10vw, -10vh) scale(1.1); }\n        66% { transform: translate(-5vw, 15vh) scale(0.9); }\n        100% { transform: translate(0, 0) scale(1); }\n    }\n\n    #hero .bg-[var(--k-color-secondary)]\\/30 { animation: move-orb 15s infinite alternate ease-in-out; }\n    #hero .bg-[var(--k-color-accent)]\\/20 { animation: move-orb 20s infinite alternate-reverse ease-in-out; }\n    #hero .bg-[var(--k-color-bg-surface-hover)]\\/40 { animation: move-orb 18s infinite alternate ease-in-out 2s; }\n\n    /* Custom Scrollbar */\n    ::-webkit-scrollbar { width: 6px; }\n    ::-webkit-scrollbar-track { background: var(--k-color-bg-page); }\n    ::-webkit-scrollbar-thumb { background: var(--k-color-border); border-radius: 10px; }\n    ::-webkit-scrollbar-thumb:hover { background: var(--k-color-accent); }\n\n    /* Smooth transition for rising panel */\n    #cta .transform {\n        transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);\n    }\n</style>\n",
