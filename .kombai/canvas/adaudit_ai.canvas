id=\"259\">Long: 122.4194 W</span>\n      </div>\n    </div>\n  </footer>\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"260\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"261\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/TextPlugin.min.js\" data-kid=\"262\"></script>\n\n<script data-kid=\"263\">\n  gsap.registerPlugin(ScrollTrigger, TextPlugin);\n\n  // Entrance\n  gsap.from(\"#top-nav\", { y: -50, opacity: 0, duration: 1, ease: \"power3.out\" });\n  gsap.from(\"#metric-spotlight\", { scale: 0.98, opacity: 0, duration: 1.2, delay: 0.3, ease: \"expo.out\" });\n\n  // Score Counter Animation\n  gsap.to(\"#score-counter\", {\n    innerText: 84,\n    duration: 2.5,\n    snap: { innerText: 1 },\n    ease: \"power4.out\",\n    onUpdate: function() {\n      // Keep it looking technical\n    }\n  });\n\n  // Masonry Card Reveal Stagger\n  gsap.from(\".recommendation-card\", {\n    scrollTrigger: {\n      trigger: \"#masonry-container\",\n      start: \"top 80%\",\n    },\n    opacity: 0,\n    y: 40,\n    duration: 0.8,\n    stagger: 0.15,\n    ease: \"expo.out\"\n  });\n\n  // Table Row Entrance\n  gsap.from(\"tbody tr\", {\n    scrollTrigger: {\n      trigger: \"table\",\n      start: \"top 90%\",\n    },\n    opacity: 0,\n    x: -20,\n    duration: 0.6,\n    stagger: 0.1,\n    ease: \"power2.out\"\n  });\n\n  // Enhanced Button Hover\n  document.querySelectorAll('button').forEach(btn => {\n    if (btn.classList.contains('bg-[var(--k-color-accent)]')) return;\n\n    btn.addEventListener('mouseenter', () => {\n      gsap.to(btn, { \n        backgroundColor: 'var(--k-color-accent)', \n        color: '#000', \n        borderColor: 'var(--k-color-accent)',\n        duration: 0.15,\n        ease: \"power1.inOut\"\n      });\n    });\n    btn.addEventListener('mouseleave', () => {\n      gsap.to(btn, { \n        backgroundColor: 'transparent', \n        color: 'var(--k-color-text-primary)', \n        borderColor: 'var(--k-color-border)',\n        duration: 0.3,\n        ease: \"power2.out\"\n      });\n    });\n  });\n\n</script>\n",
