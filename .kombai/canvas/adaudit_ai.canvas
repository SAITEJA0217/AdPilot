      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Fira+Sans:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --noise-svg: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n  }\n\n  body {\n    background-color: var(--k-color-bg-page);\n    color: var(--k-color-text-primary);\n    font-family: var(--k-font-family-body);\n    margin: 0;\n  }\n\n  .noise-grain::after {\n    content: \"\";\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    opacity: 0.05;\n    z-index: 9999;\n    background-image: var(--noise-svg);\n  }\n\n  .live-pulse {\n    background: linear-gradient(90deg, transparent, var(--k-color-accent), transparent);\n    background-size: 200% 100%;\n    animation: scan 3s linear infinite;\n  }\n\n  @keyframes scan {\n    0% { background-position: 200% 0; }\n    100% { background-position: -200% 0; }\n  }\n\n  .hairline {\n    border: 1px solid var(--k-color-border);\n  }\n\n  .technical-label {\n    @apply text-[9px] font-mono uppercase tracking-[0.2em] text-[var(--k-color-text-muted)];\n  }\n\n  .grid-bg {\n    background-image: \n      linear-gradient(to right, var(--k-color-border) 1px, transparent 1px),\n      linear-gradient(to bottom, var(--k-color-border) 1px, transparent 1px);\n    background-size: 20px 20px;\n  }\n\n  .accent-hover:hover {\n    background-color: var(--k-color-accent);\n    color: #000;\n  }\n\n  .gsap-reveal {\n    opacity: 1; /* GSAP will handle the entrance */\n  }\n\n  /* Custom Scrollbar for Brutalist feel */\n  ::-webkit-scrollbar {\n    width: 8px;\n    height: 8px;\n  }\n  ::-webkit-scrollbar-track {\n    background: var(--k-color-bg-page);\n  }\n  ::-webkit-scrollbar-thumb {\n    background: var(--k-color-border);\n  }\n  ::-webkit-scrollbar-thumb:hover {\n    background: var(--k-color-border-hover);\n  }\n</style>\n\n<div class=\"noise-grain min-h-screen bg-[var(--k-color-bg-page)] text-[var(--k-color-text-primary)]\" data-kid=\"1\">\n  <div class=\"fixed top-0 left-0 w-full h-[2px] live-pulse z-[100]\" data-kid=\"2\"></div>\n  \n  <nav id=\"top-nav\" class=\"border-b border-[var(--k-color-border)] px-8 py-4 flex justify-between items-center sticky top-0 bg-[var(--k-color-bg-page)]/80 backdrop-blur-md z-50\" data-kid=\"3\">\n    <div class=\"flex items-center gap-2\" data-kid=\"4\">\n      <div class=\"w-8 h-8 bg-[var(--k-color-accent)] flex items-center justify-center text-black font-bold\" data-kid=\"5\">A</div>\n      <span class=\"font-[var(--k-font-family-heading)] font-bold tracking-tighter uppercase text-xl\" data-kid=\"6\">AdAudit AI</span>\n    </div>\n    <div class=\"flex items-center gap-8 text-xs font-mono uppercase tracking-widest\" data-kid=\"7\">\n      <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"8\">Overview</a>\n      <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"9\">Analytics</a>\n      <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"10\">Reports</a>\n      <div class=\"w-[1px] h-4 bg-[var(--k-color-border)]\" data-kid=\"11\"></div>\n      <button class=\"bg-[var(--k-color-accent)] text-black px-4 py-2 font-bold hover:bg-[var(--k-color-primary-hover)] transition-colors\" data-kid=\"12\">Export Report</button>\n    </div>\n  </nav>\n\n  <main class=\"max-w-7xl mx-auto px-8 py-12 space-y-24\" data-kid=\"13\">\n    \n    <section id=\"metric-spotlight\" class=\"border border-[var(--k-color-border)] relative\" data-kid=\"14\">\n      \n      <div class=\"absolute -top-1 -left-1 w-2 h-2 bg-[var(--k-color-accent)]\" data-kid=\"15\"></div>\n      <div class=\"absolute -top-1 -right-1 w-2 h-2 bg-[var(--k-color-accent)]\" data-kid=\"16\"></div>\n      <div class=\"absolute -bottom-1 -left-1 w-2 h-2 bg-[var(--k-color-accent)]\" data-kid=\"17\"></div>\n      <div class=\"absolute -bottom-1 -right-1 w-2 h-2 bg-[var(--k-color-accent)]\" data-kid=\"18\"></div>\n\n      <div class=\"grid grid-cols-1 lg:grid-cols-3\" data-kid=\"19\">\n        \n        <div class=\"lg:col-span-2 border-r border-[var(--k-color-border)] p-12 lg:p-20 flex flex-col items-center justify-center relative min-h-[400px] bg-[radial-gradient(circle_at_center,var(--k-color-bg-surface)_0%,transparent_100%)] overflow-hidden\" data-kid=\"20\">\n          <div class=\"absolute top-8 left-8 technical-label\" data-kid=\"21\">Ref: Performance_Index_v4.0</div>\n          <div class=\"absolute bottom-8 left-8 technical-label\" data-kid=\"22\">Status: CALIBRATED</div>\n          \n          <div class=\"absolute top-0 bottom-0 left-1/4 w-[1px] bg-[var(--k-color-border)] opacity-30\" data-kid=\"23\"></div>\n          <div class=\"absolute top-0 bottom-0 right-1/4 w-[1px] bg-[var(--k-color-border)] opacity-30\" data-kid=\"24\"></div>\n          <div class=\"absolute left-0 right-0 top-1/2 h-[1px] bg-[var(--k-color-border)] opacity-30\" data-kid=\"25\"></div>\n          \n          <div class=\"absolute top-8 right-8 text-right\" data-kid=\"26\">\n             <div class=\"technical-label mb-1\" data-kid=\"27\">Last Update</div>\n             <div class=\"text-[10px] font-mono\" data-kid=\"28\">14:22:01 UTC</div>\n          </div>\n\n          <div class=\"flex flex-col items-center relative z-10\" data-kid=\"29\">\n            <span id=\"score-counter\" class=\"text-[120px] md:text-[200px] font-[var(--k-font-family-heading)] font-bold leading-none text-[var(--k-color-accent)]\" data-kid=\"30\">0</span>\n            <div class=\"flex items-center gap-4 mt-6\" data-kid=\"31\">\n              <span class=\"w-12 h-[1px] bg-[var(--k-color-border)]\" data-kid=\"32\"></span>\n              <span class=\"font-[var(--k-font-family-heading)] uppercase text-lg tracking-[0.2em]\" data-kid=\"33\">Condition: Optimal</span>\n              <span class=\"w-12 h-[1px] bg-[var(--k-color-border)]\" data-kid=\"34\"></span>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"lg:col-span-1 flex flex-col\" data-kid=\"35\">\n          <div class=\"flex-1 p-8 border-b border-[var(--k-color-border)] hover:bg-[var(--k-color-bg-surface)] group\" data-kid=\"36\">\n            <div class=\"flex justify-between items-center mb-4\" data-kid=\"37\">\n              <span class=\"text-[10px] font-mono text-[var(--k-color-text-muted)] uppercase\" data-kid=\"38\">Copy Integrity</span>\n              <i class=\"ti ti-typography text-[var(--k-color-accent)] opacity-0 group-hover:opacity-100\" data-kid=\"39\"></i>\n            </div>\n            <div class=\"text-4xl font-bold font-[var(--k-font-family-heading)] mb-4\" data-kid=\"40\">94.2%</div>\n            <div class=\"w-full h-1 bg-[var(--k-color-secondary)]\" data-kid=\"41\">\n              <div class=\"h-full bg-[var(--k-color-accent)]\" style=\"width: 94.2%\" data-kid=\"42\"></div>\n            </div>\n          </div>\n          <div class=\"flex-1 p-8 border-b border-[var(--k-color-border)] hover:bg-[var(--k-color-bg-surface)] group\" data-kid=\"43\">\n            <div class=\"flex justify-between items-center mb-4\" data-kid=\"44\">\n              <span class=\"text-[10px] font-mono text-[var(--k-color-text-muted)] uppercase\" data-kid=\"45\">Budget Efficiency</span>\n              <i class=\"ti ti-chart-bar text-[var(--k-color-accent)] opacity-0 group-hover:opacity-100\" data-kid=\"46\"></i>\n            </div>\n            <div class=\"text-4xl font-bold font-[var(--k-font-family-heading)] mb-4\" data-kid=\"47\">81.5%</div>\n            <div class=\"w-full h-1 bg-[var(--k-color-secondary)]\" data-kid=\"48\">\n              <div class=\"h-full bg-[var(--k-color-success)]\" style=\"width: 81.5%\" data-kid=\"49\"></div>\n            </div>\n          </div>\n          <div class=\"flex-1 p-8 hover:bg-[var(--k-color-bg-surface)] group\" data-kid=\"50\">\n            <div class=\"flex justify-between items-center mb-4\" data-kid=\"51\">\n              <span class=\"text-[10px] font-mono text-[var(--k-color-text-muted)] uppercase\" data-kid=\"52\">Targeting Score</span>\n              <i class=\"ti ti-target text-[var(--k-color-accent)] opacity-0 group-hover:opacity-100\" data-kid=\"53\"></i>\n            </div>\n            <div class=\"text-4xl font-bold font-[var(--k-font-family-heading)] mb-4\" data-kid=\"54\">76.8%</div>\n            <div class=\"w-full h-1 bg-[var(--k-color-secondary)]\" data-kid=\"55\">\n              <div class=\"h-full bg-[var(--k-color-warning)]\" style=\"width: 76.8%\" data-kid=\"56\"></div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"recommendations\" data-kid=\"57\">\n      <div class=\"flex items-end justify-between mb-12 gap-8\" data-kid=\"58\">\n        <div data-kid=\"59\">\n          <h2 class=\"text-5xl font-[var(--k-font-family-heading)] font-bold uppercase tracking-tighter mb-2\" data-kid=\"60\">Automated Insights</h2>\n          <p class=\"text-[var(--k-color-text-secondary)] font-mono text-sm max-w-lg uppercase\" data-kid=\"61\">System scanning complete. 12 critical anomalies detected across 4 active channels.</p>\n        </div>\n        <div class=\"hidden md:flex gap-4\" data-kid=\"62\">\n          <div class=\"border border-[var(--k-color-border)] px-4 py-2 flex items-center gap-2\" data-kid=\"63\">\n            <span class=\"w-2 h-2 rounded-full bg-[var(--k-color-error)]\" data-kid=\"64\"></span>\n            <span class=\"text-[10px] font-mono uppercase\" data-kid=\"65\">3 High Priority</span>\n          </div>\n          <div class=\"border border-[var(--k-color-border)] px-4 py-2 flex items-center gap-2\" data-kid=\"66\">\n            <span class=\"w-2 h-2 rounded-full bg-[var(--k-color-warning)]\" data-kid=\"67\"></span>\n            <span class=\"text-[10px] font-mono uppercase\" data-kid=\"68\">9 Warnings</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6\" id=\"masonry-container\" data-kid=\"69\">\n        \n        <div class=\"recommendation-card break-inside-avoid border border-[var(--k-color-border)] p-8 bg-[var(--k-color-bg-surface)] flex flex-col group relative overflow-hidden\" data-kid=\"70\">\n          <div class=\"absolute top-0 right-0 w-16 h-16 bg-[var(--k-color-error)]/10 flex items-center justify-center translate-x-4 -translate-y-4 rotate-45\" data-kid=\"71\"></div>\n          <div class=\"mb-8 flex justify-between items-start\" data-kid=\"72\">\n            <div class=\"w-12 h-12 border border-[var(--k-color-border)] bg-[var(--k-color-bg-page)] flex items-center justify-center\" data-kid=\"73\">\n              <i class=\"ti ti-alert-circle text-2xl text-[var(--k-color-error)]\" data-kid=\"74\"></i>\n            </div>\n            <span class=\"text-[10px] font-mono border border-[var(--k-color-border)] px-2 py-1 uppercase tracking-widest text-[var(--k-color-error)]\" data-kid=\"75\">P0 Critical</span>\n          </div>\n          <h3 class=\"font-[var(--k-font-family-heading)] text-2xl font-bold uppercase mb-4 leading-none\" data-kid=\"76\">Creative Fatigue</h3>\n          <p class=\"text-[var(--k-color-text-secondary)] text-sm mb-8 leading-relaxed\" data-kid=\"77\">'Q4_Promo_A' frequency reached 6.5. CTR dropped by 42% in 72h.</p>\n          <div class=\"flex gap-1 h-12 mb-8 items-end\" data-kid=\"78\">\n            <div class=\"w-full bg-[var(--k-color-error)] h-full opacity-100\" data-kid=\"79\"></div>\n            <div class=\"w-full bg-[var(--k-color-error)] h-[80%] opaci