      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap');\n\n  :root {\n    --color-primary: #0FFFFF;\n    --color-bg: #011F5B;\n    --color-surface: #022C7A;\n    --color-text: #F8F8FF;\n    --font-heading: 'Plus Jakarta Sans', sans-serif;\n    --font-body: 'IBM Plex Sans', sans-serif;\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    font-family: var(--font-body);\n    background-color: var(--color-bg);\n    color: var(--color-text);\n    overflow: hidden;\n  }\n\n  .mesh-gradient {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    z-index: 0;\n    background: radial-gradient(circle at 20% 30%, rgba(0, 112, 187, 0.4) 0%, transparent 50%),\n                radial-gradient(circle at 80% 70%, rgba(15, 255, 255, 0.15) 0%, transparent 50%),\n                radial-gradient(circle at 50% 50%, rgba(1, 31, 91, 1) 0%, rgba(1, 31, 91, 1) 100%);\n    filter: blur(80px);\n  }\n\n  .grid-overlay {\n    position: absolute;\n    inset: 0;\n    background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),\n                      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);\n    background-size: 50px 50px;\n    z-index: 1;\n    mask-image: radial-gradient(circle at center, black, transparent 80%);\n  }\n\n  .corner-bracket {\n    position: absolute;\n    width: 60px;\n    height: 60px;\n    border-color: var(--k-color-primary);\n    opacity: 0.6;\n    z-index: 10;\n  }\n\n  .corner-bracket-tl { top: 40px; left: 40px; border-top: 2px solid; border-left: 2px solid; }\n  .corner-bracket-tr { top: 40px; right: 40px; border-top: 2px solid; border-right: 2px solid; }\n  .corner-bracket-bl { bottom: 40px; left: 40px; border-bottom: 2px solid; border-left: 2px solid; }\n  .corner-bracket-br { bottom: 40px; right: 40px; border-bottom: 2px solid; border-right: 2px solid; }\n\n  .drop-zone-active .corner-bracket {\n    opacity: 1;\n    filter: drop-shadow(0 0 15px var(--k-color-primary));\n  }\n\n  .surface-panel {\n    background-color: var(--k-color-bg-surface);\n    border: 1px solid var(--k-color-border);\n    box-shadow: var(--k-shadow-lg);\n  }\n\n  .step-line::before {\n    content: '';\n    position: absolute;\n    left: 15px;\n    top: 30px;\n    bottom: 0;\n    width: 2px;\n    background: var(--k-color-border);\n    z-index: 0;\n  }\n\n  /* Custom Scrollbar for Logs */\n  .log-container::-webkit-scrollbar {\n    width: 4px;\n  }\n  .log-container::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  .log-container::-webkit-scrollbar-thumb {\n    background: rgba(255, 255, 255, 0.1);\n    border-radius: 2px;\n  }\n\n  @keyframes pulse-cyan {\n    0%, 100% { opacity: 0.4; }\n    50% { opacity: 0.8; }\n  }\n  .animate-pulse-cyan {\n    animation: pulse-cyan 3s infinite;\n  }\n\n  .fiber-overlay {\n    position: absolute;\n    inset: 0;\n    opacity: 0.03;\n    mix-blend-mode: screen;\n    pointer-events: none;\n    z-index: 2;\n  }\n</style>\n\n<div class=\"relative min-h-screen w-full flex overflow-hidden bg-[var(--k-color-bg-page)]\" data-kid=\"1\">\n  \n  <div class=\"mesh-gradient\" data-kid=\"2\"></div>\n  <div class=\"grid-overlay\" data-kid=\"3\"></div>\n  <img src=\"https://images.unsplash.com/photo-1597733336794-12d05021d510?auto=format&w=1280&q=80&fit=crop\" class=\"fiber-overlay\" alt=\"Fiber Optic Texture\" decoding=\"async\" loading=\"lazy\" data-kid=\"4\">\n\n  \n  <div class=\"relative z-10 flex w-full h-full p-10 gap-10\" data-kid=\"5\">\n    \n    \n    <aside id=\"drawer\" class=\"w-[380px] surface-panel rounded-3xl flex flex-col overflow-hidden shrink-0\" data-kid=\"6\">\n      \n      <div class=\"p-8 pb-6 border-b border-[var(--k-color-border)] bg-white/5 relative overflow-hidden\" data-kid=\"7\">\n        <div class=\"absolute top-0 right-0 w-32 h-32 bg-[var(--k-color-primary)] opacity-10 blur-3xl -mr-16 -mt-16\" data-kid=\"8\"></div>\n        \n        <div class=\"flex items-center gap-5 relative z-10\" data-kid=\"9\">\n          <div class=\"relative\" data-kid=\"10\">\n            <div class=\"w-14 h-14 rounded-2xl overflow-hidden border-2 border-[var(--k-color-border-hover)] shadow-xl\" data-kid=\"11\">\n              <img src=\"https://i.pravatar.cc/150?u=adaudit_ai\" alt=\"System\" class=\"w-full h-full object-cover\" data-kid=\"12\">\n            </div>\n            <div class=\"absolute -bottom-1 -right-1 w-4 h-4 bg-[var(--k-color-success)] rounded-full border-4 border-[var(--k-color-bg-surface)]\" data-kid=\"13\"></div>\n          </div>\n          <div data-kid=\"14\">\n            <h2 class=\"text-lg font-[var(--k-font-family-heading)] font-bold text-[var(--k-color-text-primary)]\" data-kid=\"15\">AdAudit Core</h2>\n            <p class=\"text-sm text-[var(--k-color-text-muted)] font-medium\" data-kid=\"16\">v2.4.0 Engine • Online</p>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"flex-1 overflow-y-auto p-8 space-y-10 relative\" data-kid=\"17\">\n        <div class=\"step-line absolute inset-0 pointer-events-none\" data-kid=\"18\"></div>\n\n        \n        <div class=\"relative flex gap-6 group\" data-kid=\"19\">\n          <div class=\"w-8 h-8 rounded-full bg-[var(--k-color-primary)] flex items-center justify-center z-10 shadow-[0_0_15px_rgba(15,255,255,0.4)]\" data-kid=\"20\">\n            <i class=\"ph ph-check text-xs text-[var(--k-color-bg-page)] font-bold\" data-kid=\"21\"></i>\n          </div>\n          <div class=\"space-y-1\" data-kid=\"22\">\n            <h4 class=\"text-sm font-semibold text-[var(--k-color-text-primary)]\" data-kid=\"23\">System Ready</h4>\n            <p class=\"text-xs text-[var(--k-color-text-secondary)] leading-relaxed opacity-80\" data-kid=\"24\">Infrastructure operational. Awaiting stream.</p>\n          </div>\n        </div>\n\n        \n        <div id=\"stepParsing\" class=\"relative flex gap-6 opacity-40 transition-opacity duration-500\" data-kid=\"25\">\n          <div class=\"w-8 h-8 rounded-full bg-[var(--k-color-bg-page)] border border-[var(--k-color-border)] flex items-center justify-center z-10 transition-colors duration-500\" data-kid=\"26\">\n            <span class=\"text-xs font-bold text-[var(--k-color-text-primary)]\" data-kid=\"27\">2</span>\n          </div>\n          <div class=\"space-y-1\" data-kid=\"28\">\n            <h4 class=\"text-sm font-semibold text-[var(--k-color-text-primary)]\" data-kid=\"29\">Parsing CSV</h4>\n            <p class=\"text-xs text-[var(--k-color-text-secondary)] leading-relaxed opacity-80\" data-kid=\"30\">Normalizing numeric fields and columns.</p>\n          </div>\n        </div>\n\n        \n        <div id=\"stepMapping\" class=\"relative flex gap-6 opacity-40 transition-opacity duration-500\" data-kid=\"31\">\n          <div class=\"w-8 h-8 rounded-full bg-[var(--k-color-bg-page)] border border-[var(--k-color-border)] flex items-center justify-center z-10\" data-kid=\"32\">\n            <span class=\"text-xs font-bold text-[var(--k-color-text-primary)]\" data-kid=\"33\">3</span>\n          </div>\n          <div class=\"space-y-1\" data-kid=\"34\">\n            <h4 class=\"text-sm font-semibold text-[var(--k-color-text-primary)]\" data-kid=\"35\">AI Header Mapping</h4>\n            <p class=\"text-xs text-[var(--k-color-text-secondary)] leading-relaxed opacity-80\" data-kid=\"36\">Matching campaign metadata to schemas.</p>\n          </div>\n        </div>\n\n        \n        <div id=\"stepAudit\" class=\"relative flex gap-6 opacity-40 transition-opacity duration-500\" data-kid=\"37\">\n          <div class=\"w-8 h-8 rounded-full bg-[var(--k-color-bg-page)] border border-[var(--k-color-border)] flex items-center justify-center z-10\" data-kid=\"38\">\n            <span class=\"text-xs font-bold text-white\" data-kid=\"39\">4</span>\n          </div>\n          <div class=\"space-y-1\" data-kid=\"40\">\n            <h4 class=\"text-sm font-semibold text-[var(--k-color-text-primary)]\" data-kid=\"41\">Heuristic Audit</h4>\n            <p class=\"text-xs text-[var(--k-color-text-secondary)] leading-relaxed opacity-80\" data-kid=\"42\">Identifying budget leakage and waste.</p>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"p-6 bg-black/20 border-t border-[var(--k-color-border)]\" data-kid=\"43\">\n        <div class=\"flex items-center justify-between mb-3 px-2\" data-kid=\"44\">\n          <span class=\"text-[10px] uppercase tracking-widest text-[var(--k-color-text-muted)] font-bold\" data-kid=\"45\">Runtime Logs</span>\n          <div class=\"flex gap-1\" data-kid=\"46\">\n            <div class=\"w-1 h-1 rounded-full bg-white/20\" data-kid=\"47\"></div>\n            <div class=\"w-1 h-1 rounded-full bg-white/20\" data-kid=\"48\"></div>\n            <div class=\"w-1 h-1 rounded-full bg-white/20\" data-kid=\"49\"></div>\n          </div>\n        </div>\n        <div id=\"logConsole\" class=\"log-container h-32 overflow-y-auto font-mono text-[11px] space-y-1.5 px-2\" data-kid=\"50\">\n          <div class=\"flex gap-2\" data-kid=\"51\">\n            <span class=\"text-[var(--k-color-primary)] font-bold\" data-kid=\"52\">CORE</span>\n            <span class=\"text-[var(--k-color-text-secondary)] scramble-text\" data-text=\"SYSTEM_IDLE: Awaiting stream...\" data-kid=\"53\">SYSTEM_IDLE: Awaiting stream...</span>\n          </div>\n          <div class=\"flex gap-2 opacity-50\" data-kid=\"54\">\n            <span class=\"text-[var(--k-color-text-muted)]\" data-kid=\"55\">INF</span>\n            <span class=\"text-[var(--k-color-text-muted)]\" data-kid=\"56\">Context initialized 1280x800</span>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"p-6 border-t border-[var(--k-color-border)] bg-black/10 flex gap-3\" data-kid=\"57\">\n          <button id=\"btnBrowse\" class=\"flex-1 h-11 rounded-xl bg-[var(--k-color-primary)] text-[var(--k-color-bg-page)] text-sm font-bold hover:bg-[var(--k-color-primary-hover)] transition-colors\" data-kid=\"58\">\n            Browse Files\n          </button>\n          <button id=\"btnReset\" class=\"w-11 h-11 rounded-xl bg-white/5 text-[var(--k-color-text-primary)] flex items-center justify-center border border-[var(--k-color-border)] hover:bg-[var(--k-color-error)]/20 hover:border-[var(--k-color-error)] transition-colors opacity-50 cursor-not-allowed\" data-kid=\"59\">\n            <i class=\"ph ph-trash\" data-kid=\"60\"></i>\n          </button>\n      </div>\n    </aside>\n\n    \n    <main id=\"dropZone\" class=\"flex-1 relative flex flex-col items-center justify-center rounded-[2.5rem] border border-[var(--k-color-border)] bg-black/10\" data-kid=\"61\">\n      <div class=\"corner-bracket corner-bracket-tl !top-8 !left-8\" data-kid=\"62\"></div>\n      <div class=\"corner-bracket corner-bracket-tr !top-8 !right-8\" data-kid=\"63\"></div>\n      <div class=\"corner-bracket corner-bracket-bl !bottom-8 !left-8\" data-kid=\"64\"></div>\n      <div class=\"corner-bracket corner-bracket-br !bottom-8 !right-8\" data-kid=\"65\"></div>\n\n      \n      <div class=\"text-center space-y-8 z-10 pointer-events-none select-none\" data-kid=\"66\">\n        <div class=\"relative inline-block\" data-kid=\"67\">\n          <div class=\"absolute inset-0 bg-[var(--k-color-primary)] opacity-20 blur-2xl rounded-full scale-150 animate-pulse-cyan\" data-kid=\"68\"></div>\n          <div class=\"relative w-24 h-24 rounded-3xl bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)] flex items-center justify-center shadow-[var(--k-shadow-lg)]\" data-kid=\"69\">\n              <i class=\"ph-duotone ph-upload-simple text-5xl text-[var(--k-color-primary)]\" data-kid=\"70\"></i>\n          </div>\n        </div>\n        <div class=\"space-y-3\" data-kid=\"71\">\n          <h1 class=\"text-6xl font-[var(--k-font-family-heading)] font-bold tracking-tight text-[var(--k-color-text-primary)]\" data-kid=\"72\">\n            Analyze your spend.\n          </h1>\n          <p class=\"text-xl text-[var(--k-color-text-secondary)] max-w-lg mx-auto\" data-kid=\"73\">\n            Drag and drop your campaign CSV here to start the AI-powered audit.\n          </p>\n        </div>\n      </div>\n    </main>\n  </div>\n\n  \n  <div id=\"dropOverlay\" class=\"fixed inset-0 bg-[var(--color-primary)]/5 backdrop-blur-sm z-20 pointer-events-none opacity-0 transition-opacity duration-300\" data-kid=\"74\">\n    <div class=\"absolute inset-20 border-2 border-dashed border-[var(--color-primary)]/30 rounded-[4rem]\" data-kid=\"75\"></div>\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"76\"></script>\n<script src=\"https://unpkg.com/@phosphor-icons/web\" data-kid=\"77\"></script>\n<script type=\"module\" data-kid=\"78\">\n  import { animate, scrambleText } from 'https://esm.sh/animejs@4';\n\n  // Helper for text scramble effect using animejs v4\n  function scramble(el) {\n    const targetText = el.getAttribute('data-text') || el.innerText;\n    animate(el, {\n      innerHTML: scrambleText({ \n        text: targetText, \n        chars: 'uppercase', \n        from: 'center', \n        revealRate: 60, \n        settleDuration: 500 \n      }),\n      duration: 1000,\n      ease: 'linear'\n    });\n  }\n\n  // Initial animation\n  gsap.from(\"#drawer\", { \n    x: -450, \n    duration: 1.2, \n    ease: \"expo.out\",\n    delay: 0.5\n  });\n\n  gsap.from(\".corner-bracket\", {\n    scale: 1.5,\n    opacity: 0,\n    duration: 1,\n    stagger: 0.1,\n    ease: \"power4.out\",\n    delay: 0.8\n  });\n\n  // Drag and Drop Logic\n  const dropZone = document.getElementById('dropZone');\n  const dropOverlay = document.getElementById('dropOverlay');\n  const fileInput = document.getElementById('fileInput');\n  const btnBrowse = document.getElementById('btnBrowse');\n\n  ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {\n    window.addEventListener(eventName, e => {\n      e.preventDefault();\n      e.stopPropagation();\n    }, false);\n  });\n\n  window.addEventListener('dragenter', () => {\n    dropZone.classList.add('drop-zone-active');\n    dropOverlay.style.opacity = '1';\n  });\n\n  window.addEventListener('dragleave', (e) => {\n    if (e.x === 0 && e.y === 0) {\n      dropZone.classList.remove('drop-zone-active');\n      dropOverlay.style.opacity = '0';\n    }\n  });\n\n  window.addEventListener('drop', (e) => {\n    dropZone.classList.remove('drop-zone-active');\n    dropOverlay.style.opacity = '0';\n    const files = e.dataTransfer.files;\n    if (files.length) handleFiles(files[0]);\n  });\n\n  btnBrowse.addEventListener('click', () => fileInput.click());\n  fileInput.addEventListener('change', (e) => {\n    if (e.target.files.length) handleFiles(e.target.files[0]);\n  });\n\n  function addLog(tag, msg, isPrimary = false) {\n    const console = document.getElementById('logConsole');\n    const div = document.createElement('div');\n    div.className = `flex gap-2 ${isPrimary ? '' : 'opacity-70'}`;\n    div.innerHTML = `<span class=\"${isPrimary ? 'text-[var(--k-color-primary)] font-bold' : 'text-[var(--k-color-text-muted)]'}\">${tag}</span><span class=\"text-[var(--k-color-text-secondary)]\">${msg}</span>`;\n    console.appendChild(div);\n    console.scrollTop = console.scrollHeight;\n    \n    // Scramble effect on the new log message\n    const msgSpan = div.querySelector('span:last-child');\n    msgSpan.setAttribute('data-text', msg);\n    scramble(msgSpan);\n  }\n\n  function handleFiles(file) {\n    addLog('IO', `Detected file: ${file.name}`);\n    addLog('SYS', 'Establishing secure buffer...');\n    \n    // Reset and Start animation sequence\n    document.getElementById('btnReset').classList.remove('opacity-50', 'cursor-not-allowed');\n\n    setTimeout(() => {\n      const stepParsing = document.getElementById('stepParsing');\n      stepParsing.classList.remove('opacity-40');\n      const icon = stepParsing.querySelector('.w-8');\n      icon.classList.remove('bg-[var(--k-color-bg-page)]');\n      icon.classList.add('bg-[var(--k-color-primary)]', 'shadow-[0_0_15px_rgba(15,255,255,0.4)]');\n      icon.innerHTML = `<i class=\"ph ph-check text-xs text-[var(--k-color-bg-page)] font-bold\"></i>`;\n      addLog('PRSE', 'Decompressing CSV stream...', true);\n    }, 1000);\n\n    setTimeout(() => {\n      document.getElementById('stepMapping').classList.remove('opacity-40');\n      addLog('MAP', 'Semantic analysis active...');\n    }, 2500);\n\n    setTimeout(() => {\n      addLog('AUD', 'Scanning for budget leakage...', true);\n    }, 4000);\n  }\n\n  // Initial Scramble\n  document.querySelectorAll('.scramble-text').forEach(scramble);\n\n</script>\n",
