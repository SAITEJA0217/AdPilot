      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap');\n\n    :root {\n        --k-color-primary: #0FFFFF;\n        --k-color-primary-hover: #00E0E0;\n        --k-color-secondary: #0070BB;\n        --k-color-bg-page: #011F5B;\n        --k-color-bg-surface: #022C7A;\n        --k-color-bg-surface-hover: #03399A;\n        --k-color-text-primary: #F8F8FF;\n        --k-color-text-secondary: #D1D5DB;\n        --k-color-text-muted: #9CA3AF;\n        --k-color-border: #03399A;\n        --k-color-border-hover: #0446BC;\n        --k-color-accent: #0FFFFF;\n        --k-font-family-heading: 'Plus Jakarta Sans', sans-serif;\n        --k-font-family-body: 'IBM Plex Sans', sans-serif;\n    }\n\n    body {\n        font-family: var(--k-font-family-body);\n        background-color: var(--k-color-bg-page);\n        color: var(--k-color-text-primary);\n        overflow-x: clip;\n    }\n\n    .font-heading { font-family: var(--k-font-family-heading); }\n    \n    /* Custom Slider */\n    input[type=range] {\n        -webkit-appearance: none;\n        background: transparent;\n    }\n    input[type=range]:focus {\n        outline: none;\n    }\n    input[type=range]::-webkit-slider-runnable-track {\n        width: 100%;\n        height: 6px;\n        cursor: pointer;\n        background: #03399A;\n        border-radius: 3px;\n    }\n    input[type=range]::-webkit-slider-thumb {\n        height: 24px;\n        width: 24px;\n        border-radius: 50%;\n        background: var(--k-color-accent);\n        cursor: pointer;\n        -webkit-appearance: none;\n        margin-top: -9px;\n        box-shadow: 0 0 15px rgba(15, 255, 255, 0.5);\n        border: 2px solid white;\n    }\n\n    /* Animation classes */\n    .fade-in { transform: translateY(20px); }\n\n    .grain-overlay {\n        position: fixed;\n        inset: 0;\n        z-index: 50;\n        pointer-events: none;\n        background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n        opacity: 0.03;\n    }\n</style>\n\n<div class=\"relative min-h-screen bg-[var(--k-color-bg-page)]\" data-kid=\"1\">\n    <div class=\"grain-overlay\" data-kid=\"2\"></div>\n    \n    <nav class=\"fixed top-0 left-0 w-full z-50 flex justify-between items-center px-8 md:px-12 py-6 backdrop-blur-md bg-[var(--k-color-bg-page)]/50 border-b border-[var(--k-color-border)]/30\" data-kid=\"3\">\n        <div class=\"flex items-center gap-2\" data-kid=\"4\">\n            <div class=\"w-8 h-8 bg-[var(--k-color-accent)] rounded-lg flex items-center justify-center\" data-kid=\"5\">\n                <i class=\"ph-bold ph-lightning text-[var(--k-color-bg-page)] text-lg\" data-kid=\"6\"></i>\n            </div>\n            <span class=\"font-heading font-bold text-xl tracking-tight\" data-kid=\"7\">AdAudit AI</span>\n        </div>\n        <div class=\"hidden md:flex items-center gap-8 text-sm font-medium text-[var(--k-color-text-secondary)]\" data-kid=\"8\">\n            <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"9\">Audit Engine</a>\n            <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"10\">Case Studies</a>\n            <a href=\"#\" class=\"text-[var(--k-color-accent)]\" data-kid=\"11\">Pricing</a>\n            <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"12\">Enterprise</a>\n        </div>\n        <div class=\"flex items-center gap-4\" data-kid=\"13\">\n            <button class=\"text-sm font-semibold text-[var(--k-color-text-secondary)] hover:text-white transition-colors\" data-kid=\"14\">Sign in</button>\n            <button class=\"px-5 py-2.5 bg-[var(--k-color-accent)] text-[var(--k-color-bg-page)] rounded-full text-sm font-bold hover:scale-105 transition-transform\" data-kid=\"15\">Get Started</button>\n        </div>\n    </nav>\n\n    \n    <section class=\"relative pt-48 pb-12 px-8 md:px-12\" data-kid=\"16\">\n        <div class=\"max-w-7xl mx-auto relative z-10\" data-kid=\"17\">\n            <div class=\"max-w-4xl\" data-kid=\"18\">\n                <h1 id=\"hero-title\" class=\"text-6xl md:text-8xl font-heading font-bold leading-[0.9] tracking-tighter mb-8 text-white\" data-kid=\"19\">\n                    Built for scale.<br data-kid=\"20\">\n                    Priced for ROI.\n                </h1>\n                <p class=\"text-lg md:text-xl text-[var(--k-color-text-secondary)] max-w-xl leading-relaxed\" data-kid=\"21\">\n                    Stop paying flat fees for audits. Our dynamic pricing matches your monthly spend volume, ensuring you only pay for the value we uncover.\n                </p>\n            </div>\n        </div>\n    </section>\n\n    \n    <section id=\"configurator\" class=\"py-12 px-8 md:px-12 relative z-10\" data-kid=\"22\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"23\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12\" data-kid=\"24\">\n                \n                \n                <div class=\"lg:col-span-4 fade-in\" data-kid=\"25\">\n                    <div class=\"h-full p-10 rounded-3xl bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)] shadow-xl relative overflow-hidden group\" data-kid=\"26\">\n                        <div class=\"relative z-10\" data-kid=\"27\">\n                            <span class=\"inline-block px-3 py-1 rounded-full bg-white/10 text-white text-xs font-bold mb-6\" data-kid=\"28\">Foundation</span>\n                            <h2 class=\"text-3xl font-heading font-bold mb-4\" data-kid=\"29\">Core platform</h2>\n                            <p class=\"text-[var(--k-color-text-secondary)] mb-8 leading-relaxed\" data-kid=\"30\">Everything you need to identify wasted spend across primary networks.</p>\n                            \n                            <div class=\"flex items-baseline gap-1 mb-8\" data-kid=\"31\">\n                                <span class=\"text-4xl font-heading font-bold text-white\" data-kid=\"32\">$299</span>\n                                <span class=\"text-[var(--k-color-text-muted)] font-medium\" data-kid=\"33\">/mo base fee</span>\n                            </div>\n\n                            <div class=\"space-y-4\" data-kid=\"34\">\n                                <label class=\"text-xs font-bold text-[var(--k-color-text-muted)] block mb-4\" data-kid=\"35\">Included in base</label>\n                                <ul class=\"space-y-4\" data-kid=\"36\">\n                                    <li class=\"flex items-start gap-3 text-sm text-[var(--k-color-text-secondary)]\" data-kid=\"37\">\n                                        <i class=\"ph-bold ph-check text-[var(--k-color-accent)] mt-0.5\" data-kid=\"38\"></i>\n                                        <span data-kid=\"39\">Unlimited campaign audits</span>\n                                    </li>\n                                    <li class=\"flex items-start gap-3 text-sm text-[var(--k-color-text-secondary)]\" data-kid=\"40\">\n                                        <i class=\"ph-bold ph-check text-[var(--k-color-accent)] mt-0.5\" data-kid=\"41\"></i>\n                                        <span data-kid=\"42\">AI-driven ROAS optimization</span>\n                                    </li>\n                                    <li class=\"flex items-start gap-3 text-sm text-[var(--k-color-text-secondary)]\" data-kid=\"43\">\n                                        <i class=\"ph-bold ph-check text-[var(--k-color-accent)] mt-0.5\" data-kid=\"44\"></i>\n                                        <span data-kid=\"45\">Weekly health score reports</span>\n                                    </li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"lg:col-span-8 space-y-8 fade-in\" data-kid=\"46\">\n                    \n                    <div class=\"p-8 md:p-10 rounded-3xl bg-[var(--k-color-bg-surface)]/50 border border-[var(--k-color-border)]\" data-kid=\"47\">\n                        <div class=\"flex flex-col md:flex-row md:justify-between md:items-end gap-6 mb-10\" data-kid=\"48\">\n                            <div data-kid=\"49\">\n                                <h3 class=\"text-xs font-bold text-[var(--k-color-text-muted)] mb-2\" data-kid=\"50\">Volume adjustment</h3>\n                                <div class=\"text-5xl font-heading font-bold text-white tracking-tight\" id=\"spend-value\" data-kid=\"51\">$50,000</div>\n                                <p class=\"text-[var(--k-color-text-muted)] text-sm mt-2\" data-kid=\"52\">Monthly aggregate ad spend</p>\n                            </div>\n                            <div class=\"flex flex-col items-end\" data-kid=\"53\">\n                                <div class=\"text-2xl font-heading font-bold text-white\" id=\"usage-fee\" data-kid=\"54\">+$750</div>\n                                <span class=\"text-xs text-[var(--k-color-text-muted)] font-medium\" data-kid=\"55\">1.5% scale surcharge</span>\n                            </div>\n                        </div>\n                        \n                        <div class=\"relative py-4\" data-kid=\"56\">\n                            <input type=\"range\" min=\"10000\" max=\"1000000\" step=\"10000\" value=\"50000\" class=\"w-full\" id=\"volume-slider\" data-kid=\"57\">\n                            <div class=\"flex justify-between text-[10px] text-[var(--k-color-text-muted)] mt-4 font-bold uppercase tracking-tighter\" data-kid=\"58\">\n                                <span data-kid=\"59\">$10k</span>\n                                <span class=\"hidden md:inline\" data-kid=\"60\">$250k</span>\n                                <span class=\"hidden md:inline\" data-kid=\"61\">$500k</span>\n                                <span class=\"hidden md:inline\" data-kid=\"62\">$750k</span>\n                                <span data-kid=\"63\">$1M+</span>\n                            </div>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"p-8 md:p-10 rounded-3xl bg-[var(--k-color-bg-surface)]/30 border border-[var(--k-color-border)]/50\" data-kid=\"64\">\n                        <h3 class=\"text-xs font-bold text-[var(--k-color-text-muted)] mb-8\" data-kid=\"65\">Add-on networks</h3>\n                        \n                        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\" data-kid=\"66\">\n                            \n                            <div class=\"network-card flex items-center justify-between p-5 rounded-2xl border border-[var(--k-color-border)] bg-[var(--k-color-bg-page)]/50 hover:border-[var(--k-color-accent)]/40 transition-all cursor-pointer group\" data-fee=\"50\" data-kid=\"67\">\n                                <div class=\"flex items-center gap-4\" data-kid=\"68\">\n                                    <div class=\"w-12 h-12 rounded-xl bg-blue-600/10 flex items-center justify-center group-hover:bg-blue-600/20 transition-colors\" data-kid=\"69\">\n                                        <i class=\"ph-bold ph-google-logo text-blue-400 text-2xl\" data-kid=\"70\"></i>\n                                    </div>\n                                    <div data-kid=\"71\">\n                                        <p class=\"font-heading font-bold text-sm text-white\" data-kid=\"72\">Google Ads</p>\n                                        <p class=\"text-[10px] text-[var(--k-color-text-muted)] font-bold uppercase\" data-kid=\"73\">Included</p>\n                                    </div>\n                                </div>\n                                <div class=\"flex items-center gap-2\" data-kid=\"74\">\n                                    <span class=\"text-xs font-bold text-[var(--k-color-accent)]\" data-kid=\"75\">FREE</span>\n                                    <input type=\"checkbox\" class=\"sr-only\" checked disabled data-kid=\"76\">\n                                    <div class=\"w-10 h-5 bg-[var(--k-color-accent)] rounded-full relative\" data-kid=\"77\">\n                                        <div class=\"absolute right-1 top-1 w-3 h-3 bg-white rounded-full\" data-kid=\"78\"></div>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <div class=\"network-card flex items-center justify-between p-5 rounded-2xl border border-[var(--k-color-border)] bg-[var(--k-color-bg-page)]/50 hover:border-[var(--k-color-accent)]/40 transition-all cursor-pointer group\" data-fee=\"50\" data-kid=\"79\">\n                                <div class=\"flex items-center gap-4\" data-kid=\"80\">\n                                    <div class=\"w-12 h-12 rounded-xl bg-pink-600/10 flex items-center justify-center group-hover:bg-pink-600/20 transition-colors\" data-kid=\"81\">\n                                        <i class=\"ph-bold ph-meta-logo text-pink-400 text-2xl\" data-kid=\"82\"></i>\n                                    </div>\n                                    <div data-kid=\"83\">\n                                        <p class=\"font-heading font-bold text-sm text-white\" data-kid=\"84\">Meta Ads</p>\n                                        <p class=\"text-[10px] text-[var(--k-color-text-muted)] font-bold uppercase\" data-kid=\"85\">+$50/mo</p>\n                                    </div>\n                                </div>\n                                <div class=\"relative inline-flex items-center cursor-pointer\" data-kid=\"86\">\n                                    <input type=\"checkbox\" value=\"50\" class=\"sr-only peer network-toggle\" checked data-kid=\"87\">\n                                    <div class=\"w-10 h-5 bg-[var(--k-color-bg-page)] rounded-full peer peer-checked:bg-[var(--k-color-accent)] transition-colors after:content-[''] after:absolute after:top-[4px] after:left-[4px] after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:after:translate-x-5\" data-kid=\"88\"></div>\n                                </div>\n                            </div>\n\n                            <div class=\"network-card flex items-center justify-between p-5 rounded-2xl border border-[var(--k-color-border)] bg-[var(--k-color-bg-page)]/50 hover:border-[var(--k-color-accent)]/40 transition-all cursor-pointer group\" data-fee=\"50\" data-kid=\"89\">\n                                <div class=\"flex items-center gap-4\" data-kid=\"90\">\n                                    <div class=\"w-12 h-12 rounded-xl bg-white/5 flex items-center justify-center group-hover:bg-white/10 transition-colors\" data-kid=\"91\">\n                                        <i class=\"ph-bold ph-tiktok-logo text-white text-2xl\" data-kid=\"92\"></i>\n                                    </div>\n                                    <div data-kid=\"93\">\n                                        <p class=\"font-heading font-bold text-sm text-white\" data-kid=\"94\">TikTok Ads</p>\n                                        <p class=\"text-[10px] text-[var(--k-color-text-muted)] font-bold uppercase\" data-kid=\"95\">+$50/mo</p>\n                                    </div>\n                                </div>\n                                <div class=\"relative inline-flex items-center cursor-pointer\" data-kid=\"96\">\n                                    <input type=\"checkbox\" value=\"50\" class=\"sr-only peer network-toggle\" data-kid=\"97\">\n                                    <div class=\"w-10 h-5 bg-[var(--k-color-bg-page)] rounded-full peer peer-checked:bg-[var(--k-color-accent)] transition-colors after:content-[''] after:absolute after:top-[4px] after:left-[4px] after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:after:translate-x-5\" data-kid=\"98\"></div>\n                                </div>\n                            </div>\n\n                            <div class=\"network-card flex items-center justify-between p-5 rounded-2xl border border-[var(--k-color-border)] bg-[var(--k-color-bg-page)]/50 hover:border-[var(--k-color-accent)]/40 transition-all cursor-pointer group\" data-fee=\"75\" data-kid=\"99\">\n                                <div class=\"flex items-center gap-4\" data-kid=\"100\">\n                                    <div class=\"w-12 h-12 rounded-xl bg-orange-600/10 flex items-center justify-center group-hover:bg-orange-600/20 transition-colors\" data-kid=\"101\">\n                                        <i class=\"ph-bold ph-amazon-logo text-orange-400 text-2xl\" data-kid=\"102\"></i>\n                                    </div>\n                                    <div data-kid=\"103\">\n                                        <p class=\"font-heading font-bold text-sm text-white\" data-kid=\"104\">Amazon Ads</p>\n                                        <p class=\"text-[10px] text-[var(--k-color-text-muted)] font-bold uppercase\" data-kid=\"105\">+$75/mo</p>\n                                    </div>\n                                </div>\n                                <div class=\"relative inline-flex items-center cursor-pointer\" data-kid=\"106\">\n                                    <input type=\"checkbox\" value=\"75\" class=\"sr-only peer network-toggle\" data-kid=\"107\">\n                                    <div class=\"w-10 h-5 bg-[var(--k-color-bg-page)] rounded-full peer peer-checked:bg-[var(--k-color-accent)] transition-colors after:content-[''] after:absolute after:top-[4px] after:left-[4px] after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:after:translate-x-5\" data-kid=\"108\"></div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"p-8 md:p-10 rounded-3xl bg-[var(--k-color-bg-page)] border border-[var(--k-color-border)] shadow-xl flex flex-col md:flex-row items-center justify-between gap-8 relative overflow-hidden\" data-kid=\"109\">\n                        <div class=\"relative z-10 text-center md:text-left\" data-kid=\"110\">\n                            <h3 class=\"text-xs font-bold text-[var(--k-color-text-muted)] mb-1\" data-kid=\"111\">Total monthly investment</h3>\n                            <div class=\"flex items-baseline justify-center md:justify-start gap-1\" data-kid=\"112\">\n                                <span class=\"text-6xl font-heading font-bold text-white\" id=\"total-price\" data-kid=\"113\">1,099</span>\n                                <span class=\"text-xl font-heading font-semibold text-[var(--k-color-text-muted)]\" data-kid=\"114\">/mo</span>\n                            </div>\n                        </div>\n                        <div class=\"relative z-10 w-full md:w-auto\" data-kid=\"115\">\n                            <button id=\"cta-button\" class=\"w-full md:px-12 py-5 bg-[var(--k-color-accent)] text-[var(--k-color-bg-page)] rounded-2xl font-heading font-bold text-xl hover:scale-[1.02] active:scale-95 transition-transform\" data-kid=\"116\">\n                                Deploy audit engine\n                            </button>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-16 border-y border-[var(--k-color-border)]/20\" data-kid=\"117\">\n        <div class=\"max-w-7xl mx-auto px-8\" data-kid=\"118\">\n            <p class=\"text-center text-[10px] font-bold text-[var(--k-color-text-muted)] uppercase tracking-widest mb-12\" data-kid=\"119\">Trusted by 500+ global advertisers</p>\n            <div class=\"grid grid-cols-2 md:grid-cols-5 gap-12 items-center justify-items-center opacity-30 grayscale contrast-125\" data-kid=\"120\">\n                <div class=\"flex items-center gap-3\" data-kid=\"121\">\n                    <i class=\"ph-bold ph-google-logo text-3xl\" data-kid=\"122\"></i>\n                    <span class=\"font-heading font-bold text-lg tracking-tight\" data-kid=\"123\">Google</span>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"124\">\n                    <i class=\"ph-bold ph-meta-logo text-3xl\" data-kid=\"125\"></i>\n                    <span class=\"font-heading font-bold text-lg tracking-tight\" data-kid=\"126\">Meta</span>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"127\">\n                    <i class=\"ph-bold ph-tiktok-logo text-3xl\" data-kid=\"128\"></i>\n                    <span class=\"font-heading font-bold text-lg tracking-tight\" data-kid=\"129\">TikTok</span>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"130\">\n                    <i class=\"ph-bold ph-amazon-logo text-3xl\" data-kid=\"131\"></i>\n                    <span class=\"font-heading font-bold text-lg tracking-tight\" data-kid=\"132\">Amazon</span>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"133\">\n                    <i class=\"ph-bold ph-linkedin-logo text-3xl\" data-kid=\"134\"></i>\n                    <span class=\"font-heading font-bold text-lg tracking-tight\" data-kid=\"135\">LinkedIn</span>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-20 px-8 md:px-12\" data-kid=\"136\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"137\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-24 items-center\" data-kid=\"138\">\n                <div data-kid=\"139\">\n                    <h2 class=\"text-4xl md:text-5xl font-heading font-bold mb-8 leading-tight text-white\" data-kid=\"140\">The intelligence layer for your ad stack.</h2>\n                    <p class=\"text-[var(--k-color-text-secondary)] text-lg mb-12 leading-relaxed\" data-kid=\"141\">AdAudit AI is a modular engine designed to plug into any high-scale ad operation. We focus on the data, so you can focus on the strategy.</p>\n                    \n                    <div class=\"space-y-4\" data-kid=\"142\">\n                        <div class=\"p-8 rounded-3xl bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)] group hover:border-[var(--k-color-accent)]/30 transition-colors\" data-kid=\"143\">\n                            <div class=\"flex items-center gap-4 mb-3\" data-kid=\"144\">\n                                <div class=\"w-10 h-10 rounded-xl bg-[var(--k-color-accent)]/10 flex items-center justify-center\" data-kid=\"145\">\n                                    <i class=\"ph-bold ph-target text-[var(--k-color-accent)] text-xl\" data-kid=\"146\"></i>\n                                </div>\n                                <h4 class=\"font-heading font-bold text-xl text-white\" data-kid=\"147\">Wasted spend detection</h4>\n                            </div>\n                            <p class=\"text-[var(--k-color-text-muted)] leading-relaxed\" data-kid=\"148\">Instantly isolate budget drains in underperforming ad sets and creatives with machine learning precision.</p>\n                        </div>\n                        <div class=\"p-8 rounded-3xl bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)] group hover:border-[var(--k-color-accent)]/30 transition-colors\" data-kid=\"149\">\n                            <div class=\"flex items-center gap-4 mb-3\" data-kid=\"150\">\n                                <div class=\"w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center\" data-kid=\"151\">\n                                    <i class=\"ph-bold ph-chart-line-up text-white text-xl\" data-kid=\"152\"></i>\n                                </div>\n                                <h4 class=\"font-heading font-bold text-xl text-white\" data-kid=\"153\">Performance benchmarking</h4>\n                            </div>\n                            <p class=\"text-[var(--k-color-text-muted)] leading-relaxed\" data-kid=\"154\">Measure your performance against real-world industry benchmarks to identify hidden growth opportunities.</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"bg-[var(--k-color-bg-surface)] p-2 rounded-[2rem] border border-[var(--k-color-border)] shadow-2xl relative group\" data-kid=\"155\">\n                    <div class=\"bg-[var(--k-color-bg-page)] rounded-[1.5rem] aspect-square flex items-center justify-center p-12 overflow-hidden relative\" data-kid=\"156\">\n                         <div class=\"grid grid-cols-2 gap-6 w-full h-full relative z-10\" data-kid=\"157\">\n                            <div class=\"bg-[var(--k-color-bg-surface)] rounded-2xl border border-[var(--k-color-border)] flex flex-col justify-end p-4\" data-kid=\"158\">\n                                <div class=\"w-1/2 h-2 bg-[var(--k-color-border)] rounded-full mb-2\" data-kid=\"159\"></div>\n                                <div class=\"w-3/4 h-2 bg-[var(--k-color-border)] rounded-full opacity-50\" data-kid=\"160\"></div>\n                            </div>\n                            <div class=\"bg-[var(--k-color-bg-surface)] rounded-2xl border border-[var(--k-color-accent)]/20 relative p-4 flex flex-col justify-end overflow-hidden\" data-kid=\"161\">\n                                <div class=\"absolute inset-0 bg-gradient-to-t from-[var(--k-color-accent)]/10 to-transparent\" data-kid=\"162\"></div>\n                                <div class=\"w-2/3 h-3 bg-[var(--k-color-accent)]/30 rounded-full mb-2\" data-kid=\"163\"></div>\n                                <div class=\"w-full h-3 bg-[var(--k-color-accent)]/20 rounded-full\" data-kid=\"164\"></div>\n                            </div>\n                            <div class=\"bg-[var(--k-color-bg-surface)] rounded-2xl border border-[var(--k-color-border)] p-4\" data-kid=\"165\">\n                                <div class=\"w-8 h-8 rounded-lg bg-[var(--k-color-border)] mb-4 opacity-30\" data-kid=\"166\"></div>\n                                <div class=\"w-full h-2 bg-[var(--k-color-border)] rounded-full mb-2\" data-kid=\"167\"></div>\n                                <div class=\"w-3/4 h-2 bg-[var(--k-color-border)] rounded-full\" data-kid=\"168\"></div>\n                            </div>\n                            <div class=\"bg-[var(--k-color-bg-surface)] rounded-2xl border border-[var(--k-color-border)] p-4 flex items-center justify-center\" data-kid=\"169\">\n                                <i class=\"ph-bold ph-trend-up text-[var(--k-color-border)] text-3xl opacity-40 group-hover:opacity-100 group-hover:text-[var(--k-color-accent)] transition-all duration-700\" data-kid=\"170\"></i>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <footer class=\"py-20 px-8 md:px-12 border-t border-[var(--k-color-border)]/30\" data-kid=\"171\">\n        <div class=\"max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-12\" data-kid=\"172\">\n            <div class=\"col-span-2\" data-kid=\"173\">\n                <div class=\"flex items-center gap-2 mb-6\" data-kid=\"174\">\n                    <div class=\"w-8 h-8 bg-[var(--k-color-accent)] rounded-lg flex items-center justify-center\" data-kid=\"175\">\n                        <i class=\"ph-bold ph-lightning text-[var(--k-color-bg-page)] text-lg\" data-kid=\"176\"></i>\n                    </div>\n                    <span class=\"font-heading font-bold text-xl tracking-tight\" data-kid=\"177\">AdAudit AI</span>\n                </div>\n                <p class=\"text-[var(--k-color-text-muted)] text-sm leading-relaxed max-w-xs\" data-kid=\"178\">\n                    The intelligence layer for your ad operations. Uncovering hidden ROI since 2024.\n                </p>\n            </div>\n            <div data-kid=\"179\">\n                <h5 class=\"text-white font-bold mb-6 text-sm\" data-kid=\"180\">Product</h5>\n                <ul class=\"space-y-4 text-sm text-[var(--k-color-text-muted)]\" data-kid=\"181\">\n                    <li data-kid=\"182\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)]\" data-kid=\"183\">Audit Engine</a></li>\n                    <li data-kid=\"184\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)]\" data-kid=\"185\">Integrations</a></li>\n                    <li data-kid=\"186\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)]\" data-kid=\"187\">Security</a></li>\n                </ul>\n            </div>\n            <div data-kid=\"188\">\n                <h5 class=\"text-white font-bold mb-6 text-sm\" data-kid=\"189\">Company</h5>\n                <ul class=\"space-y-4 text-sm text-[var(--k-color-text-muted)]\" data-kid=\"190\">\n                    <li data-kid=\"191\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)]\" data-kid=\"192\">About</a></li>\n                    <li data-kid=\"193\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)]\" data-kid=\"194\">Careers</a></li>\n                    <li data-kid=\"195\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)]\" data-kid=\"196\">Contact</a></li>\n                </ul>\n            </div>\n            <div class=\"col-span-2\" data-kid=\"197\">\n                <h5 class=\"text-white font-bold mb-6 text-sm\" data-kid=\"198\">Join the Newsletter</h5>\n                <div class=\"flex gap-2\" data-kid=\"199\">\n                    <input type=\"email\" placeholder=\"Email address\" class=\"flex-1 px-4 py-2.5 rounded-xl bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)] text-sm focus:outline-none focus:border-[var(--k-color-accent)]\" data-kid=\"200\">\n                    <button class=\"px-4 py-2.5 bg-white text-[var(--k-color-bg-page)] rounded-xl text-sm font-bold\" data-kid=\"201\">Join</button>\n                </div>\n            </div>\n        </div>\n        <div class=\"max-w-7xl mx-auto mt-20 pt-8 border-t border-[var(--k-color-border)]/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-[var(--k-color-text-muted)] font-bold uppercase tracking-widest\" data-kid=\"202\">\n            <p data-kid=\"203\">© 2026 AdAudit AI Inc. All rights reserved.</p>\n            <div class=\"flex gap-8\" data-kid=\"204\">\n                <a href=\"#\" class=\"hover:text-white\" data-kid=\"205\">Privacy</a>\n                <a href=\"#\" class=\"hover:text-white\" data-kid=\"206\">Terms</a>\n                <a href=\"#\" class=\"hover:text-white\" data-kid=\"207\">Cookies</a>\n            </div>\n        </div>\n    </footer>\n</div>\n\n<script src=\"https://unpkg.com/@phosphor-icons/web\" data-kid=\"208\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"209\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"210\"></script>\n<script type=\"module\" data-kid=\"211\">\n    import { animate, scroll } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n    // GSAP Entrance\n    gsap.registerPlugin(ScrollTrigger);\n\n    gsap.from(\"#hero-title\", {\n        y: 60,\n        opacity: 0,\n        duration: 1.2,\n        ease: \"power4.out\"\n    });\n\n    gsap.from(\".fade-in\", {\n        y: 40,\n        opacity: 0,\n        duration: 1,\n        stagger: 0.2,\n        ease: \"power3.out\",\n        scrollTrigger: {\n            trigger: \"#configurator\",\n            start: \"top 80%\"\n        }\n    });\n\n    // Configurator Logic\n    const slider = document.getElementById('volume-slider');\n    const spendDisplay = document.getElementById('spend-value');\n    const usageFeeDisplay = document.getElementById('usage-fee');\n    const totalPriceDisplay = document.getElementById('total-price');\n    const networkToggles = document.querySelectorAll('.network-toggle');\n\n    const BASE_FEE = 299;\n    \n    function updatePricing() {\n        const spend = parseInt(slider.value);\n        const surcharge = Math.round(spend * 0.015);\n        \n        let networkFees = 0;\n        networkToggles.forEach(toggle => {\n            if (toggle.checked) {\n                networkFees += parseInt(toggle.value);\n            }\n        });\n\n        const total = BASE_FEE + surcharge + networkFees;\n\n        // Update displays\n        spendDisplay.textContent = `$${spend.toLocaleString()}`;\n        usageFeeDisplay.textContent = `+$${surcharge.toLocaleString()}`;\n        \n        // Animate price update with GSAP for that smooth counter feel\n        gsap.to(totalPriceDisplay, {\n            innerText: total,\n            duration: 0.5,\n            snap: { innerText: 1 },\n            onUpdate: function() {\n                this.targets()[0].innerHTML = parseInt(this.targets()[0].innerText).toLocaleString();\n            }\n        });\n    }\n\n    slider.addEventListener('input', updatePricing);\n    networkToggles.forEach(toggle => {\n        toggle.addEventListener('change', () => {\n            updatePricing();\n            updateToggleStyles();\n        });\n    });\n\n    // Handle toggle card styles dynamically\n    function updateToggleStyles() {\n        networkToggles.forEach(toggle => {\n            const card = toggle.closest('.network-card');\n            if (toggle.checked) {\n                card.style.borderColor = \"var(--k-color-accent)\";\n                card.style.backgroundColor = \"rgba(15, 255, 255, 0.03)\";\n            } else {\n                card.style.borderColor = \"var(--k-color-border)\";\n                card.style.backgroundColor = \"rgba(1, 31, 91, 0.5)\";\n            }\n        });\n    }\n\n    // Initial call\n    updatePricing();\n    updateToggleStyles();\n\n    // CTA Button effect\n    const cta = document.getElementById('cta-button');\n    cta.addEventListener('mouseenter', () => {\n        gsap.to(cta, { backgroundColor: \"#00E0E0\", duration: 0.2 });\n    });\n    cta.addEventListener('mouseleave', () => {\n        gsap.to(cta, { backgroundColor: \"#0FFFFF\", duration: 0.2 });\n    });\n\n</script>\n",
