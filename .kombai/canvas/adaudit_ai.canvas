      },
      "html": "\n<div class=\"min-h-screen bg-[var(--k-color-bg-page)] text-[var(--k-color-text-primary)] font-[var(--k-font-family-body)] pb-20 selection:bg-[var(--k-color-primary)] selection:text-white\" data-kid=\"0\">\n  \n  \n  <header class=\"max-w-7xl mx-auto px-6 py-8 flex items-center justify-between border-b border-[var(--k-color-border)]\" data-kid=\"1\">\n    <div class=\"flex items-center gap-4\" data-kid=\"2\">\n      <div class=\"w-10 h-10 bg-gradient-to-br from-[var(--k-color-primary)] to-[var(--k-color-bg-surface)] rounded-lg flex items-center justify-center border border-white/10 shadow-lg\" data-kid=\"3\">\n        <i class=\"ti ti-chart-dots text-white text-xl\" data-kid=\"4\"></i>\n      </div>\n      <div data-kid=\"5\">\n        <h1 class=\"text-xl font-bold font-[var(--k-font-family-heading)] tracking-tight\" data-kid=\"6\">Analysis Results <span class=\"text-[var(--k-color-text-muted)] font-normal ml-2\" data-kid=\"7\">#AUD-9402</span></h1>\n        <p class=\"text-[var(--k-color-text-muted)] text-sm\" data-kid=\"8\">Audit completed on June 14, 2026 • CSV: meta_ads_may_2026.csv</p>\n      </div>\n    </div>\n    <div class=\"flex gap-3\" data-kid=\"9\">\n      <button class=\"px-4 py-2 bg-[var(--k-color-bg-surface)] border border-[var(--k-color-border)] rounded-md text-sm font-medium hover:bg-[var(--k-color-bg-surface-hover)] transition-all flex items-center gap-2\" data-kid=\"10\">\n        <i class=\"ti ti-download\" data-kid=\"11\"></i> Export PDF\n      </button>\n      <button class=\"px-4 py-2 bg-[var(--k-color-primary)] text-white rounded-md text-sm font-bold hover:opacity-90 transition-all shadow-[0_0_15px_rgba(223,0,255,0.3)]\" data-kid=\"12\">\n        Apply All Fixes\n      </button>\n    </div>\n  </header>\n\n  <main class=\"max-w-7xl mx-auto px-6 py-12 space-y-24\" data-kid=\"13\">\n\n    \n    <section id=\"health-score\" class=\"relative pb-12\" data-kid=\"14\">\n      <div class=\"relative w-full h-[500px] rounded-[2.5rem] border border-white/10 bg-[var(--k-color-bg-surface)] shadow-[0_24px_80px_rgba(0,0,0,0.8)]\" data-kid=\"15\">\n        \n        <div class=\"absolute inset-0 opacity-30 rounded-[2.5rem] overflow-hidden\" data-kid=\"16\">\n          <div class=\"absolute inset-0\" style=\"background: radial-gradient(circle at 50% -20%, var(--k-color-primary) 0%, transparent 60%);\" data-kid=\"17\"></div>\n          <div class=\"absolute inset-0\" style=\"background: linear-gradient(180deg, transparent 50%, #000 100%);\" data-kid=\"18\"></div>\n        </div>\n        \n        \n        <div class=\"absolute inset-0 opacity-10 mix-blend-overlay pointer-events-none rounded-[2.5rem] overflow-hidden\" style=\"background-image: url('https://grainy-gradients.vercel.app/noise.svg');\" data-kid=\"19\"></div>\n\n        <div class=\"relative z-10 flex flex-col items-center justify-center h-full\" data-kid=\"20\">\n          \n          <div class=\"relative\" data-kid=\"21\">\n            <div class=\"relative w-72 h-72 flex items-center justify-center\" data-kid=\"22\">\n              <svg class=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 100 100\" data-kid=\"23\">\n                <circle cx=\"50\" cy=\"50\" r=\"46\" fill=\"none\" stroke=\"rgba(255,255,255,0.03)\" stroke-width=\"4\" stroke-linecap=\"round\" data-kid=\"24\"></circle>\n                <circle id=\"gauge-arc\" cx=\"50\" cy=\"50\" r=\"46\" fill=\"none\" stroke=\"url(#gauge-gradient)\" stroke-width=\"6\" stroke-dasharray=\"289\" stroke-dashoffset=\"289\" stroke-linecap=\"round\" class=\"drop-shadow-[0_0_15px_rgba(223,0,255,0.6)]\" data-kid=\"25\"></circle>\n                <defs data-kid=\"26\">\n                  <linearGradient id=\"gauge-gradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\" data-kid=\"27\">\n                    <stop offset=\"0%\" stop-color=\"#DF00FF\" data-kid=\"28\"></stop>\n                    <stop offset=\"100%\" stop-color=\"#FF33FF\" data-kid=\"29\"></stop>\n                  </linearGradient>\n                </defs>\n              </svg>\n              <div class=\"absolute inset-0 flex flex-col items-center justify-center\" data-kid=\"30\">\n                <div class=\"flex items-baseline\" data-kid=\"31\">\n                  <span id=\"health-score-value\" class=\"text-8xl font-black tracking-tighter text-white\" data-kid=\"32\">0</span>\n                  <span class=\"text-3xl text-[var(--k-color-text-muted)] font-bold ml-1\" data-kid=\"33\">/100</span>\n                </div>\n                <div class=\"flex flex-col items-center mt-2\" data-kid=\"34\">\n                    <span class=\"text-[var(--k-color-primary)] text-[10px] font-black uppercase tracking-[0.3em]\" data-kid=\"35\">AI Audit Score</span>\n                    <div class=\"flex gap-1 mt-1\" data-kid=\"36\">\n                        <span class=\"w-1 h-1 rounded-full bg-[var(--k-color-primary)]\" data-kid=\"37\"></span>\n                        <span class=\"w-1 h-1 rounded-full bg-[var(--k-color-primary)] opacity-40\" data-kid=\"38\"></span>\n                        <span class=\"w-1 h-1 rounded-full bg-[var(--k-color-primary)] opacity-10\" data-kid=\"39\"></span>\n                    </div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <h2 class=\"text-2xl font-black mt-6 tracking-tight text-white uppercase italic\" data-kid=\"40\">Account Efficiency: Optimal</h2>\n        </div>\n      </div>\n\n      \n      <div class=\"relative -mt-16 px-12 grid grid-cols-1 md:grid-cols-3 gap-6 z-20\" data-kid=\"41\">\n        <div class=\"kpi-card bg-[#1A171A]/80 border border-white/5 rounded-2xl p-6 shadow-2xl backdrop-blur-2xl\" data-kid=\"42\">\n          <div class=\"flex items-center justify-between mb-4\" data-kid=\"43\">\n            <span class=\"text-[var(--k-color-text-muted)] text-[10px] font-black uppercase tracking-widest\" data-kid=\"44\">Gross Spend</span>\n            <i class=\"ti ti-currency-dollar text-[var(--k-color-primary)]\" data-kid=\"45\"></i>\n          </div>\n          <div class=\"text-3xl font-bold text-white tracking-tighter\" data-kid=\"46\">$124,500.00</div>\n          <div class=\"flex items-center gap-2 mt-4 pt-4 border-t border-white/5\" data-kid=\"47\">\n            <span class=\"text-[var(--k-color-success)] text-xs font-bold flex items-center\" data-kid=\"48\">+4.2%</span>\n            <span class=\"text-[var(--k-color-text-muted)] text-[10px]\" data-kid=\"49\">Monthly Trend</span>\n          </div>\n        </div>\n\n        <div class=\"kpi-card bg-[#1A171A] border border-[var(--k-color-primary)]/20 rounded-2xl p-6 shadow-[0_20px_50px_rgba(223,0,255,0.15)] scale-105 relative overflow-hidden\" data-kid=\"50\">\n          <div class=\"absolute top-0 right-0 w-24 h-24 bg-[var(--k-color-primary)]/10 blur-3xl -mr-12 -mt-12\" data-kid=\"51\"></div>\n          <div class=\"flex items-center justify-between mb-4\" data-kid=\"52\">\n            <span class=\"text-[var(--k-color-primary)] text-[10px] font-black uppercase tracking-widest\" data-kid=\"53\">Cvr Efficiency</span>\n            <i class=\"ti ti-bolt text-[var(--k-color-primary)]\" data-kid=\"54\"></i>\n          </div>\n          <div class=\"text-3xl font-bold text-white tracking-tighter\" data-kid=\"55\">3.82%</div>\n          <div class=\"flex items-center gap-2 mt-4 pt-4 border-t border-white/5\" data-kid=\"56\">\n            <span class=\"text-[var(--k-color-success)] text-xs font-bold flex items-center\" data-kid=\"57\">+0.4%</span>\n            <span class=\"text-[var(--k-color-text-muted)] text-[10px]\" data-kid=\"58\">vs. Benchmark 2.1%</span>\n          </div>\n        </div>\n\n        <div class=\"kpi-card bg-[#1A171A]/80 border border-white/5 rounded-2xl p-6 shadow-2xl backdrop-blur-2xl\" data-kid=\"59\">\n          <div class=\"flex items-center justify-between mb-4\" data-kid=\"60\">\n            <span class=\"text-[var(--k-color-text-muted)] text-[10px] font-black uppercase tracking-widest\" data-kid=\"61\">Effective CPA</span>\n            <i class=\"ti ti-target text-[var(--k-color-error)]\" data-kid=\"62\"></i>\n          </div>\n          <div class=\"text-3xl font-bold text-white tracking-tighter\" data-kid=\"63\">$32.12</div>\n          <div class=\"flex items-center gap-2 mt-4 pt-4 border-t border-white/5\" data-kid=\"64\">\n            <span class=\"text-[var(--k-color-error)] text-xs font-bold flex items-center\" data-kid=\"65\">-1.2%</span>\n            <span class=\"text-[var(--k-color-text-muted)] text-[10px]\" data-kid=\"66\">Industry Target: $45</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"insights\" class=\"pt-12\" data-kid=\"67\">\n      <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-6\" data-kid=\"68\">\n        \n        \n        <div class=\"bento-widget lg:col-span-8 bg-[var(--k-color-bg-surface)] border border-white/5 rounded-3xl p-8 relative overflow-hidden\" data-kid=\"69\">\n          <div class=\"flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12\" data-kid=\"70\">\n            <div data-kid=\"71\">\n              <h3 class=\"text-xl font-black text-white italic tracking-tight uppercase\" data-kid=\"72\">Waste Velocity</h3>\n              <p class=\"text-[var(--k-color-text-muted)] text-sm\" data-kid=\"73\">Real-time projection of inefficient budget allocation.</p>\n            </div>\n            <div class=\"flex items-baseline gap-2 bg-[var(--k-color-error)]/10 px-6 py-4 rounded-2xl border border-[var(--k-color-error)]/20\" data-kid=\"74\">\n                <span class=\"text-sm font-black text-[var(--k-color-error)] uppercase italic tracking-widest\" data-kid=\"75\">Loss Risk</span>\n                <span class=\"text-3xl font-bold text-white tracking-tighter\" data-kid=\"76\">$12,430</span>\n            </div>\n          </div>\n          \n          <div class=\"h-48 w-full relative\" data-kid=\"77\">\n            <svg class=\"w-full h-full\" viewBox=\"0 0 800 200\" preserveAspectRatio=\"none\" data-kid=\"78\">\n              <path d=\"M0,180 Q100,160 200,190 T300,100 T400,20 T500,150 T600,130 T700,110 T800,50 L800,200 L0,200 Z\" fill=\"url(#p-grad)\" opacity=\"0.1\" data-kid=\"79\"></path>\n              <path d=\"M0,180 Q100,160 200,190 T300,100 T400,20 T500,150 T600,130 T700,110 T800,50\" fill=\"none\" stroke=\"var(--k-color-error)\" stroke-width=\"4\" stroke-linecap=\"round\" data-kid=\"80\"></path>\n              <defs data-kid=\"81\">\n                <linearGradient id=\"p-grad\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\" data-kid=\"82\">\n                  <stop offset=\"0%\" stop-color=\"var(--k-color-error)\" data-kid=\"83\"></stop>\n                  <stop offset=\"100%\" stop-color=\"transparent\" data-kid=\"84\"></stop>\n                </linearGradient>\n              </defs>\n            </svg>\n          </div>\n        </div>\n\n        \n        <div class=\"bento-widget lg:col-span-4 bg-[var(--k-color-bg-surface)] border border-white/5 rounded-3xl p-8\" data-kid=\"85\">\n          <h3 class=\"text-sm font-black text-white uppercase tracking-widest mb-6 border-b border-white/5 pb-4\" data-kid=\"86\">Critical Kill-List</h3>\n          <div class=\"overflow-x-auto\" data-kid=\"87\">\n            <table class=\"w-full text-left\" data-kid=\"88\">\n                <thead data-kid=\"89\">\n                    <tr class=\"text-[var(--k-color-text-muted)] text-[10px] uppercase font-black\" data-kid=\"90\">\n                        <th class=\"pb-4\" data-kid=\"91\">Keyword</th>\n                        <th class=\"pb-4 text-right\" data-kid=\"92\">Waste</th>\n                    </tr>\n                </thead>\n                <tbody class=\"text-sm font-medium\" data-kid=\"93\">\n                    <tr class=\"border-b border-white/5\" data-kid=\"94\">\n                        <td class=\"py-4 text-white\" data-kid=\"95\">\"cheap laptop\"</td>\n                        <td class=\"py-4 text-right text-[var(--k-color-error)] font-bold\" data-kid=\"96\">$1,204</td>\n                    </tr>\n                    <tr class=\"border-b border-white/5\" data-kid=\"97\">\n                        <td class=\"py-4 text-white\" data-kid=\"98\">\"free vpn\"</td>\n                        <td class=\"py-4 text-right text-[var(--k-color-error)] font-bold\" data-kid=\"99\">$982</td>\n                    </tr>\n                    <tr class=\"border-b border-white/5\" data-kid=\"100\">\n                        <td class=\"py-4 text-white\" data-kid=\"101\">\"best antivirus\"</td>\n                        <td class=\"py-4 text-right text-[var(--k-color-error)] font-bold\" data-kid=\"102\">$743</td>\n                    </tr>\n                </tbody>\n            </table>\n          </div>\n          <button class=\"w-full mt-6 py-4 bg-white/[0.02] border border-white/5 rounded-xl text-[10px] font-black text-[var(--k-color-text-muted)] hover:text-white hover:bg-white/[0.05] uppercase tracking-widest\" data-kid=\"103\">\n            Audit Full Set (248)\n          </button>\n        </div>\n\n        \n        <div class=\"bento-widget lg:col-span-4 bg-[#1A171A] border border-white/5 rounded-3xl p-6 flex flex-col justify-between\" data-kid=\"104\">\n            <div class=\"flex justify-between items-center mb-6\" data-kid=\"105\">\n                <span class=\"text-[var(--k-color-text-muted)] text-[10px] font-black uppercase tracking-widest\" data-kid=\"106\">ROAS Pacing</span>\n                <span class=\"px-2 py-1 bg-[var(--k-color-warning)]/10 text-[var(--k-color-warning)] text-[8px] font-black rounded uppercase\" data-kid=\"107\">Target: 4.5x</span>\n            </div>\n            <div class=\"flex items-end justify-between\" data-kid=\"108\">\n                <div data-kid=\"109\">\n                    <div class=\"text-4xl font-bold text-white tracking-tighter\" data-kid=\"110\">3.2x</div>\n                    <p class=\"text-[var(--k-color-text-muted)] text-[10px] mt-1\" data-kid=\"111\">Acct. Cumulative</p>\n                </div>\n                <div class=\"w-24 h-12\" data-kid=\"112\">\n                    <svg class=\"w-full h-full\" viewBox=\"0 0 100 40\" data-kid=\"113\">\n                        <path d=\"M0,35 L20,30 L40,38 L60,20 L80,25 L100,5\" fill=\"none\" stroke=\"var(--k-color-warning)\" stroke-width=\"3\" stroke-linecap=\"round\" data-kid=\"114\"></path>\n                    </svg>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"bento-widget lg:col-span-4 bg-[#1A171A] border border-white/5 rounded-3xl p-6 flex flex-col justify-between\" data-kid=\"115\">\n            <div class=\"flex justify-between items-center mb-4\" data-kid=\"116\">\n                <span class=\"text-[var(--k-color-text-muted)] text-[10px] font-black uppercase tracking-widest\" data-kid=\"117\">Ad Reach</span>\n                <div class=\"w-2 h-2 rounded-full bg-[var(--k-color-primary)] animate-pulse\" data-kid=\"118\"></div>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"119\">\n                <div class=\"relative w-16 h-16\" data-kid=\"120\">\n                    <svg class=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 36 36\" data-kid=\"121\">\n                        <path d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\" fill=\"none\" stroke=\"rgba(255,255,255,0.05)\" stroke-width=\"4\" data-kid=\"122\"></path>\n                        <path d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\" fill=\"none\" stroke=\"var(--k-color-primary)\" stroke-width=\"4\" stroke-dasharray=\"60, 100\" data-kid=\"123\"></path>\n                    </svg>\n                    <div class=\"absolute inset-0 flex items-center justify-center text-[10px] font-bold text-white\" data-kid=\"124\">60%</div>\n                </div>\n                <div data-kid=\"125\">\n                    <div class=\"text-3xl font-bold text-white tracking-tighter\" data-kid=\"126\">1.8%</div>\n                    <p class=\"text-[var(--k-color-text-muted)] text-[10px]\" data-kid=\"127\">Avg Click-Through Rate</p>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"bento-widget lg:col-span-4 bg-[#1A171A] border border-white/5 rounded-3xl p-6 flex flex-col justify-between\" data-kid=\"128\">\n            <div class=\"flex justify-between items-center mb-4\" data-kid=\"129\">\n                <span class=\"text-[var(--k-color-text-muted)] text-[10px] font-black uppercase tracking-widest\" data-kid=\"130\">CPA Stability</span>\n                <i class=\"ti ti-chart-bar text-[var(--k-color-success)]\" data-kid=\"131\"></i>\n            </div>\n            <div class=\"flex-1 flex items-end gap-1 px-2 mb-2\" data-kid=\"132\">\n                <div class=\"w-full bg-white/5 h-[40%] rounded-t-sm\" data-kid=\"133\"></div>\n                <div class=\"w-full bg-white/5 h-[60%] rounded-t-sm\" data-kid=\"134\"></div>\n                <div class=\"w-full bg-white/5 h-[55%] rounded-t-sm\" data-kid=\"135\"></div>\n                <div class=\"w-full bg-[var(--k-color-success)] h-[80%] rounded-t-sm shadow-[0_0_10px_var(--k-color-success)]\" data-kid=\"136\"></div>\n                <div class=\"w-full bg-white/5 h-[65%] rounded-t-sm\" data-kid=\"137\"></div>\n                <div class=\"w-full bg-white/5 h-[70%] rounded-t-sm\" data-kid=\"138\"></div>\n            </div>\n            <div class=\"text-2xl font-bold text-white tracking-tighter\" data-kid=\"139\">$32.12 <span class=\"text-xs text-[var(--k-color-success)] font-medium ml-2\" data-kid=\"140\">-14%</span></div>\n        </div>\n\n      </div>\n    </section>\n\n    \n    <section id=\"recommendations\" class=\"pt-24\" data-kid=\"141\">\n      <div class=\"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 pb-6 border-b border-white/5\" data-kid=\"142\">\n        <div data-kid=\"143\">\n          <h2 class=\"text-3xl font-black text-white italic tracking-tight uppercase\" data-kid=\"144\">Audit Action Log</h2>\n          <p class=\"text-[var(--k-color-text-muted)] mt-1\" data-kid=\"145\">Categorized priority interventions for immediate deployment.</p>\n        </div>\n        <div class=\"flex bg-[#1A171A] p-2 rounded-2xl border border-white/5 shadow-2xl\" data-kid=\"146\">\n          <button class=\"px-6 py-2 text-[10px] font-black text-white bg-[var(--k-color-bg-surface-hover)] rounded-xl uppercase tracking-widest\" data-kid=\"147\">Critical (2)</button>\n          <button class=\"px-6 py-2 text-[10px] font-black text-[var(--k-color-text-muted)] hover:text-white rounded-xl uppercase tracking-widest\" data-kid=\"148\">Medium (12)</button>\n        </div>\n      </div>\n\n      <div class=\"space-y-4\" data-kid=\"149\">\n        \n        \n        <div class=\"rec-card bg-[#1A171A] border border-white/5 rounded-3xl p-8 flex flex-col md:flex-row md:items-center gap-8 relative overflow-hidden hover:bg-white/[0.03] transition-colors cursor-pointer group\" data-kid=\"150\">\n          <div class=\"absolute inset-y-0 left-0 w-2 bg-[var(--k-color-error)]\" data-kid=\"151\"></div>\n          <div class=\"shrink-0 w-16 h-16 bg-[var(--k-color-error)]/10 rounded-2xl flex items-center justify-center\" data-kid=\"152\">\n            <i class=\"ti ti-flame text-2xl text-[var(--k-color-error)]\" data-kid=\"153\"></i>\n          </div>\n          <div class=\"grow\" data-kid=\"154\">\n            <div class=\"flex items-center gap-3 mb-2\" data-kid=\"155\">\n                <span class=\"text-[10px] font-black text-[var(--k-color-error)] uppercase tracking-widest bg-[var(--k-color-error)]/10 px-2 py-0.5 rounded\" data-kid=\"156\">High Impact</span>\n            </div>\n            <h4 class=\"text-xl font-bold text-white mb-2 leading-tight tracking-tight\" data-kid=\"157\">Pause Keyword: 'cheap software'</h4>\n            <p class=\"text-[var(--k-color-text-muted)] text-sm max-w-2xl leading-relaxed\" data-kid=\"158\">\n              Detected <span class=\"text-white font-bold\" data-kid=\"159\">0% CVR</span> over 4,500 samples. Broad match expansion is capturing irrelevant search queries.\n            </p>\n          </div>\n          <div class=\"shrink-0 flex flex-col items-end gap-4 min-w-[200px]\" data-kid=\"160\">\n            <div class=\"text-right\" data-kid=\"161\">\n                <div class=\"text-[var(--k-color-text-muted)] text-[10px] uppercase font-black tracking-widest\" data-kid=\"162\">Weekly Waste</div>\n                <div class=\"text-2xl font-bold text-white\" data-kid=\"163\">$430.00</div>\n            </div>\n            <button class=\"w-full md:w-auto px-8 py-3 bg-[var(--k-color-primary)] text-white text-xs font-black uppercase tracking-widest rounded-xl shadow-[0_0_20px_rgba(223,0,255,0.3)]\" data-kid=\"164\">\n              Terminate Term\n            </button>\n          </div>\n        </div>\n\n        \n        <div class=\"rec-card bg-[#1A171A] border border-white/5 rounded-3xl p-8 flex flex-col md:flex-row md:items-center gap-8 relative overflow-hidden hover:bg-white/[0.03] transition-colors cursor-pointer group\" data-kid=\"165\">\n          <div class=\"absolute inset-y-0 left-0 w-2 bg-[var(--k-color-error)]\" data-kid=\"166\"></div>\n          <div class=\"shrink-0 w-16 h-16 bg-[var(--k-color-error)]/10 rounded-2xl flex items-center justify-center\" data-kid=\"167\">\n            <i class=\"ti ti-unlink text-2xl text-[var(--k-color-error)]\" data-kid=\"168\"></i>\n          </div>\n          <div class=\"grow\" data-kid=\"169\">\n            <div class=\"flex items-center gap-3 mb-2\" data-kid=\"170\">\n                <span class=\"text-[10px] font-black text-[var(--k-color-error)] uppercase tracking-widest bg-[var(--k-color-error)]/10 px-2 py-0.5 rounded\" data-kid=\"171\">Severe Error</span>\n            </div>\n            <h4 class=\"text-xl font-bold text-white mb-2 leading-tight tracking-tight\" data-kid=\"172\">Broken URL: Summer_Sale_Meta</h4>\n            <p class=\"text-[var(--k-color-text-muted)] text-sm max-w-2xl leading-relaxed\" data-kid=\"173\">\n              Target destination returns <span class=\"text-[var(--k-color-error)] font-bold\" data-kid=\"174\">404 Not Found</span>. Immediate intervention required.\n            </p>\n          </div>\n          <div class=\"shrink-0 flex flex-col items-end gap-4 min-w-[200px]\" data-kid=\"175\">\n            <div class=\"text-right\" data-kid=\"176\">\n                <div class=\"text-[var(--k-color-text-muted)] text-[10px] uppercase font-black tracking-widest\" data-kid=\"177\">Active Loss</div>\n                <div class=\"text-2xl font-bold text-white\" data-kid=\"178\">$140.00 / day</div>\n            </div>\n            <button class=\"w-full md:w-auto px-8 py-3 bg-[var(--k-color-primary)] text-white text-xs font-black uppercase tracking-widest rounded-xl\" data-kid=\"179\">\n              Restore Link\n            </button>\n          </div>\n        </div>\n\n        \n        <div class=\"rec-card bg-[#1A171A]/40 border border-white/5 rounded-3xl p-8 flex flex-col md:flex-row md:items-center gap-8 relative overflow-hidden hover:bg-white/[0.03] transition-colors cursor-pointer group\" data-kid=\"180\">\n          <div class=\"absolute inset-y-0 left-0 w-2 bg-[var(--k-color-success)] opacity-50\" data-kid=\"181\"></div>\n          <div class=\"shrink-0 w-16 h-16 bg-[var(--k-color-success)]/10 rounded-2xl flex items-center justify-center\" data-kid=\"182\">\n            <i class=\"ti ti-bulb text-2xl text-[var(--k-color-success)]\" data-kid=\"183\"></i>\n          </div>\n          <div class=\"grow\" data-kid=\"184\">\n            <div class=\"flex items-center gap-3 mb-2\" data-kid=\"185\">\n                <span class=\"text-[10px] font-black text-[var(--k-color-success)] uppercase tracking-widest bg-[var(--k-color-success)]/10 px-2 py-0.5 rounded\" data-kid=\"186\">Expansion</span>\n            </div>\n            <h4 class=\"text-xl font-bold text-white mb-2 leading-tight tracking-tight\" data-kid=\"187\">Scale: Top Performer 'Video_Ads_V3'</h4>\n            <p class=\"text-[var(--k-color-text-muted)] text-sm max-w-2xl leading-relaxed\" data-kid=\"188\">\n              Asset is delivering <span class=\"text-white font-bold\" data-kid=\"189\">+240% baseline efficiency</span>.\n            </p>\n          </div>\n          <div class=\"shrink-0 flex flex-col items-end gap-4 min-w-[200px]\" data-kid=\"190\">\n            <div class=\"text-right\" data-kid=\"191\">\n                <div class=\"text-[var(--k-color-text-muted)] text-[10px] uppercase font-black tracking-widest\" data-kid=\"192\">Proj. Lift</div>\n                <div class=\"text-2xl font-bold text-white\" data-kid=\"193\">+$2.4k / mo</div>\n            </div>\n            <button class=\"w-full md:w-auto px-8 py-3 border border-white/10 text-white text-xs font-black uppercase tracking-widest rounded-xl\" data-kid=\"194\">\n              Approve Scale\n            </button>\n          </div>\n        </div>\n\n      </div>\n\n      \n      <div class=\"mt-16 flex flex-col items-center pb-24\" data-kid=\"195\">\n          <div class=\"w-full max-w-3xl bg-gradient-to-r from-transparent via-white/5 to-transparent h-px mb-12\" data-kid=\"196\"></div>\n          <div class=\"bg-[var(--k-color-bg-surface)] border border-white/10 p-8 rounded-[2rem] shadow-2xl flex flex-col md:flex-row items-center gap-8 w-full max-w-4xl\" data-kid=\"197\">\n              <div class=\"grow text-center md:text-left\" data-kid=\"198\">\n                  <h3 class=\"text-2xl font-black text-white italic tracking-tight uppercase\" data-kid=\"199\">Deploy full optimization?</h3>\n                  <p class=\"text-[var(--k-color-text-muted)] mt-2\" data-kid=\"200\">Implementing all <span class=\"text-white font-bold\" data-kid=\"201\">14 identified fixes</span> will increase ROAS by projected 18.2%.</p>\n              </div>\n              <button class=\"shrink-0 px-12 py-5 bg-[var(--k-color-primary)] text-white font-black uppercase tracking-widest text-sm rounded-2xl shadow-[0_20px_50px_rgba(223,0,255,0.4)]\" data-kid=\"202\">\n                  Deploy All Fixes\n              </button>\n          </div>\n          <p class=\"text-[var(--k-color-text-muted)] text-[10px] mt-8 uppercase tracking-[0.4em] font-black opacity-40\" data-kid=\"203\">AdAudit Engine v2.4.1 • System Secure</p>\n      </div>\n    </section>\n\n  </main>\n\n</div>\n\n\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"204\">\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"205\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"206\"></script>\n<script type=\"module\" data-kid=\"207\">\n  import { animate } from 'https://esm.sh/animejs@4';\n  import Lenis from \"https://esm.sh/lenis@1\"\n  import Snap from \"https://esm.sh/lenis@1/snap\"\n\n  // Initialize Lenis for smooth scroll\n  const lenis = new Lenis();\n  function raf(time) {\n    lenis.raf(time);\n    requestAnimationFrame(raf);\n  }\n  requestAnimationFrame(raf);\n\n  gsap.registerPlugin(ScrollTrigger);\n\n  window.addEventListener('load', () => {\n    // 1. Health Score Count Up & Gauge Arc\n    const scoreEl = document.getElementById('health-score-value');\n    const arcEl = document.getElementById('gauge-arc');\n    \n    // Anime.js v4 animate for counter with proper rounding\n    const counterValue = { val: 0 };\n    animate(counterValue, {\n      val: 72,\n      duration: 2000,\n      ease: 'outExpo',\n      onUpdate: (self) => {\n        scoreEl.textContent = Math.round(counterValue.val);\n      }\n    });\n\n    // Anime.js v4 animate for arc\n    animate(arcEl, {\n      strokeDashoffset: [283, 283 - (283 * 0.72)],\n      duration: 2000,\n      delay: 200,\n      ease: 'outExpo'\n    });\n\n    // 3. KPI Cards Spring Drop\n    gsap.from('.kpi-card', {\n      y: -60,\n      autoAlpha: 0,\n      duration: 1.2,\n      stagger: 0.2,\n      ease: 'elastic.out(1, 0.75)',\n      delay: 0.5\n    });\n\n    // 4. Batch Recommendation Card Reveals\n    gsap.set('.rec-card', { autoAlpha: 0, y: 30 });\n    ScrollTrigger.batch('.rec-card', {\n      onEnter: batch => gsap.to(batch, {\n        autoAlpha: 1,\n        y: 0,\n        stagger: 0.1,\n        duration: 0.8,\n        ease: 'power3.out',\n        overwrite: true\n      }),\n      start: 'top 85%'\n    });\n\n    // 5. Bento Grid Entrances (using .bento-widget instead of complex selector)\n    gsap.from('.bento-widget', {\n      scrollTrigger: {\n        trigger: '#insights',\n        start: 'top 80%',\n      },\n      autoAlpha: 0,\n      scale: 0.95,\n      y: 20,\n      stagger: 0.1,\n      duration: 0.6,\n      ease: 'power2.out'\n    });\n  });\n</script>\n\n<style data-kid=\"208\">\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=DM+Sans:wght@400;500;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --k-font-family-heading: 'Inter', sans-serif;\n    --k-font-family-body: 'DM Sans', sans-serif;\n  }\n\n  body {\n    background-color: var(--k-color-bg-page);\n    color: var(--k-color-text-primary);\n  }\n\n  /* Custom Hairline style */\n  .border-hairline {\n    border: 1px solid rgba(255, 255, 255, 0.05);\n  }\n\n  /* Fix for Masonry column break-inside in Safari */\n  .break-inside-avoid {\n    break-inside: avoid;\n    -webkit-column-break-inside: avoid;\n  }\n</style>\n",
