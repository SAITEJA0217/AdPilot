      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Fira+Sans:wght@400;500;600&display=swap');\n\n    :root {\n        --k-color-primary: #E3FF00;\n        --k-color-primary-hover: #D4EE00;\n        --k-color-secondary: #343434;\n        --k-color-bg-page: #1B1B1B;\n        --k-color-bg-surface: #262626;\n        --k-color-bg-surface-hover: #333333;\n        --k-color-text-primary: #E5E4E2;\n        --k-color-text-secondary: #BDBDBD;\n        --k-color-text-muted: #757575;\n        --k-color-border: #404040;\n        --k-color-accent: #E3FF00;\n        --k-color-success: #00FF41;\n        --k-font-family-heading: 'Space Grotesk', sans-serif;\n        --k-font-family-body: 'Fira Sans', sans-serif;\n    }\n\n    body {\n        background-color: var(--k-color-bg-page);\n        color: var(--k-color-text-primary);\n        font-family: var(--k-font-family-body);\n        margin: 0;\n        overflow-x: clip;\n    }\n\n    .noise-grain::after {\n        content: \"\";\n        position: fixed;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        pointer-events: none;\n        z-index: 9999;\n        opacity: 0.08;\n        background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%220%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');\n    }\n\n    .brutalist-border {\n        border: var(--k-border-width-thick) solid var(--k-color-border);\n    }\n\n    .hairline-b {\n        border-bottom: var(--k-border-width-default) solid var(--k-color-border);\n    }\n\n    .hairline-r {\n        border-right: var(--k-border-width-default) solid var(--k-color-border);\n    }\n\n    .thick-r {\n        border-right: var(--k-border-width-thick) solid var(--k-color-border);\n    }\n\n    .matrix-row {\n        opacity: 0;\n        transform: translateY(20px);\n    }\n</style>\n\n<div class=\"noise-grain min-h-screen\" data-kid=\"1\">\n    \n    <div class=\"fixed inset-0 pointer-events-none z-0\" data-kid=\"2\">\n        <div class=\"absolute inset-y-0 left-1/4 w-px bg-[var(--k-color-border)] opacity-20\" data-kid=\"3\"></div>\n        <div class=\"absolute inset-y-0 left-2/4 w-px bg-[var(--k-color-border)] opacity-20\" data-kid=\"4\"></div>\n        <div class=\"absolute inset-y-0 left-3/4 w-px bg-[var(--k-color-border)] opacity-20\" data-kid=\"5\"></div>\n        <div class=\"absolute inset-x-0 top-1/4 h-px bg-[var(--k-color-border)] opacity-20\" data-kid=\"6\"></div>\n        <div class=\"absolute inset-x-0 top-2/4 h-px bg-[var(--k-color-border)] opacity-20\" data-kid=\"7\"></div>\n        <div class=\"absolute inset-x-0 top-3/4 h-px bg-[var(--k-color-border)] opacity-20\" data-kid=\"8\"></div>\n    </div>\n\n    <nav class=\"relative z-50 flex justify-between items-center px-12 py-6 border-b border-[var(--k-color-border)] bg-[var(--k-color-bg-page)]/80 backdrop-blur-sm sticky top-0\" data-kid=\"9\">\n        <div class=\"font-[var(--k-font-family-heading)] font-bold text-2xl tracking-tighter\" data-kid=\"10\">\n            AD<span class=\"text-[var(--k-color-accent)]\" data-kid=\"11\">AUDIT</span>.AI\n        </div>\n        <div class=\"flex gap-8 text-xs font-mono uppercase tracking-widest\" data-kid=\"12\">\n            <a href=\"#\" class=\"hover:text-[var(--k-color-accent)]\" data-kid=\"13\">Platform</a>\n            <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] text-[var(--k-color-accent)]\" data-kid=\"14\">Pricing</a>\n            <a href=\"#\" class=\"hover:text-[var(--k-color-accent)]\" data-kid=\"15\">Docs</a>\n            <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] border-l border-[var(--k-color-border)] pl-8\" data-kid=\"16\">Login</a>\n        </div>\n    </nav>\n\n    <main class=\"relative z-10\" data-kid=\"17\">\n        \n        <section class=\"px-12 pt-24 pb-32\" data-kid=\"18\">\n            <div class=\"grid grid-cols-12 gap-8\" data-kid=\"19\">\n                <div class=\"col-span-12 lg:col-span-8\" data-kid=\"20\">\n                    <h1 class=\"text-[12vw] font-[var(--k-font-family-heading)] font-bold uppercase leading-none tracking-tighter mb-12\" data-kid=\"21\">\n                        Zero<br data-kid=\"22\">Waste<br data-kid=\"23\">Pricing.\n                    </h1>\n                </div>\n                <div class=\"col-span-12 lg:col-span-4 flex flex-col justify-end pb-4\" data-kid=\"24\">\n                    <p class=\"text-xl text-[var(--k-color-text-secondary)] mb-8 max-w-sm\" data-kid=\"25\">\n                        No arbitrary tiers. Pay for the accounts you manage, save what you were losing to bot traffic and poor bidding.\n                    </p>\n                    <div class=\"flex items-center gap-4\" data-kid=\"26\">\n                        <div class=\"w-12 h-1 bg-[var(--k-color-accent)]\" data-kid=\"27\"></div>\n                        <span class=\"font-mono text-xs uppercase tracking-tighter\" data-kid=\"28\">Engineered for Efficiency</span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"px-12 pb-32\" id=\"roi-section\" data-kid=\"29\">\n            <div class=\"brutalist-border p-8 bg-[var(--k-color-bg-surface)] relative\" data-kid=\"30\">\n                \n                <div class=\"absolute -top-3 left-12 h-6 w-32 bg-[var(--k-color-accent)] opacity-40 -rotate-2 z-20 pointer-events-none\" data-kid=\"31\"></div>\n                <div class=\"flex flex-col md:flex-row justify-between items-start md:items-end mb-12 border-b border-[var(--k-color-border)] pb-8\" data-kid=\"32\">\n                    <div data-kid=\"33\">\n                        <h2 class=\"text-4xl font-[var(--k-font-family-heading)] font-bold uppercase mb-2\" data-kid=\"34\">ROI Projection</h2>\n                        <p class=\"text-sm font-mono text-[var(--k-color-text-muted)] uppercase tracking-widest\" data-kid=\"35\">Savings vs Spend Analysis</p>\n                    </div>\n                    <div class=\"mt-6 md:mt-0 flex gap-8\" data-kid=\"36\">\n                        <div class=\"text-right\" data-kid=\"37\">\n                            <p class=\"text-[10px] uppercase text-[var(--k-color-text-muted)] mb-1\" data-kid=\"38\">Estimated Savings</p>\n                            <p class=\"text-3xl font-bold text-[var(--k-color-success)] font-[var(--k-font-family-heading)]\" id=\"savings-counter\" data-kid=\"39\">$0</p>\n                        </div>\n                        <div class=\"text-right\" data-kid=\"40\">\n                            <p class=\"text-[10px] uppercase text-[var(--k-color-text-muted)] mb-1\" data-kid=\"41\">Net Recovery</p>\n                            <p class=\"text-3xl font-bold text-[var(--k-color-accent)] font-[var(--k-font-family-heading)]\" id=\"net-counter\" data-kid=\"42\">312%</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"grid grid-cols-12 brutalist-border mt-12 bg-black/20 overflow-hidden\" data-kid=\"43\">\n                    \n                    <div class=\"col-span-2 border-r border-[var(--k-color-border)] p-6 font-mono text-[10px] text-[var(--k-color-text-secondary)] flex flex-col justify-between h-[500px]\" data-kid=\"44\">\n                        <span class=\"text-[var(--k-color-accent)] font-bold\" data-kid=\"45\">RECOVERY [EST]</span>\n                        <span data-kid=\"46\">$500,000.00</span>\n                        <span data-kid=\"47\">$375,000.00</span>\n                        <span data-kid=\"48\">$250,000.00</span>\n                        <span data-kid=\"49\">$125,000.00</span>\n                        <span data-kid=\"50\">$0.00</span>\n                    </div>\n                    \n                    \n                    <div class=\"col-span-10 relative h-[500px]\" data-kid=\"51\">\n                        <svg id=\"roi-chart\" class=\"w-full h-full p-8 overflow-visible\" viewBox=\"0 0 1000 500\" preserveAspectRatio=\"xMidYMid meet\" data-kid=\"52\">\n                            \n                            <g class=\"chart-grid opacity-10\" data-kid=\"53\">\n                                <line x1=\"0\" y1=\"0\" x2=\"1000\" y2=\"0\" stroke=\"white\" data-kid=\"54\"></line>\n                                <line x1=\"0\" y1=\"125\" x2=\"1000\" y2=\"125\" stroke=\"white\" data-kid=\"55\"></line>\n                                <line x1=\"0\" y1=\"250\" x2=\"1000\" y2=\"250\" stroke=\"white\" data-kid=\"56\"></line>\n                                <line x1=\"0\" y1=\"375\" x2=\"1000\" y2=\"375\" stroke=\"white\" data-kid=\"57\"></line>\n                                <line x1=\"0\" y1=\"500\" x2=\"1000\" y2=\"500\" stroke=\"white\" data-kid=\"58\"></line>\n                            </g>\n                            \n                            \n                            <path id=\"spend-line\" d=\"M 0 500 L 1000 0\" fill=\"none\" stroke=\"var(--k-color-accent)\" stroke-width=\"4\" vector-effect=\"non-scaling-stroke\" data-kid=\"59\"></path>\n                            \n                            \n                            <path id=\"savings-line\" d=\"M 0 450 Q 400 350 1000 100\" fill=\"none\" stroke=\"var(--k-color-success)\" stroke-width=\"4\" stroke-dasharray=\"12 6\" vector-effect=\"non-scaling-stroke\" data-kid=\"60\"></path>\n\n                            \n                            <g id=\"break-even-marker\" transform=\"translate(600, 200)\" data-kid=\"61\">\n                                <circle r=\"14\" fill=\"var(--k-color-bg-page)\" stroke=\"var(--k-color-accent)\" stroke-width=\"4\" data-kid=\"62\"></circle>\n                                <text x=\"24\" y=\"-12\" fill=\"var(--k-color-accent)\" class=\"text-3xl font-bold font-[var(--k-font-family-heading)] uppercase\" data-kid=\"63\">SYSTEM: BREAK-EVEN</text>\n                                <text x=\"24\" y=\"18\" fill=\"var(--k-color-text-secondary)\" class=\"text-xs font-mono\" data-kid=\"64\">COORD: 600K_ANNUAL_SPEND</text>\n                            </g>\n                        </svg>\n\n                        \n                        <div class=\"absolute bottom-0 left-0 right-0 p-4 border-t border-[var(--k-color-border)]/20 font-mono text-[9px] text-[var(--k-color-text-muted)] flex justify-between uppercase\" data-kid=\"65\">\n                            <span data-kid=\"66\">Axis: Annual Ad Spend (USD)</span>\n                            <span data-kid=\"67\">Scale: Linear 1:1</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"px-12 pb-32\" data-kid=\"68\">\n            <div class=\"flex justify-between items-end mb-12\" data-kid=\"69\">\n                <h2 class=\"text-5xl font-[var(--k-font-family-heading)] font-bold uppercase tracking-tighter\" data-kid=\"70\">The Matrix</h2>\n                <p class=\"text-xs font-mono text-[var(--k-color-text-muted)] max-w-xs text-right uppercase\" data-kid=\"71\">Standard features included in all tiers unless specified.</p>\n            </div>\n\n            <div class=\"brutalist-border overflow-hidden bg-[var(--k-color-bg-surface)]\" data-kid=\"72\">\n                \n                <div class=\"grid grid-cols-4 hairline-b\" data-kid=\"73\">\n                    <div class=\"p-8 thick-r flex items-end\" data-kid=\"74\">\n                        <span class=\"text-[11px] font-mono uppercase tracking-[0.3em] text-[var(--k-color-text-muted)]\" data-kid=\"75\">SYS_CONFIG</span>\n                    </div>\n                    <div class=\"p-8 thick-r text-center\" data-kid=\"76\">\n                        <h3 class=\"text-3xl font-[var(--k-font-family-heading)] font-bold uppercase mb-1\" data-kid=\"77\">LITE</h3>\n                        <div class=\"text-5xl font-bold tracking-tighter\" data-kid=\"78\">$99<span class=\"text-sm font-normal text-[var(--k-color-text-muted)]\" data-kid=\"79\">/mo</span></div>\n                    </div>\n                    <div class=\"p-8 thick-r text-center\" data-kid=\"80\">\n                        <h3 class=\"text-3xl font-[var(--k-font-family-heading)] font-bold uppercase mb-1\" data-kid=\"81\">PRO</h3>\n                        <div class=\"text-5xl font-bold tracking-tighter\" data-kid=\"82\">$299<span class=\"text-sm font-normal text-[var(--k-color-text-muted)]\" data-kid=\"83\">/mo</span></div>\n                    </div>\n                    <div class=\"p-8 text-center\" data-kid=\"84\">\n                        <h3 class=\"text-2xl font-[var(--k-font-family-heading)] font-bold uppercase mb-1\" data-kid=\"85\">ELITE</h3>\n                        <div class=\"text-4xl font-bold\" data-kid=\"86\">$899<span class=\"text-sm font-normal text-[var(--k-color-text-muted)]\" data-kid=\"87\">/mo</span></div>\n                    </div>\n                </div>\n\n                \n                <div id=\"matrix-body\" data-kid=\"88\">\n                    <div class=\"grid grid-cols-4 hairline-b matrix-row\" data-kid=\"89\">\n                        <div class=\"p-6 thick-r text-sm font-bold uppercase tracking-tight\" data-kid=\"90\">Ad Accounts Managed</div>\n                        <div class=\"p-6 thick-r text-center font-mono text-lg\" data-kid=\"91\">1</div>\n                        <div class=\"p-6 thick-r text-center font-mono text-lg text-[var(--k-color-accent)]\" data-kid=\"92\">Up to 10</div>\n                        <div class=\"p-6 text-center font-mono text-lg\" data-kid=\"93\">Unlimited</div>\n                    </div>\n                    <div class=\"grid grid-cols-4 hairline-b matrix-row\" data-kid=\"94\">\n                        <div class=\"p-6 thick-r text-sm font-bold uppercase tracking-tight\" data-kid=\"95\">Audit Depth</div>\n                        <div class=\"p-6 thick-r text-center text-xs uppercase text-[var(--k-color-text-secondary)]\" data-kid=\"96\">Standard</div>\n                        <div class=\"p-6 thick-r text-center text-xs uppercase text-[var(--k-color-accent)] font-bold\" data-kid=\"97\">Deep Neural</div>\n                        <div class=\"p-6 text-center text-xs uppercase text-[var(--k-color-text-secondary)]\" data-kid=\"98\">Deep Neural + Manual</div>\n                    </div>\n                    <div class=\"grid grid-cols-4 hairline-b matrix-row\" data-kid=\"99\">\n                        <div class=\"p-6 thick-r text-sm font-bold uppercase tracking-tight\" data-kid=\"100\">Bot Mitigation</div>\n                        <div class=\"p-6 thick-r text-center\" data-kid=\"101\"><i class=\"ti ti-check text-[var(--k-color-success)] text-lg\" data-kid=\"102\"></i></div>\n                        <div class=\"p-6 thick-r text-center\" data-kid=\"103\"><i class=\"ti ti-check text-[var(--k-color-accent)] text-2xl\" data-kid=\"104\"></i></div>\n                        <div class=\"p-6 text-center\" data-kid=\"105\"><i class=\"ti ti-check text-[var(--k-color-success)] text-lg\" data-kid=\"106\"></i></div>\n                    </div>\n                    <div class=\"grid grid-cols-4 hairline-b matrix-row\" data-kid=\"107\">\n                        <div class=\"p-6 thick-r text-sm font-bold uppercase tracking-tight\" data-kid=\"108\">Custom Rule Engine</div>\n                        <div class=\"p-6 thick-r text-center\" data-kid=\"109\"><i class=\"ti ti-x text-[var(--k-color-text-muted)] text-lg\" data-kid=\"110\"></i></div>\n                        <div class=\"p-6 thick-r text-center\" data-kid=\"111\"><i class=\"ti ti-check text-[var(--k-color-accent)] text-2xl\" data-kid=\"112\"></i></div>\n                        <div class=\"p-6 text-center\" data-kid=\"113\"><i class=\"ti ti-check text-[var(--k-color-success)] text-lg\" data-kid=\"114\"></i></div>\n                    </div>\n                    <div class=\"grid grid-cols-4 hairline-b matrix-row\" data-kid=\"115\">\n                        <div class=\"p-6 thick-r text-sm font-bold uppercase tracking-tight\" data-kid=\"116\">API / Webhook Access</div>\n                        <div class=\"p-6 thick-r text-center\" data-kid=\"117\"><i class=\"ti ti-x text-[var(--k-color-text-muted)] text-lg\" data-kid=\"118\"></i></div>\n                        <div class=\"p-6 thick-r text-center\" data-kid=\"119\"><i class=\"ti ti-check text-[var(--k-color-accent)] text-2xl\" data-kid=\"120\"></i></div>\n                        <div class=\"p-6 text-center\" data-kid=\"121\"><i class=\"ti ti-check text-[var(--k-color-success)] text-lg\" data-kid=\"122\"></i></div>\n                    </div>\n                    <div class=\"grid grid-cols-4 matrix-row\" data-kid=\"123\">\n                        <div class=\"p-6 thick-r text-sm font-bold uppercase tracking-tight\" data-kid=\"124\">Dedicated Manager</div>\n                        <div class=\"p-6 thick-r text-center text-[var(--k-color-text-muted)]\" data-kid=\"125\">--</div>\n                        <div class=\"p-6 thick-r text-center text-[var(--k-color-text-muted)]\" data-kid=\"126\">--</div>\n                        <div class=\"p-6 text-center\" data-kid=\"127\"><i class=\"ti ti-check text-[var(--k-color-success)] text-lg\" data-kid=\"128\"></i></div>\n                    </div>\n                </div>\n\n                \n                <div class=\"grid grid-cols-4 bg-[var(--k-color-bg-surface)] border-t-2 border-[var(--k-color-border)]\" data-kid=\"129\">\n                    <div class=\"p-8 thick-r\" data-kid=\"130\"></div>\n                    <div class=\"p-8 thick-r\" data-kid=\"131\">\n                        <button class=\"w-full py-4 border border-[var(--k-color-border)] uppercase text-xs font-bold tracking-widest cta-btn\" data-kid=\"132\">Get Started</button>\n                    </div>\n                    <div class=\"p-8 thick-r\" data-kid=\"133\">\n                        <button class=\"w-full py-4 border border-[var(--k-color-border)] uppercase text-xs font-bold tracking-widest cta-btn\" data-kid=\"134\">Go Pro Now</button>\n                    </div>\n                    <div class=\"p-8\" data-kid=\"135\">\n                        <button class=\"w-full py-4 border border-[var(--k-color-border)] uppercase text-xs font-bold tracking-widest cta-btn\" data-kid=\"136\">Contact Sales</button>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section class=\"relative min-h-[100vh] flex items-center overflow-hidden border-t border-[var(--k-color-border)] bg-[var(--k-color-bg-page)]\" data-kid=\"137\">\n            <div class=\"absolute inset-0 z-0 opacity-10 pointer-events-none select-none\" data-kid=\"138\">\n                <span class=\"text-[50vw] font-[var(--k-font-family-heading)] font-bold leading-none uppercase -rotate-6 translate-y-32 inline-block text-[var(--k-color-text-primary)]\" data-kid=\"139\">WASTE</span>\n            </div>\n            \n            <div class=\"relative z-10 w-full grid grid-cols-12 gap-0\" data-kid=\"140\">\n                <div class=\"col-span-12 lg:col-span-7 p-12 lg:p-24 border-r border-[var(--k-color-border)]\" data-kid=\"141\">\n                    <h2 class=\"text-8xl lg:text-[10vw] font-[var(--k-font-family-heading)] font-bold uppercase leading-[0.85] tracking-tighter mb-12\" data-kid=\"142\">\n                        Stop<br data-kid=\"143\"><span class=\"text-[var(--k-color-accent)]\" data-kid=\"144\">Burning</span><br data-kid=\"145\">Capital.\n                    </h2>\n                    <p class=\"text-2xl font-mono text-[var(--k-color-text-secondary)] uppercase max-w-xl\" data-kid=\"146\">Every minute you wait is another dollar lost to inefficient bidding and bot-farms.</p>\n                </div>\n                <div class=\"col-span-12 lg:col-span-5 flex flex-col justify-center bg-[var(--k-color-bg-surface)] p-12 lg:p-24 group cursor-pointer relative overflow-hidden\" data-kid=\"147\">\n                    \n                    <div class=\"absolute inset-0 bg-[var(--k-color-accent)] translate-y-full group-hover:translate-y-0 transition-transform duration-700 ease-[cubic-bezier(0.19,1,0.22,1)] z-0\" data-kid=\"148\"></div>\n                    \n                    <div class=\"absolute top-12 right-12 opacity-10 group-hover:opacity-20 transition-opacity font-mono text-[8px] uppercase text-right pointer-events-none\" data-kid=\"149\">\n                        AUTH: VALIDATED<br data-kid=\"150\">TOKEN: 0X77A...F2\n                    </div>\n                    <div class=\"relative z-10\" data-kid=\"151\">\n                        <div class=\"text-[10px] font-mono uppercase tracking-[0.4em] mb-4 text-[var(--k-color-text-muted)] group-hover:text-black transition-colors\" data-kid=\"152\">Immediate Access</div>\n                        <div class=\"text-6xl font-[var(--k-font-family-heading)] font-bold uppercase leading-none mb-8 group-hover:text-black transition-colors\" data-kid=\"153\">Execute<br data-kid=\"154\">Audit<br data-kid=\"155\">→</div>\n                        <button class=\"px-10 py-5 border-2 border-[var(--k-color-border)] group-hover:border-black font-bold uppercase tracking-widest group-hover:bg-black group-hover:text-[var(--k-color-accent)] transition-all cta-btn\" data-kid=\"156\">Start Now</button>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    <footer class=\"border-t border-[var(--k-color-border)] px-12 py-12 bg-black relative overflow-hidden\" data-kid=\"157\">\n        \n        <div class=\"absolute top-0 right-0 p-4 opacity-5 pointer-events-none select-none font-mono text-[8vw] uppercase font-bold leading-none\" data-kid=\"158\">TERMINAL_01</div>\n        \n        \n        <div class=\"mb-12 border border-[var(--k-color-border)] p-4 bg-[var(--k-color-bg-surface)] max-w-sm font-mono text-[10px] leading-relaxed opacity-60\" data-kid=\"159\">\n            <div class=\"flex gap-2 mb-2\" data-kid=\"160\">\n                <div class=\"w-2 h-2 rounded-full bg-red-500\" data-kid=\"161\"></div>\n                <div class=\"w-2 h-2 rounded-full bg-yellow-500\" data-kid=\"162\"></div>\n                <div class=\"w-2 h-2 rounded-full bg-green-500\" data-kid=\"163\"></div>\n            </div>\n            <p class=\"text-[var(--k-color-success)]\" data-kid=\"164\">> Connection established...</p>\n            <p class=\"text-[var(--k-color-text-muted)]\" data-kid=\"165\">> Syncing ad_accounts.db [100%]</p>\n            <p class=\"text-[var(--k-color-text-muted)]\" data-kid=\"166\">> Analyzing traffic_logs_v4... DONE</p>\n            <p class=\"text-[var(--k-color-accent)]\" data-kid=\"167\">> Savings potential detected: +34%</p>\n        </div>\n\n        <div class=\"flex justify-between items-start relative z-10\" data-kid=\"168\">\n            <div class=\"max-w-xs\" data-kid=\"169\">\n                <div class=\"font-[var(--k-font-family-heading)] font-bold text-xl mb-4\" data-kid=\"170\">AD<span class=\"text-[var(--k-color-accent)]\" data-kid=\"171\">AUDIT</span>.AI</div>\n                <p class=\"text-xs text-[var(--k-color-text-muted)] font-mono uppercase\" data-kid=\"172\">Version 2.4.0 (Stable)<br data-kid=\"173\">Encrypted. Audited. Secure.</p>\n            </div>\n            <div class=\"flex gap-24\" data-kid=\"174\">\n                <div data-kid=\"175\">\n                    <p class=\"text-[10px] font-mono uppercase text-[var(--k-color-text-muted)] mb-4\" data-kid=\"176\">Network</p>\n                    <ul class=\"text-xs space-y-2 uppercase font-bold\" data-kid=\"177\">\n                        <li data-kid=\"178\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)]\" data-kid=\"179\">Status</a></li>\n                        <li data-kid=\"180\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)]\" data-kid=\"181\">Security</a></li>\n                        <li data-kid=\"182\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)]\" data-kid=\"183\">Infrastructure</a></li>\n                    </ul>\n                </div>\n                <div data-kid=\"184\">\n                    <p class=\"text-[10px] font-mono uppercase text-[var(--k-color-text-muted)] mb-4\" data-kid=\"185\">Social</p>\n                    <ul class=\"text-xs space-y-2 uppercase font-bold\" data-kid=\"186\">\n                        <li data-kid=\"187\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)]\" data-kid=\"188\">X / Twitter</a></li>\n                        <li data-kid=\"189\"><a href=\"#\" class=\"hover:text(--k-color-accent)]\" data-kid=\"190\">LinkedIn</a></li>\n                        <li data-kid=\"191\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)]\" data-kid=\"192\">GitHub</a></li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n        <div class=\"mt-24 pt-8 border-t border-[var(--k-color-border)] flex justify-between text-[10px] font-mono text-[var(--k-color-text-muted)]\" data-kid=\"193\">\n            <p data-kid=\"194\">&copy; 2024 ADAUDIT AI INC. ALL RIGHTS RESERVED.</p>\n            <p data-kid=\"195\">BASED IN SF / TOKYO / LONDON</p>\n        </div>\n    </footer>\n</div>\n\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" data-kid=\"196\">\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"197\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"198\"></script>\n<script type=\"module\" data-kid=\"199\">\n    import { animate, hover } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Initial load animations\n    window.addEventListener('load', () => {\n        // SVG Chart animation\n        const spendLine = document.querySelector('#spend-line');\n        const savingsLine = document.querySelector('#savings-line');\n        const breakEvenMarker = document.querySelector('#break-even-marker');\n        \n        const spendLen = spendLine.getTotalLength();\n        const savingsLen = savingsLine.getTotalLength();\n\n        gsap.set(spendLine, { strokeDasharray: spendLen, strokeDashoffset: spendLen });\n        gsap.set(savingsLine, { strokeDasharray: savingsLen, strokeDashoffset: savingsLen });\n        gsap.set(breakEvenMarker, { scale: 0, opacity: 0 });\n\n        const tl = gsap.timeline({\n            scrollTrigger: {\n                trigger: '#roi-section',\n                start: 'top 60%',\n            }\n        });\n\n        tl.to(spendLine, { strokeDashoffset: 0, duration: 2, ease: \"power2.inOut\" })\n          .to(savingsLine, { strokeDashoffset: 0, duration: 2, ease: \"power2.inOut\" }, \"-=1.5\")\n          .to(breakEvenMarker, { scale: 1, opacity: 1, duration: 0.8, ease: \"back.out(2)\" })\n          .to('#savings-counter', { \n              duration: 2, \n              innerText: 142500, \n              snap: { innerText: 1 },\n              onUpdate: function() {\n                  const val = Math.floor(this.targets()[0].innerText);\n                  this.targets()[0].innerText = '$' + val.toLocaleString();\n              }\n          }, \"-=1.5\")\n          .to('#net-counter', {\n              duration: 2,\n              innerText: 412,\n              snap: { innerText: 1 },\n              onUpdate: function() {\n                  const val = Math.floor(this.targets()[0].innerText);\n                  this.targets()[0].innerText = val + '%';\n              }\n          }, \"-=2\");\n\n        // Batch matrix reveal\n        ScrollTrigger.batch('.matrix-row', {\n            start: 'top 85%',\n            onEnter: (elements) => {\n                gsap.to(elements, {\n                    opacity: 1,\n                    y: 0,\n                    stagger: 0.1,\n                    duration: 0.6,\n                    ease: \"power2.out\"\n                });\n            }\n        });\n\n        // Motion hover effects for all cta-btns and links\n        const items = document.querySelectorAll('.cta-btn, nav a');\n        items.forEach(item => {\n            hover(item, (el) => {\n                const originalBg = window.getComputedStyle(el).backgroundColor;\n                const originalColor = window.getComputedStyle(el).color;\n                const isNav = el.tagName === 'A' && el.closest('nav');\n\n                if (isNav) {\n                    animate(el, { color: '#E3FF00' }, { duration: 0.2 });\n                } else {\n                    const hasBg = el.classList.contains('bg-[var(--k-color-accent)]');\n                    animate(el, { \n                        backgroundColor: hasBg ? '#ffffff' : '#E3FF00', \n                        color: '#000000' \n                    }, { duration: 0.3 });\n                }\n\n                return () => {\n                    if (isNav) {\n                        const isPricing = el.textContent === 'Pricing';\n                        animate(el, { color: isPricing ? '#E3FF00' : '#E5E4E2' }, { duration: 0.2 });\n                    } else {\n                        animate(el, { backgroundColor: originalBg, color: originalColor }, { duration: 0.3 });\n                    }\n                };\n            });\n        });\n    });\n</script>\n",
