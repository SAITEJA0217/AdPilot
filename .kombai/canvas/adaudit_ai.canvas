olor-accent)]/20 rounded flex items-center justify-center\" data-kid=\"192\">\n                    <svg class=\"w-4 h-4 text-[var(--k-color-accent)]\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" data-kid=\"193\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M13 10V3L4 14h7v7l9-11h-7z\" data-kid=\"194\"></path>\n                    </svg>\n                </div>\n                <span class=\"font-bold font-heading text-[var(--k-color-text-muted)]\" data-kid=\"195\">AdAudit AI</span>\n            </div>\n            <p class=\"text-xs text-[var(--k-color-text-muted)] uppercase tracking-widest font-bold\" data-kid=\"196\">\n                Generated at 14:42 UTC • 2026-06-14 • Report ID: 8A2F-9K31\n            </p>\n        </div>\n    </footer>\n</div>\n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"197\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"198\"></script>\n<script type=\"module\" data-kid=\"199\">\n    import { animate, stagger, scroll } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\";\n    import Lenis from \"https://esm.sh/lenis@1\";\n    import Snap from \"https://esm.sh/lenis@1/snap\";\n    \n    // Initialize Lenis Smooth Scroll\n    const lenis = new Lenis();\n    function raf(time) {\n        lenis.raf(time);\n        requestAnimationFrame(raf);\n    }\n    requestAnimationFrame(raf);\n\n    gsap.registerPlugin(ScrollTrigger);\n\n    // Entrance Animations\n    gsap.from(\"#insitu-metric h1\", {\n        y: 60,\n        opacity: 0,\n        duration: 1.2,\n        ease: \"power4.out\"\n    });\n\n    gsap.from(\"#insitu-metric p\", {\n        y: 40,\n        opacity: 0,\n        duration: 1.2,\n        delay: 0.2,\n        ease: \"power4.out\"\n    });\n\n    // Donut chart segments reveal\n    gsap.from(\"circle[stroke-dashoffset]\", {\n        strokeDashoffset: 282.7,\n        duration: 2,\n        delay: 0.5,\n        ease: \"expo.out\",\n        stagger: 0.2\n    });\n\n    // Animate counter\n    const wasteCounter = document.getElementById('waste-counter');\n    let counterObj = { value: 0 };\n    gsap.to(counterObj, {\n        value: 42.8,\n        duration: 2.5,\n        ease: \"expo.out\",\n        onUpdate: () => {\n            wasteCounter.textContent = `$${counterObj.value.toFixed(1)}k`;\n        }\n    });\n\n    // Intersection Observer for Bar Chart\n    const barObserver = new IntersectionObserver((entries) => {\n        entries.forEach(entry => {\n            if (entry.isIntersecting) {\n                const bars = entry.target.querySelectorAll('.tufte-bar-fill');\n                animate(bars, { \n                    width: (el) => `${el.dataset.value}%` \n                }, { \n                    delay: stagger(0.15),\n                    duration: 1.2,\n                    easing: [0.16, 1, 0.3, 1] \n                });\n                barObserver.unobserve(entry.target);\n            }\n        });\n    }, { threshold: 0.2 });\n\n    barObserver.observe(document.querySelector('#comparison-bars table'));\n\n    // Scroll reveal for cards\n    gsap.from(\".snap-center\", {\n        scrollTrigger: {\n            trigger: \"#swimlanes\",\n            start: \"top 70%\",\n        },\n        y: 80,\n        opacity: 0,\n        stagger: 0.08,\n        duration: 0.8,\n        ease: \"power3.out\"\n    });\n\n    // Sticky parallax for header\n    scroll(animate(\"header\", { borderBottomColor: [\"rgba(3, 57, 154, 0)\", \"rgba(3, 57, 154, 1)\"], backgroundColor: [\"rgba(1, 31, 91, 0)\", \"rgba(1, 31, 91, 0.8)\"] }), {\n        target: document.body,\n        offset: [\"0 0\", \"0.1 0\"]\n    });\n\n</script>\n<script src=\"https://unpkg.com/lucide@latest\" data-kid=\"200\"></script>\n<script data-kid=\"201\">\n    lucide.createIcons();\n    \n    // Custom Horizontal Scroll Buttons\n    document.querySelectorAll('.scroll-right').forEach(btn => {\n        btn.onclick = () => {\n            const container = btn.closest('section').querySelector('#google-carousel') || btn.closest('section').querySelector('#meta-carousel');\n            container.scrollBy({ left: 400, behavior: 'smooth' });\n        };\n    });\n    document.querySelectorAll('.scroll-left').forEach(btn => {\n        btn.onclick = () => {\n            const container = btn.closest('section').querySelector('#google-carousel') || btn.closest('section').querySelector('#meta-carousel');\n            container.scrollBy({ left: -400, behavior: 'smooth' });\n        };\n    });\n</script>\n",
