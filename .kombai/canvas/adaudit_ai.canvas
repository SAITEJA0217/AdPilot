      "html": "\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"0\">\n<style data-kid=\"1\">\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap');\n\n    :root {\n        --k-color-primary: #0FFFFF;\n        --k-color-primary-hover: #00E0E0;\n        --k-color-secondary: #0070BB;\n        --k-color-bg-page: #011F5B;\n        --k-color-bg-surface: #022C7A;\n        --k-color-bg-surface-hover: #03399A;\n        --k-color-text-primary: #F8F8FF;\n        --k-color-text-secondary: #D1D5DB;\n        --k-color-text-muted: #9CA3AF;\n        --k-color-border: #03399A;\n        --k-color-border-hover: #0446BC;\n        --k-color-accent: #0FFFFF;\n        --k-color-success: #10B981;\n        --k-color-warning: #F59E0B;\n        --k-color-error: #EF4444;\n    }\n\n    body {\n        background-color: var(--k-color-bg-page);\n        color: var(--k-color-text-primary);\n        font-family: 'IBM Plex Sans', sans-serif;\n        margin: 0;\n        -webkit-font-smoothing: antialiased;\n    }\n\n    .font-heading {\n        font-family: 'Plus Jakarta Sans', sans-serif;\n    }\n\n    /* Custom Scrollbar for Swimlanes */\n    .no-scrollbar::-webkit-scrollbar {\n        display: none;\n    }\n    .no-scrollbar {\n        -ms-overflow-style: none;\n        scrollbar-width: none;\n    }\n\n    /* Glow Effects */\n    .glow-accent {\n        box-shadow: 0 0 40px rgba(15, 255, 255, 0.15);\n    }\n\n    .donut-glow {\n        filter: drop-shadow(0 0 8px var(--k-color-accent));\n    }\n\n    /* Donut Chart Animation */\n    @keyframes rotate-slow {\n        from { transform: rotate(0deg); }\n        to { transform: rotate(360deg); }\n    }\n    .animate-rotate {\n        animation: rotate-slow 20s linear infinite;\n    }\n\n    /* Tufte Bar Chart */\n    .tufte-bar {\n        height: 6px;\n        background: rgba(255, 255, 255, 0.05);\n        border-radius: 99px;\n        overflow: hidden;\n    }\n\n    .tufte-bar-fill {\n        height: 100%;\n        border-radius: 99px;\n        /* Animation handled by JS to avoid conflicts */\n    }\n\n    /* Grid Mesh Pattern Overlay */\n    .grid-mesh {\n        background-image: radial-gradient(rgba(15, 255, 255, 0.05) 1px, transparent 1px);\n        background-size: 40px 40px;\n    }\n</style>\n\n<div class=\"relative min-h-screen grid-mesh\" id=\"main-content\" data-kid=\"2\">\n    \n    <header class=\"sticky top-0 z-50 bg-[var(--k-color-bg-page)]/80 backdrop-blur-md border-b border-[var(--k-color-border)]\" data-kid=\"3\">\n        <div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\" data-kid=\"4\">\n            <div class=\"flex items-center gap-2\" data-kid=\"5\">\n                <div class=\"w-10 h-10 bg-[var(--k-color-accent)] rounded-lg flex items-center justify-center\" data-kid=\"6\">\n                    <svg class=\"w-6 h-6 text-[var(--k-color-bg-page)]\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" data-kid=\"7\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M13 10V3L4 14h7v7l9-11h-7z\" data-kid=\"8\"></path>\n                    </svg>\n                </div>\n                <span class=\"text-xl font-bold font-heading tracking-tight\" data-kid=\"9\">AdAudit AI</span>\n            </div>\n            <nav class=\"hidden md:flex items-center gap-8\" data-kid=\"10\">\n                <a href=\"#\" class=\"text-sm font-medium text-[var(--k-color-text-secondary)] hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"11\">Overview</a>\n                <a href=\"#\" class=\"text-sm font-medium text-[var(--k-color-text-secondary)] hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"12\">Recommendations</a>\n                <a href=\"#\" class=\"text-sm font-medium text-[var(--k-color-text-secondary)] hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"13\">History</a>\n                <div class=\"h-6 w-px bg-[var(--k-color-border)]\" data-kid=\"14\"></div>\n                <button class=\"px-6 py-2.5 bg-[var(--k-color-accent)] text-[var(--k-color-bg-page)] rounded-full text-sm font-bold hover:bg-[var(--k-color-primary-hover)] transition-all shadow-[0_0_20px_rgba(15,255,255,0.3)]\" data-kid=\"15\">\n                    Re-run Audit\n                </button>\n            </nav>\n        </div>\n    </header>\n\n    <main data-kid=\"16\">\n        \n        <section id=\"insitu-metric\" class=\"relative min-h-[90vh] flex items-center px-6 pt-20 pb-32 overflow-hidden\" data-kid=\"17\">\n            \n            <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[25vw] font-bold font-heading text-white/[0.02] select-none pointer-events-none whitespace-nowrap leading-none\" data-kid=\"18\">\n                34.8% WASTE\n            </div>\n            \n            <div class=\"max-w-7xl mx-auto w-full relative z-10\" data-kid=\"19\">\n                <div class=\"grid grid-cols-1 xl:grid-cols-12 gap-12 items-end\" data-kid=\"20\">\n                    \n                    <div class=\"xl:col-span-8 space-y-12\" data-kid=\"21\">\n                        <div class=\"inline-flex items-center gap-2 px-4 py-1.5 bg-[var(--k-color-success)]/10 text-[var(--k-color-success)] text-xs font-bold rounded-full uppercase tracking-[0.15em] border border-[var(--k-color-success)]/20\" data-kid=\"22\">\n                            <span class=\"w-2 h-2 rounded-full bg-[var(--k-color-success)] animate-pulse\" data-kid=\"23\"></span>\n                            Deep Scan Verified\n                        </div>\n                        <h1 class=\"text-[clamp(3.5rem,8vw,6.5rem)] font-bold font-heading leading-[0.9] tracking-tighter\" data-kid=\"24\">\n                            Profit is <span class=\"italic text-[var(--k-color-accent)]\" data-kid=\"25\">leaking</span><br data-kid=\"26\"> \n                            through your budget.\n                        </h1>\n                        <div class=\"flex flex-wrap gap-8 items-center border-l-2 border-[var(--k-color-accent)] pl-8\" data-kid=\"27\">\n                            <p class=\"text-xl text-[var(--k-color-text-secondary)] max-w-lg leading-relaxed\" data-kid=\"28\">\n                                Our neural audit cross-referenced 12.4M bid signals. We found three specific leaks currently draining your ROAS by 1.8x.\n                            </p>\n                            <div class=\"flex items-center gap-4 bg-[var(--k-color-bg-surface)] p-6 rounded-3xl border border-[var(--k-color-border)]\" data-kid=\"29\">\n                                <div data-kid=\"30\">\n                                    <span class=\"block text-[10px] text-[var(--k-color-text-muted)] uppercase font-bold tracking-widest mb-1\" data-kid=\"31\">CPA Overspend</span>\n                                    <span class=\"text-4xl font-bold text-[var(--k-color-error)]\" data-kid=\"32\">+24.5%</span>\n                                </div>\n                                <div class=\"w-12 h-12 rounded-2xl bg-[var(--k-color-error)]/10 flex items-center justify-center\" data-kid=\"33\">\n                                    <i data-lucide=\"trending-up\" class=\"text-[var(--k-color-error)] w-6 h-6 rotate-45\" data-kid=\"34\"></i>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    \n                    <div class=\"xl:col-span-4 flex justify-end\" data-kid=\"35\">\n                        <div class=\"relative w-full max-w-[440px] aspect-square flex items-center justify-center\" data-kid=\"36\">\n                             \n                            <svg class=\"w-full h-full -rotate-90 transform donut-glow\" viewBox=\"0 0 100 100\" data-kid=\"37\">\n                                <circle class=\"text-[var(--k-color-border)]/20\" stroke-width=\"4\" stroke=\"currentColor\" fill=\"transparent\" r=\"45\" cx=\"50\" cy=\"50\" data-kid=\"38\"></circle>\n                                \n                                <circle class=\"text-[var(--k-color-accent)]\" stroke-width=\"8\" stroke-dasharray=\"282.7\" stroke-dashoffset=\"184.3\" stroke-linecap=\"round\" stroke=\"currentColor\" fill=\"transparent\" r=\"45\" cx=\"50\" cy=\"50\" data-kid=\"39\"></circle>\n                                \n                                <circle class=\"text-[var(--k-color-secondary)]\" stroke-width=\"6\" stroke-dasharray=\"282.7\" stroke-dashoffset=\"141.9\" stroke-linecap=\"round\" stroke=\"currentColor\" fill=\"transparent\" r=\"45\" cx=\"50\" cy=\"50\" opacity=\"0.6\" data-kid=\"40\"></circle>\n                            </svg>\n                            <div class=\"absolute inset-0 flex flex-col items-center justify-center\" data-kid=\"41\">\n                                <span class=\"text-xs font-bold tracking-[0.3em] text-[var(--k-color-text-muted)] uppercase mb-4\" data-kid=\"42\">Wasted Revenue</span>\n                                <span class=\"text-[5.5rem] font-bold font-heading leading-none text-[var(--k-color-accent)] tracking-tighter\" id=\"waste-counter\" data-kid=\"43\">$42.8k</span>\n                                <span class=\"text-sm font-medium text-[var(--k-color-text-secondary)] mt-4\" data-kid=\"44\">Across 4 Networks</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        \n        <section id=\"swimlanes\" class=\"py-32 bg-[var(--k-color-bg-page)]\" data-kid=\"45\">\n            <div class=\"max-w-7xl mx-auto px-6 mb-24 flex items-center justify-between\" data-kid=\"46\">\n                <h2 class=\"text-5xl font-bold font-heading tracking-tight\" data-kid=\"47\">Strategic Fixes</h2>\n                <div class=\"flex gap-4\" data-kid=\"48\">\n                    <button class=\"w-14 h-14 rounded-full border border-[var(--k-color-border)] flex items-center justify-center hover:bg-[var(--k-color-accent)] hover:text-[var(--k-color-bg-page)] transition-all scroll-left\" data-kid=\"49\">\n                        <i data-lucide=\"arrow-left\" class=\"w-6 h-6\" data-kid=\"50\"></i>\n                    </button>\n                    <button class=\"w-14 h-14 rounded-full border border-[var(--k-color-border)] flex items-center justify-center hover:bg-[var(--k-color-accent)] hover:text-[var(--k-color-bg-page)] transition-all scroll-right\" data-kid=\"51\">\n                        <i data-lucide=\"arrow-right\" class=\"w-6 h-6\" data-kid=\"52\"></i>\n                    </button>\n                </div>\n            </div>\n\n            \n            <div class=\"mb-32\" data-kid=\"53\">\n                <div class=\"max-w-7xl mx-auto px-6 mb-12 flex items-center gap-6 group\" data-kid=\"54\">\n                    <span class=\"text-4xl font-bold text-[var(--k-color-border)] group-hover:text-[var(--k-color-accent)] transition-colors duration-500\" data-kid=\"55\">01</span>\n                    <h3 class=\"text-2xl font-bold uppercase tracking-[0.2em] text-[var(--k-color-text-muted)]\" data-kid=\"56\">Google Search Engine</h3>\n                </div>\n                <div class=\"flex gap-8 overflow-x-auto no-scrollbar px-[10%] pb-12 items-start\" id=\"google-carousel\" data-kid=\"57\">\n                    \n                    <div class=\"min-w-[480px] snap-center bg-white/[0.03] p-12 rounded-[3rem] border-l-4 border-[var(--k-color-accent)] group transition-colors hover:bg-white/[0.06]\" data-kid=\"58\">\n                        <div class=\"flex justify-between items-start mb-12\" data-kid=\"59\">\n                            <span class=\"px-4 py-1.5 bg-[var(--k-color-error)] text-white text-[10px] font-bold rounded-lg uppercase tracking-widest shadow-[0_0_20px_var(--k-color-