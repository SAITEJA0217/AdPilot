      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;900&family=Fira+Sans:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-bg: var(--k-color-bg-page);\n    --color-surface: var(--k-color-bg-surface);\n    --color-accent: var(--k-color-accent);\n    --color-text: var(--k-color-text-primary);\n    --color-border: var(--k-color-border);\n    --font-heading: var(--k-font-family-heading);\n    --font-body: var(--k-font-family-body);\n  }\n\n  body {\n    background-color: var(--color-bg);\n    color: var(--color-text);\n    font-family: var(--font-body);\n    margin: 0;\n    overflow-x: clip;\n  }\n\n  /* #noise-grain pattern */\n  .noise-overlay::after {\n    content: \"\";\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    opacity: 0.05;\n    z-index: 9999;\n    background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3%3Ffilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n  }\n\n  .cta-text-outline {\n    -webkit-text-stroke: 2px var(--color-border);\n    transition: -webkit-text-stroke 0.3s, color 0.3s;\n  }\n  \n  .cta-container:hover .cta-text-outline {\n    -webkit-text-stroke: 2px var(--color-accent);\n    color: var(--color-accent);\n  }\n\n  @keyframes marquee {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n  .animate-marquee {\n    animation: marquee 40s linear infinite;\n  }\n\n  .terminal-cursor {\n    display: inline-block;\n    width: 8px;\n    height: 16px;\n    background-color: var(--color-accent);\n    vertical-align: middle;\n    margin-left: 2px;\n  }\n\n  /* #locomotive-reveal-stagger helper */\n  .reveal-item {\n    opacity: 0;\n    transform: translateY(30px);\n  }\n\n  /* Grid Line Drawing Animation Classes */\n  .grid-line-h { transform-origin: left; }\n  .grid-line-v { transform-origin: top; }\n\n  /* Custom Scrollbar for Brutalist feel */\n  ::-webkit-scrollbar { width: 4px; }\n  ::-webkit-scrollbar-track { background: var(--color-bg); }\n  ::-webkit-scrollbar-thumb { background: var(--color-border); }\n  ::-webkit-scrollbar-thumb:hover { background: var(--color-accent); }\n</style>\n\n<div class=\"noise-overlay min-h-screen selection:bg-[var(--k-color-accent)] selection:text-black\" data-kid=\"1\">\n  \n  <nav class=\"fixed top-0 left-0 w-full z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur-md\" data-kid=\"2\">\n    <div class=\"max-w-[1440px] mx-auto flex items-center justify-between px-8 py-4\" data-kid=\"3\">\n      <div class=\"flex items-center gap-2\" data-kid=\"4\">\n        <div class=\"w-8 h-8 bg-[var(--color-accent)] flex items-center justify-center\" data-kid=\"5\">\n          <i class=\"ti ti-adjustments-check text-black text-xl\" data-kid=\"6\"></i>\n        </div>\n        <span class=\"font-[family-name:var(--font-heading)] font-bold text-xl uppercase tracking-tighter\" data-kid=\"7\">AdAudit AI</span>\n      </div>\n      <div class=\"hidden md:flex items-center gap-8 text-xs font-black uppercase tracking-[0.2em] font-[family-name:var(--font-heading)]\" data-kid=\"8\">\n        <a href=\"#\" class=\"hover:text-[var(--color-accent)] transition-colors underline decoration-2 underline-offset-4\" data-kid=\"9\">Terminal_</a>\n        <a href=\"#\" class=\"hover:text-[var(--color-accent)] transition-colors underline decoration-2 underline-offset-4\" data-kid=\"10\">Pricing_</a>\n        <a href=\"#\" class=\"hover:text-[var(--color-accent)] transition-colors underline decoration-2 underline-offset-4\" data-kid=\"11\">Docs_</a>\n      </div>\n      <button class=\"bg-[var(--color-accent)] text-black px-6 py-2 font-bold uppercase text-xs tracking-widest hover:scale-105 active:scale-95 transition-all\" data-kid=\"12\">\n        Login_\n      </button>\n    </div>\n  </nav>\n\n  \n  <section id=\"hero\" class=\"relative min-h-screen pt-20 border-b border-[var(--color-border)] overflow-hidden\" data-kid=\"13\">\n    \n    <div class=\"absolute inset-0 pointer-events-none\" data-kid=\"14\">\n      <div class=\"grid-line-v absolute left-1/4 top-0 w-px h-full bg-[var(--color-border)] opacity-60\" data-kid=\"15\"></div>\n      <div class=\"grid-line-v absolute left-1/2 top-0 w-px h-full bg-[var(--color-border)] opacity-60\" data-kid=\"16\"></div>\n      <div class=\"grid-line-v absolute left-3/4 top-0 w-px h-full bg-[var(--color-border)] opacity-60\" data-kid=\"17\"></div>\n      <div class=\"grid-line-h absolute left-0 top-1/2 w-full h-px bg-[var(--color-border)] opacity-60\" data-kid=\"18\"></div>\n    </div>\n\n    <div class=\"relative z-10 grid grid-cols-1 lg:grid-cols-4 min-h-[calc(100vh-80px)]\" data-kid=\"19\">\n      \n      <div class=\"lg:col-span-3 flex flex-col justify-center px-8 lg:px-20 border-r border-[var(--color-border)]\" data-kid=\"20\">\n        <div class=\"reveal-item\" data-kid=\"21\">\n          <span class=\"text-[var(--color-accent)] font-mono text-sm tracking-[0.3em] uppercase mb-6 block\" data-kid=\"22\">/ / OPTIMIZING_AD_SPEND</span>\n          <h1 class=\"text-6xl md:text-8xl lg:text-[120px] font-[family-name:var(--font-heading)] font-black leading-[0.9] tracking-tighter uppercase mb-8\" data-kid=\"23\">\n            Stop The<br data-kid=\"24\">\n            <span class=\"text-[var(--color-accent)] italic\" data-kid=\"25\">Bleeding.</span><br data-kid=\"26\">\n            Start The Audit.\n          </h1>\n          <p class=\"text-xl md:text-2xl text-[var(--k-color-text-secondary)] max-w-2xl font-light leading-relaxed mb-12\" data-kid=\"27\">\n            AdAudit AI scans your campaign logs for budget leaks, audience overlap, and platform-biased attribution in real-time. Pure profit, zero fluff.\n          </p>\n          <div class=\"flex flex-wrap items-center gap-10\" data-kid=\"28\">\n            <button class=\"bg-[var(--color-accent)] text-black px-12 py-6 text-xl font-black uppercase tracking-tight hover:scale-105 transition-transform cursor-pointer [clip-path:polygon(0%_0%,100%_0%,95%_100%,0%_100%)]\" data-kid=\"29\">\n              Enter Terminal_\n            </button>\n            <a href=\"#\" class=\"text-sm font-bold uppercase tracking-[0.3em] border-b-2 border-white pb-1 hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-all\" data-kid=\"30\">\n              [ Benchmarks ]\n            </a>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"lg:col-span-1 bg-[var(--color-surface)] flex flex-col h-full border-t lg:border-t-0 border-[var(--color-border)] relative\" data-kid=\"31\">\n        <div class=\"p-4 border-b border-[var(--color-border)] flex items-center justify-between bg-[var(--color-bg)]\" data-kid=\"32\">\n          <span class=\"text-xs font-mono text-[var(--color-accent)] font-bold tracking-widest uppercase\" data-kid=\"33\">/ DEV / CONSOLE</span>\n          <span class=\"text-xs font-mono text-[var(--k-color-text-muted)] tracking-widest uppercase\" data-kid=\"34\">SYS: OPTIMAL</span>\n        </div>\n        <div class=\"p-6 font-mono text-xs md:text-sm overflow-hidden flex-1 leading-relaxed\" data-kid=\"35\">\n          <div id=\"terminal-text\" class=\"space-y-3\" data-kid=\"36\">\n            <p class=\"text-[var(--color-accent)] opacity-0\" data-kid=\"37\">bash-5.2$ ./adaudit --scan all</p>\n            <p class=\"text-[var(--k-color-text-muted)]\" data-kid=\"38\">[INFO] Connecting to Meta Ads Manager...</p>\n            <p class=\"text-[var(--k-color-text-muted)]\" data-kid=\"39\">[INFO] Pulling last 24h event logs...</p>\n            <p class=\"text-white\" data-kid=\"40\">Analyzing 14,292 data points...</p>\n            <div class=\"bg-red-500/10 border-l-2 border-red-500 p-2 text-red-400\" data-kid=\"41\">\n              [CRITICAL] Leak found in 'Prospecting_v2'\n              <br data-kid=\"42\">\n              Cause: High frequency cap (8.4)\n            </div>\n            <p class=\"text-green-400 font-bold\" data-kid=\"43\">[SUCCESS] Reallocating $450/day to high-ROI segments.</p>\n            <p class=\"text-[var(--k-color-text-muted)]\" data-kid=\"44\">Optimization complete. 12% ROAS lift projected.</p>\n            <div class=\"flex items-center\" data-kid=\"45\">\n              <span class=\"text-[var(--color-accent)]\" data-kid=\"46\">bash-5.2$</span>\n              <span class=\"terminal-cursor\" data-kid=\"47\"></span>\n            </div>\n          </div>\n        </div>\n        <div class=\"p-4 border-t border-[var(--color-border)] text-[10px] font-mono uppercase tracking-[0.3em] text-[var(--k-color-text-muted)] flex justify-between px-6\" data-kid=\"48\">\n          <span data-kid=\"49\">TX_ID: 0x42...fE9</span>\n          <span data-kid=\"50\">LATENCY: 12ms</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"comparison\" class=\"min-h-screen flex flex-col lg:flex-row border-b border-[var(--color-border)] overflow-hidden\" data-kid=\"51\">\n    \n    <div class=\"flex-1 p-8 lg:p-24 flex flex-col justify-center border-b lg:border-b-0 lg:border-r border-[var(--color-border)] bg-black/10 relative overflow-hidden group\" data-kid=\"52\">\n      <div class=\"absolute top-0 right-0 p-8 text-[120px] font-black opacity-15 select-none pointer-events-none font-[family-name:var(--font-heading)]\" data-kid=\"53\">BEFORE</div>\n      <div class=\"mb-12 reveal-item\" data-kid=\"54\">\n        <span class=\"px-4 py-2 border border-[#FF3131] text-[#FF3131] text-xs font-bold uppercase tracking-[0.25em]\" data-kid=\"55\">Manual Process</span>\n      </div>\n      <h2 class=\"text-4xl lg:text-6xl font-[family-name:var(--font-heading)] font-black uppercase mb-10 leading-none reveal-item\" data-kid=\"56\">\n        Guesswork & <br data-kid=\"57\"><span class=\"text-[#FF3131] italic\" data-kid=\"58\">Vague Reports.</span>\n      </h2>\n      <div class=\"space-y-12\" data-kid=\"59\">\n        <div class=\"flex flex-col gap-4 reveal-item\" data-kid=\"60\">\n          <span class=\"text-[#FF3131] font-mono text-xl\" data-kid=\"61\">01/ LOSS_OF_VISIBILITY</span>\n          <p class=\"text-lg text-[var(--k-color-text-secondary)]\" data-kid=\"62\">Spending 10+ hours a week in Excel trying to map attribution manually across 4 platforms with incomplete CSV datasets.</p>\n        </div>\n        <div class=\"flex flex-col gap-4 reveal-item\" data-kid=\"63\">\n          <span class=\"text-[#FF3131] font-mono text-xl\" data-kid=\"64\">02/ DOUBLE_COUNTING</span>\n          <p class=\"text-lg text-[var(--k-color-text-secondary)]\" data-kid=\"65\">Paying for the same user twice because Meta and Google both claim the last-click credit for a single conversion.</p>\n        </div>\n      </div>\n      \n      <div class=\"absolute bottom-0 left-0 w-full h-40\" data-kid=\"66\">\n        <svg class=\"w-full h-full\" viewBox=\"0 0 1000 200\" data-kid=\"67\">\n          <path id=\"path-bad\" d=\"M0,50 L100,60 L200,40 L300,120 L400,100 L500,160 L600,140 L700,180 L800,170 L1000,195\" fill=\"none\" stroke=\"#FF3131\" stroke-width=\"4\" stroke-dasharray=\"10 5\" data-kid=\"68\"></path>\n        </svg>\n        <div class=\"absolute bottom-4 right-8 flex items-center gap-2 text-[#FF3131] font-bold uppercase text-xs tracking-widest bg-black/80 px-4 py-2 border border-[#FF3131]\" data-kid=\"69\">\n          <i class=\"ti ti-trending-down\" data-kid=\"70\"></i> Profit Decline\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"flex-1 p-8 lg:p-24 flex flex-col justify-center bg-[var(--color-surface)] relative overflow-hidden\" data-kid=\"71\">\n      <div class=\"absolute top-0 right-0 p-8 text-[120px] font-black opacity-15 select-none pointer-events-none font-[family-name:var(--font-heading)]\" data-kid=\"72\">AFTER</div>\n      <div class=\"mb-12 reveal-item\" data-kid=\"73\">\n        <span class=\"px-4 py-2 bg-[var(--color-accent)] text-black text-xs font-bold uppercase tracking-[0.25em]\" data-kid=\"74\">Automated Edge</span>\n      </div>\n      <h2 class=\"text-4xl lg:text-6xl font-[family-name:var(--font-heading)] font-black uppercase mb-10 leading-none reveal-item\" data-kid=\"75\">\n        Data Fidelity & <br data-kid=\"76\"><span class=\"text-[var(--color-accent)]\" data-kid=\"77\">Compound ROAS.</span>\n      </h2>\n      <div class=\"space-y-12\" data-kid=\"78\">\n        <div class=\"flex flex-col gap-4 reveal-item\" data-kid=\"79\">\n          <span class=\"text-[var(--color-accent)] font-mono text-xl\" data-kid=\"80\">01/ UNIFIED_LOG_ANALYSIS</span>\n          <p class=\"text-lg\" data-kid=\"81\">One unified terminal command to audit every dollar. Instant visibility into true incremental revenue across the entire funnel.</p>\n        </div>\n        <div class=\"flex flex-col gap-4 reveal-item\" data-kid=\"82\">\n          <span class=\"text-[var(--color-accent)] font-mono text-xl\" data-kid=\"83\">02/ NEUTRAL_ATTRIBUTION</span>\n          <p class=\"text-lg\" data-kid=\"84\">AI-powered attribution de-duplication that saves an average of 18% in wasted platform overlap by identifying multi-touch paths.</p>\n        </div>\n      </div>\n      \n      <div class=\"absolute bottom-0 left-0 w-full h-40\" data-kid=\"85\">\n        <svg class=\"w-full h-full\" viewBox=\"0 0 1000 200\" data-kid=\"86\">\n          <path id=\"path-good\" d=\"M0,180 L100,160 L200,170 L300,110 L400,130 L500,60 L600,80 L700,20 L800,40 L1000,5\" fill=\"none\" stroke=\"var(--color-accent)\" stroke-width=\"6\" data-kid=\"87\"></path>\n        </svg>\n        <div class=\"absolute bottom-4 right-8 flex items-center gap-2 text-[var(--color-accent)] font-bold uppercase text-xs tracking-widest bg-black/80 px-4 py-2 border border-[var(--color-accent)]\" data-kid=\"88\">\n          <i class=\"ti ti-trending-up\" data-kid=\"89\"></i> Efficiency Surge\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-40 bg-[var(--color-bg)] overflow-hidden\" data-kid=\"90\">\n    <div class=\"max-w-[1440px] mx-auto px-8 mb-20 flex flex-col md:flex-row items-end justify-between gap-8\" data-kid=\"91\">\n      <div class=\"max-w-xl reveal-item\" data-kid=\"92\">\n        <h3 class=\"text-4xl font-[family-name:var(--font-heading)] font-black uppercase mb-6 leading-tight\" data-kid=\"93\">Ready to stop guessing?</h3>\n        <p class=\"text-[var(--k-color-text-secondary)] text-lg\" data-kid=\"94\">Join 400+ data-driven brands using AdAudit to recover their margins. Setup takes less than 5 minutes.</p>\n      </div>\n      <div class=\"text-[var(--k-color-text-muted)] font-mono text-sm uppercase tracking-widest hidden md:block border-l-2 border-[var(--color-border)] pl-8 reveal-item\" data-kid=\"95\">\n        [ SYS_READY: TRUE ] <br data-kid=\"96\">\n        [ AUTH_STATUS: WAITING ]\n      </div>\n    </div>\n\n    <a href=\"#\" class=\"cta-container block border-y-4 border-[var(--color-border)] py-16 relative cursor-pointer overflow-hidden group\" data-kid=\"97\">\n      <div class=\"flex whitespace-nowrap overflow-hidden\" data-kid=\"98\">\n        <div class=\"flex animate-marquee\" data-kid=\"99\">\n          <h2 class=\"text-[120px] md:text-[220px] font-[family-name:var(--font-heading)] font-black uppercase leading-none tracking-tighter text-transparent cta-text-outline pr-32\" data-kid=\"100\">\n            START AUDIT • START AUDIT • START AUDIT • START AUDIT • \n          </h2>\n          <h2 class=\"text-[120px] md:text-[220px] font-[family-name:var(--font-heading)] font-black uppercase leading-none tracking-tighter text-transparent cta-text-outline pr-32\" data-kid=\"101\">\n            START AUDIT • START AUDIT • START AUDIT • START AUDIT • \n          </h2>\n        </div>\n      </div>\n      \n      \n      <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500 scale-90 group-hover:scale-100 transition-transform\" data-kid=\"102\">\n         <div class=\"bg-[var(--color-accent)] text-black px-12 py-8 text-2xl md:text-5xl font-black uppercase transform -rotate-2 shadow-[12px_12px_0_0_rgba(0,0,0,1)]\" data-kid=\"103\">\n           Enter Terminal_\n         </div>\n      </div>\n    </a>\n  </section>\n\n  \n  <footer class=\"bg-[var(--color-surface)] border-t border-[var(--color-border)] py-20 px-8\" data-kid=\"104\">\n    <div class=\"max-w-[1440px] mx-auto grid grid-cols-1 md:grid-cols-4 gap-12\" data-kid=\"105\">\n      <div class=\"md:col-span-2\" data-kid=\"106\">\n        <div class=\"flex items-center gap-2 mb-8\" data-kid=\"107\">\n          <div class=\"w-8 h-8 bg-[var(--color-accent)] flex items-center justify-center\" data-kid=\"108\">\n            <i class=\"ti ti-adjustments-check text-black text-xl\" data-kid=\"109\"></i>\n          </div>\n          <span class=\"font-[family-name:var(--font-heading)] font-bold text-2xl uppercase tracking-tighter\" data-kid=\"110\">AdAudit AI</span>\n        </div>\n        <p class=\"text-[var(--k-color-text-muted)] max-w-sm mb-8 leading-relaxed\" data-kid=\"111\">\n          The brutally honest advertising auditor. Engineered for growth hackers, data scientists, and profit seekers.\n        </p>\n        <div class=\"flex gap-4\" data-kid=\"112\">\n          <a href=\"#\" class=\"w-10 h-10 border border-[var(--color-border)] flex items-center justify-center hover:bg-[var(--color-accent)] hover:text-black transition-colors\" data-kid=\"113\">\n            <i class=\"ti ti-brand-twitter\" data-kid=\"114\"></i>\n          </a>\n          <a href=\"#\" class=\"w-10 h-10 border border-[var(--color-border)] flex items-center justify-center hover:bg-[var(--color-accent)] hover:text-black transition-colors\" data-kid=\"115\">\n            <i class=\"ti ti-brand-linkedin\" data-kid=\"116\"></i>\n          </a>\n          <a href=\"#\" class=\"w-10 h-10 border border-[var(--color-border)] flex items-center justify-center hover:bg-[var(--color-accent)] hover:text-black transition-colors\" data-kid=\"117\">\n            <i class=\"ti ti-brand-github\" data-kid=\"118\"></i>\n          </a>\n        </div>\n      </div>\n      <div data-kid=\"119\">\n        <h4 class=\"font-bold uppercase tracking-widest mb-8 text-sm text-[var(--color-accent)]\" data-kid=\"120\">Terminal</h4>\n        <ul class=\"space-y-4 text-sm uppercase font-medium\" data-kid=\"121\">\n          <li data-kid=\"122\"><a href=\"#\" class=\"hover:text-[var(--color-accent)]\" data-kid=\"123\">Live Scan</a></li>\n          <li data-kid=\"124\"><a href=\"#\" class=\"hover:text-[var(--color-accent)]\" data-kid=\"125\">Benchmarks</a></li>\n          <li data-kid=\"126\"><a href=\"#\" class=\"hover:text-[var(--color-accent)]\" data-kid=\"127\">API Docs</a></li>\n          <li data-kid=\"128\"><a href=\"#\" class=\"hover:text-[var(--color-accent)]\" data-kid=\"129\">Changelog</a></li>\n        </ul>\n      </div>\n      <div data-kid=\"130\">\n        <h4 class=\"font-bold uppercase tracking-widest mb-8 text-sm text-[var(--color-accent)]\" data-kid=\"131\">Company</h4>\n        <ul class=\"space-y-4 text-sm uppercase font-medium\" data-kid=\"132\">\n          <li data-kid=\"133\"><a href=\"#\" class=\"hover:text-[var(--color-accent)]\" data-kid=\"134\">Manifesto</a></li>\n          <li data-kid=\"135\"><a href=\"#\" class=\"hover:text-[var(--color-accent)]\" data-kid=\"136\">Privacy_Policy</a></li>\n          <li data-kid=\"137\"><a href=\"#\" class=\"hover:text-[var(--color-accent)]\" data-kid=\"138\">Terms_Of_Service</a></li>\n          <li data-kid=\"139\"><a href=\"#\" class=\"hover:text-[var(--color-accent)]\" data-kid=\"140\">Contact</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"max-w-[1440px] mx-auto mt-20 pt-8 border-t border-[var(--color-border)] flex flex-col md:flex-row justify-between items-center gap-4 text-[10px] font-mono text-[var(--k-color-text-muted)] uppercase tracking-[0.2em]\" data-kid=\"141\">\n      <span data-kid=\"142\">© 2024 AdAudit AI Inc. Built on first-party data.</span>\n      <span data-kid=\"143\">IP_ADDRESS: 192.168.1.1 // LOC: US-EAST-1</span>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"144\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"145\"></script>\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"146\">\n<script type=\"module\" data-kid=\"147\">\n  import { animate, scroll, inView, stagger } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n  import Lenis from \"https://esm.sh/lenis@1\"\n  import { animate as animeAnimate } from 'https://esm.sh/animejs@4';\n\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Smooth Scroll\n  const lenis = new Lenis();\n  function raf(time) {\n    lenis.raf(time);\n    requestAnimationFrame(raf);\n  }\n  requestAnimationFrame(raf);\n\n  // Batch Reveal Animations using ScrollTrigger\n  ScrollTrigger.batch(\".reveal-item\", {\n    onEnter: (elements) => {\n      gsap.to(elements, {\n        opacity: 1,\n        y: 0,\n        stagger: 0.15,\n        duration: 0.8,\n        ease: \"power3.out\",\n        overwrite: true\n      });\n    },\n    start: \"top 90%\"\n  });\n\n  // Hero Grid Entrance\n  gsap.from(\".grid-line-v\", {\n    scaleY: 0,\n    duration: 1.5,\n    stagger: 0.1,\n    ease: \"power4.out\",\n    delay: 0.2\n  });\n  gsap.from(\".grid-line-h\", {\n    scaleX: 0,\n    duration: 1.5,\n    ease: \"power4.out\",\n    delay: 0.5\n  });\n\n  // Path Drawing for Comparison Charts using ScrollTrigger\n  gsap.set([\"#path-bad\", \"#path-good\"], { strokeDasharray: 1000, strokeDashoffset: 1000 });\n  \n  ScrollTrigger.create({\n    trigger: \"#comparison\",\n    start: \"top 60%\",\n    onEnter: () => {\n      gsap.to([\"#path-bad\", \"#path-good\"], {\n        strokeDashoffset: 0,\n        duration: 2.5,\n        ease: \"power2.inOut\"\n      });\n    }\n  });\n\n  // Terminal Cursor Animation (Anime.js)\n  animeAnimate({\n    targets: '.terminal-cursor',\n    opacity: [1, 0],\n    duration: 600,\n    direction: 'alternate',\n    loop: true,\n    easing: 'steps(1)'\n  });\n\n  // Typewriter effect (#anime-text-typewriter concept)\n  const terminalRows = document.querySelectorAll(\"#terminal-text > p, #terminal-text > div\");\n  terminalRows.forEach((row, i) => {\n    animeAnimate({\n      targets: row,\n      opacity: [0, 1],\n      translateX: [-10, 0],\n      easing: 'easeOutExpo',\n      duration: 300,\n      delay: 500 + (i * 250)\n    });\n  });\n\n  // Color Sweep Hover (#motion-hover-color-sweep)\n  const cta = document.querySelector(\".cta-container\");\n  cta.addEventListener(\"mouseenter\", () => {\n    animate(cta, { backgroundColor: \"rgba(227, 255, 0, 0.08)\" }, { duration: 0.3 });\n  });\n  cta.addEventListener(\"mouseleave\", () => {\n    animate(cta, { backgroundColor: \"rgba(227, 255, 0, 0)\" }, { duration: 0.3 });\n  });\n\n</script>\n",
