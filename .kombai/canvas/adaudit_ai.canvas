      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n        --k-color-primary: #DF00FF;\n        --k-color-bg-page: #100C08;\n    }\n\n    body {\n        margin: 0;\n        padding: 0;\n        background-color: var(--k-color-bg-page);\n        color: #F5F5F5;\n        font-family: 'DM Sans', sans-serif;\n        overflow-x: clip;\n    }\n\n    h1, h2, h3, h4, .font-heading {\n        font-family: 'Syne', sans-serif;\n    }\n\n    .glass {\n        background: rgba(26, 23, 26, 0.6);\n        backdrop-filter: blur(12px);\n        border: 1px solid rgba(45, 42, 45, 0.5);\n    }\n\n    .neon-glow {\n        box-shadow: 0 0 20px rgba(223, 0, 255, 0.2);\n    }\n\n    .neon-text-glow {\n        text-shadow: 0 0 15px rgba(223, 0, 255, 0.4);\n    }\n\n    /* Custom Scrollbar for a cleaner look */\n    ::-webkit-scrollbar {\n        width: 8px;\n    }\n    ::-webkit-scrollbar-track {\n        background: #100C08;\n    }\n    ::-webkit-scrollbar-thumb {\n        background: #2D2A2D;\n        border-radius: 4px;\n    }\n    ::-webkit-scrollbar-thumb:hover {\n        background: #3F3C3F;\n    }\n\n    /* Selection Color */\n    ::selection {\n        background: rgba(223, 0, 255, 0.3);\n        color: white;\n    }\n\n    /* Noise Grain Pattern */\n    .noise::before {\n        content: \"\";\n        position: fixed;\n        inset: 0;\n        z-index: 9999;\n        pointer-events: none;\n        opacity: 0.03;\n        background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n    }\n</style>\n\n<div class=\"noise\" data-scroll-container data-kid=\"1\">\n    \n    <nav class=\"fixed top-0 left-0 right-0 z-50 px-6 py-6 transition-all duration-300\" data-kid=\"2\">\n        <div class=\"max-w-7xl mx-auto flex items-center justify-between glass px-6 py-3 rounded-2xl border border-[#2D2A2D]/50\" data-kid=\"3\">\n            <div class=\"flex items-center gap-2\" data-kid=\"4\">\n                <div class=\"w-8 h-8 bg-[#DF00FF] rounded-lg flex items-center justify-center shadow-[0_0_15px_rgba(223,0,255,0.4)]\" data-kid=\"5\">\n                    <i class=\"ti ti-chart-dots-3 text-black text-xl\" data-kid=\"6\"></i>\n                </div>\n                <span class=\"text-xl font-bold tracking-tight font-['Inter']\" data-kid=\"7\">AdAudit AI</span>\n            </div>\n            \n            <div class=\"hidden md:flex items-center gap-8\" data-kid=\"8\">\n                <a href=\"#\" class=\"text-sm font-medium text-[#8A8A8A] hover:text-[#F5F5F5] transition-colors\" data-kid=\"9\">Features</a>\n                <a href=\"#\" class=\"text-sm font-medium text-[#8A8A8A] hover:text-[#F5F5F5] transition-colors\" data-kid=\"10\">How it works</a>\n                <a href=\"#\" class=\"text-sm font-medium text-[#8A8A8A] hover:text-[#F5F5F5] transition-colors\" data-kid=\"11\">Pricing</a>\n            </div>\n\n            <div class=\"flex items-center gap-4\" data-kid=\"12\">\n                <button class=\"text-sm font-medium text-[#8A8A8A] hover:text-[#F5F5F5] transition-colors\" data-kid=\"13\">Login</button>\n                <button class=\"px-5 py-2 bg-[#DF00FF] text-black font-bold text-sm rounded-lg hover:bg-[#FF33FF] transition-all hover:scale-105 active:scale-95 shadow-[0_0_15px_rgba(223,0,255,0.2)]\" data-kid=\"14\">\n                    Get Started\n                </button>\n            </div>\n        </div>\n    </nav>\n\n    \n    \n        \n        <div class=\"absolute inset-0 pointer-events-none\" data-kid=\"15\">\n            <div class=\"absolute -top-40 -left-20 w-[600px] h-[600px] bg-[#DF00FF]/10 blur-[150px] rounded-full\" data-kid=\"16\"></div>\n            <div class=\"absolute top-0 right-0 w-full h-[100%] bg-[radial-gradient(circle_at_70%_0%,rgba(223,0,255,0.08),transparent_60%)]\" data-kid=\"17\"></div>\n        </div>\n\n        <div class=\"max-w-7xl w-full grid grid-cols-1 lg:grid-cols-2 gap-24 items-center relative z-10\" data-kid=\"18\">\n            <div class=\"text-left\" data-scroll data-scroll-speed=\"-0.08\" data-kid=\"19\">\n                <h1 class=\"text-7xl md:text-[7rem] font-extrabold tracking-tighter mb-10 leading-[0.85] font-heading\" id=\"hero-title\" data-kid=\"20\">\n                    Waste <br data-kid=\"21\"> \n                    <span class=\"text-[#DF00FF] neon-text-glow\" data-kid=\"22\">Less.</span> <br data-kid=\"23\">\n                    Grow <br data-kid=\"24\">\n                    <span class=\"text-[#F5F5F5] opacity-50\" data-kid=\"25\">Faster.</span>\n                </h1>\n                <p class=\"text-[#8A8A8A] text-xl md:text-2xl max-w-xl mb-12 leading-relaxed\" id=\"hero-subtext\" data-kid=\"26\">\n                    Audit your campaign CSVs in seconds. Stop burning spend on duplicate bids and low-ROAS placements.\n                </p>\n                <div class=\"flex flex-col sm:flex-row gap-6\" id=\"hero-ctas\" data-kid=\"27\">\n                    <button class=\"px-12 py-6 bg-[#DF00FF] text-black font-extrabold rounded-2xl hover:bg-[#FF33FF] transition-all hover:shadow-[0_0_40px_rgba(223,0,255,0.4)] flex items-center justify-center gap-3 text-xl hover:scale-105\" data-kid=\"28\">\n                        <i class=\"ti ti-cloud-upload\" data-kid=\"29\"></i>\n                        Analyze Now\n                    </button>\n                    <button class=\"px-12 py-6 bg-white/5 backdrop-blur-md text-[#F5F5F5] font-bold rounded-2xl border border-white/10 hover:bg-white/10 transition-all text-xl\" data-kid=\"30\">\n                        View Demo\n                    </button>\n                </div>\n            </div>\n\n            \n            <div class=\"relative w-full browser-mockup hidden lg:block\" data-scroll data-scroll-speed=\"0.05\" data-kid=\"31\">\n                <div class=\"rounded-3xl border border-[#2D2A2D] bg-[#1A171A] shadow-[0_40px_120px_rgba(0,0,0,0.9)] overflow-hidden\" data-kid=\"32\">\n                    \n                    <div class=\"flex h-[550px]\" data-kid=\"33\">\n                    \n                    <div class=\"w-16 border-r border-[#2D2A2D] bg-[#1A171A] flex flex-col items-center py-8 gap-8\" data-kid=\"34\">\n                        <div class=\"w-8 h-8 rounded-lg bg-[#2D2A2D] flex items-center justify-center text-[#8A8A8A]\" data-kid=\"35\">\n                            <i class=\"ti ti-layout-dashboard\" data-kid=\"36\"></i>\n                        </div>\n                        <div class=\"w-8 h-8 rounded-lg bg-transparent flex items-center justify-center text-[#3F3C3F]\" data-kid=\"37\">\n                            <i class=\"ti ti-chart-bar\" data-kid=\"38\"></i>\n                        </div>\n                        <div class=\"w-8 h-8 rounded-lg bg-transparent flex items-center justify-center text-[#3F3C3F]\" data-kid=\"39\">\n                            <i class=\"ti ti-settings\" data-kid=\"40\"></i>\n                        </div>\n                    </div>\n                    \n                    \n                    <div class=\"flex-1 bg-[#100C08] p-8 overflow-hidden relative\" data-kid=\"41\">\n                        <div class=\"grid grid-cols-3 gap-6 mb-10\" data-kid=\"42\">\n                            <div class=\"p-6 rounded-2xl bg-[#1A171A] border border-[#2D2A2D]\" data-kid=\"43\">\n                                <div class=\"flex justify-between items-start mb-4\" data-kid=\"44\">\n                                    <span class=\"text-xs text-[#8A8A8A] uppercase font-bold tracking-widest\" data-kid=\"45\">Wasted Spend</span>\n                                    <i class=\"ti ti-trending-up text-[#FF003D]\" data-kid=\"46\"></i>\n                                </div>\n                                <div class=\"text-3xl font-bold font-['Inter'] mb-1\" data-kid=\"47\">$14,203.40</div>\n                                <div class=\"text-xs text-[#FF003D]\" data-kid=\"48\">+12.4% from last month</div>\n                            </div>\n                            <div class=\"p-6 rounded-2xl bg-[#1A171A] border border-[#2D2A2D]\" data-kid=\"49\">\n                                <div class=\"flex justify-between items-start mb-4\" data-kid=\"50\">\n                                    <span class=\"text-xs text-[#8A8A8A] uppercase font-bold tracking-widest\" data-kid=\"51\">ROAS Impact</span>\n                                    <i class=\"ti ti-bolt text-[#00FF94]\" data-kid=\"52\"></i>\n                                </div>\n                                <div class=\"text-3xl font-bold font-['Inter'] mb-1\" data-kid=\"53\">2.4x</div>\n                                <div class=\"text-xs text-[#00FF94]\" data-kid=\"54\">Potential improvement</div>\n                            </div>\n                            <div class=\"p-6 rounded-2xl bg-[#1A171A] border border-[#2D2A2D]\" data-kid=\"55\">\n                                <div class=\"flex justify-between items-start mb-4\" data-kid=\"56\">\n                                    <span class=\"text-xs text-[#8A8A8A] uppercase font-bold tracking-widest\" data-kid=\"57\">Health Score</span>\n                                    <i class=\"ti ti-shield-check text-[#DF00FF]\" data-kid=\"58\"></i>\n                                </div>\n                                <div class=\"text-3xl font-bold font-['Inter'] mb-1\" data-kid=\"59\">72/100</div>\n                                <div class=\"text-xs text-[#8A8A8A]\" data-kid=\"60\">Moderate risk detected</div>\n                            </div>\n                        </div>\n\n                        \n                        <div class=\"rounded-3xl border border-[#2D2A2D] bg-[#1A171A] p-8 h-80 relative group\" data-kid=\"61\">\n                            <div class=\"flex items-center justify-between mb-8\" data-kid=\"62\">\n                                <h4 class=\"font-bold text-sm text-[#8A8A8A] uppercase tracking-widest\" data-kid=\"63\">Efficiency Waveform</h4>\n                                <div class=\"flex gap-2\" data-kid=\"64\">\n                                    <div class=\"w-4 h-4 rounded-full bg-[#DF00FF]/20 flex items-center justify-center text-[10px] text-[#DF00FF]\" data-kid=\"65\"><i class=\"ti ti-maximize\" data-kid=\"66\"></i></div>\n                                </div>\n                            </div>\n                            <div class=\"relative h-48 w-full overflow-hidden rounded-2xl\" data-kid=\"67\">\n                                \n                                <div class=\"absolute inset-0 grid grid-rows-4 pointer-events-none\" data-kid=\"68\">\n                                    <div class=\"border-b border-white/5\" data-kid=\"69\"></div>\n                                    <div class=\"border-b border-white/5\" data-kid=\"70\"></div>\n                                    <div class=\"border-b border-white/5\" data-kid=\"71\"></div>\n                                    <div class=\"border-b border-white/5\" data-kid=\"72\"></div>\n                                </div>\n                                <svg class=\"w-full h-full relative z-10\" viewBox=\"0 0 1000 200\" preserveAspectRatio=\"none\" data-kid=\"73\">\n                                    <defs data-kid=\"74\">\n                                        <linearGradient id=\"mainGradient\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\" data-kid=\"75\">\n                                            <stop offset=\"0%\" stop-color=\"#DF00FF\" stop-opacity=\"0.3\" data-kid=\"76\"></stop>\n                                            <stop offset=\"100%\" stop-color=\"#DF00FF\" stop-opacity=\"0\" data-kid=\"77\"></stop>\n                                        </linearGradient>\n                                    </defs>\n                                    <path d=\"M0,180 C100,160 150,40 250,70 C350,100 450,20 600,60 C750,100 850,20 1000,40 L1000,200 L0,200 Z\" fill=\"url(#mainGradient)\" data-kid=\"78\"></path>\n                                    <path d=\"M0,180 C100,160 150,40 250,70 C350,100 450,20 600,60 C750,100 850,20 1000,40\" fill=\"none\" stroke=\"#DF00FF\" stroke-width=\"5\" stroke-linecap=\"round\" data-kid=\"79\"></path>\n                                    \n                                    <circle cx=\"250\" cy=\"70\" r=\"5\" fill=\"#DF00FF\" stroke=\"white\" stroke-width=\"2\" data-kid=\"80\"></circle>\n                                    <circle cx=\"600\" cy=\"60\" r=\"5\" fill=\"#DF00FF\" stroke=\"white\" stroke-width=\"2\" data-kid=\"81\"></circle>\n                                </svg>\n                                \n                                \n                                <div class=\"absolute left-1/4 top-1/2 -translate-y-1/2 glass p-5 rounded-2xl border border-[#DF00FF]/40 shadow-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-20\" data-kid=\"82\">\n                                    <div class=\"text-xs font-bold text-[#DF00FF] mb-1\" data-kid=\"83\">Wasted Spend Spike</div>\n                                    <div class=\"text-lg font-bold\" data-kid=\"84\">$1,240.00</div>\n                                    <div class=\"text-[10px] text-[#8A8A8A]\" data-kid=\"85\">Oct 12 - Meta Ads</div>\n                                </div>\n                            </div>\n                        </div>\n\n                        \n                        <div class=\"absolute -right-10 top-1/4 transform p-6 glass border border-[#DF00FF]/40 rounded-2xl w-72 shadow-2xl z-20\" data-scroll data-scroll-speed=\"0.2\" data-kid=\"86\">\n                            <div class=\"flex gap-4 items-start\" data-kid=\"87\">\n                                <div class=\"shrink-0 w-10 h-10 rounded-full bg-[#DF00FF]/10 flex items-center justify-center text-[#DF00FF]\" data-kid=\"88\">\n                                    <i class=\"ti ti-bulb text-xl\" data-kid=\"89\"></i>\n                                </div>\n                                <div data-kid=\"90\">\n                                    <h5 class=\"font-bold text-sm mb-1\" data-kid=\"91\">AI Recommendation</h5>\n                                    <p class=\"text-xs text-[#8A8A8A] leading-relaxed\" data-kid=\"92\">\"enterprise crm\" is being bid on in 3 overlapping campaigns. Pause 2 to save $430/mo.</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    \n\n    \n    <section class=\"py-32 bg-[#100C08] px-6 relative overflow-hidden\" id=\"how-it-works\" data-kid=\"93\">\n        <div class=\"max-w-6xl mx-auto\" data-kid=\"94\">\n            <div class=\"text-left mb-24 md:pl-20\" data-kid=\"95\">\n                <h2 class=\"text-5xl md:text-6xl font-extrabold mb-8 font-heading\" data-kid=\"96\">How it Works.</h2>\n                <p class=\"text-[#8A8A8A] text-xl max-w-2xl\" data-kid=\"97\">From CSV export to high-impact growth decisions in three simple steps.</p>\n            </div>\n\n            <div class=\"relative\" data-kid=\"98\">\n                \n                <div class=\"absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-[#DF00FF]/50 via-[#2D2A2D] to-transparent transform -translate-x-1/2 hidden md:block\" data-kid=\"99\"></div>\n                \n                \n                <div class=\"relative flex flex-col md:flex-row items-center justify-between mb-24 md:mb-32 step-container\" data-kid=\"100\">\n                    <div class=\"w-full md:w-[42%] text-center md:text-right md:pr-12 step-item-content\" data-kid=\"101\">\n                        <div class=\"inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-[#1A171A] border border-[#2D2A2D] text-[#DF00FF] mb-8 shadow-[0_10px_30px_rgba(0,0,0,0.5)]\" data-kid=\"102\">\n                            <i class=\"ti ti-cloud-upload text-4xl\" data-kid=\"103\"></i>\n                        </div>\n                        <h3 class=\"text-3xl font-bold mb-5 font-heading\" data-kid=\"104\">Export your data</h3>\n                        <p class=\"text-[#8A8A8A] text-lg leading-relaxed\" data-kid=\"105\">No complex API keys or developer hours needed. Simply export campaign CSVs from Google Ads or Meta Suite and drop them in.</p>\n                    </div>\n                    <div class=\"absolute left-1/2 w-5 h-5 rounded-full bg-[#DF00FF] border-4 border-[#100C08] transform -translate-x-1/2 shadow-[0_0_20px_#DF00FF] hidden md:block\" data-kid=\"106\"></div>\n                    <div class=\"w-full md:w-[42%] mt-12 md:mt-0\" data-kid=\"107\">\n                        <div class=\"p-8 rounded-3xl glass border border-white/5 step-item-glass transform hover:rotate-2\" data-kid=\"108\">\n                             <div class=\"flex items-center gap-4 mb-6\" data-kid=\"109\">\n                                <div class=\"w-10 h-10 rounded-lg bg-[#2D2A2D] flex items-center justify-center\" data-kid=\"110\">\n                                    <i class=\"ti ti-file-type-csv text-[#8A8A8A]\" data-kid=\"111\"></i>\n                                </div>\n                                <span class=\"font-bold text-sm\" data-kid=\"112\">campaign_data_oct.csv</span>\n                             </div>\n                             <div class=\"h-2 w-full bg-[#2D2A2D] rounded-full overflow-hidden mb-2\" data-kid=\"113\">\n                                <div class=\"h-full bg-[#DF00FF] w-full\" data-kid=\"114\"></div>\n                             </div>\n                             <div class=\"text-[10px] text-[#8A8A8A] text-right\" data-kid=\"115\">Upload complete • 4.2 MB</div>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"relative flex flex-col md:flex-row-reverse items-center justify-between mb-24 md:mb-32 step-container\" data-kid=\"116\">\n                    <div class=\"w-full md:w-[42%] text-center md:text-left md:pl-12 step-item-content\" data-kid=\"117\">\n                        <div class=\"inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-[#1A171A] border border-[#2D2A2D] text-[#DF00FF] mb-8 shadow-[0_10px_30px_rgba(0,0,0,0.5)]\" data-kid=\"118\">\n                            <i class=\"ti ti-cpu text-4xl\" data-kid=\"119\"></i>\n                        </div>\n                        <h3 class=\"text-3xl font-bold mb-5 font-heading\" data-kid=\"120\">AI-Powered Audit</h3>\n                        <p class=\"text-[#8A8A8A] text-lg leading-relaxed\" data-kid=\"121\">Our neural engine analyzes cross-platform bidding patterns to identify overlaps, wasted spend, and low-performing keywords in seconds.</p>\n                    </div>\n                    <div class=\"absolute left-1/2 w-5 h-5 rounded-full bg-[#DF00FF] border-4 border-[#100C08] transform -translate-x-1/2 shadow-[0_0_20px_#DF00FF] hidden md:block\" data-kid=\"122\"></div>\n                    <div class=\"w-full md:w-[42%] mt-12 md:mt-0\" data-kid=\"123\">\n                        <div class=\"p-8 rounded-3xl glass border border-white/5 step-item-glass transform hover:-rotate-2\" data-kid=\"124\">\n                             <div class=\"space-y-4\" data-kid=\"125\">\n                                <div class=\"flex items-center justify-between\" data-kid=\"126\">\n                                    <span class=\"text-xs text-[#8A8A8A]\" data-kid=\"127\">Processing nodes...</span>\n                                    <span class=\"text-xs text-[#00FF94]\" data-kid=\"128\">ACTIVE</span>\n                                </div>\n                                <div class=\"grid grid-cols-5 gap-2\" data-kid=\"129\">\n                                    <div class=\"h-10 rounded bg-[#2D2A2D] animate-pulse\" data-kid=\"130\"></div>\n                                    <div class=\"h-10 rounded bg-[#DF00FF]/20 animate-pulse delay-75\" data-kid=\"131\"></div>\n                                    <div class=\"h-10 rounded bg-[#2D2A2D] animate-pulse delay-150\" data-kid=\"132\"></div>\n                                    <div class=\"h-10 rounded bg-[#DF00FF]/40 animate-pulse delay-300\" data-kid=\"133\"></div>\n                                    <div class=\"h-10 rounded bg-[#2D2A2D] animate-pulse delay-500\" data-kid=\"134\"></div>\n                                </div>\n                             </div>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"relative flex flex-col md:flex-row items-center justify-between step-container\" data-kid=\"135\">\n                    <div class=\"w-full md:w-[42%] text-center md:text-right md:pr-12 step-item-content\" data-kid=\"136\">\n                        <div class=\"inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-[#1A171A] border border-[#2D2A2D] text-[#DF00FF] mb-8 shadow-[0_10px_30px_rgba(0,0,0,0.5)]\" data-kid=\"137\">\n                            <i class=\"ti ti-list-check text-4xl\" data-kid=\"138\"></i>\n                        </div>\n                        <h3 class=\"text-3xl font-bold mb-5 font-heading\" data-kid=\"139\">Get Action Items</h3>\n                        <p class=\"text-[#8A8A8A] text-lg leading-relaxed\" data-kid=\"140\">Receive a clear, prioritized list of optimizations. One click to see exactly what to pause, bid down, or scale up.</p>\n                    </div>\n                    <div class=\"absolute left-1/2 w-5 h-5 rounded-full bg-[#DF00FF] border-4 border-[#100C08] transform -translate-x-1/2 shadow-[0_0_20px_#DF00FF] hidden md:block\" data-kid=\"141\"></div>\n                    <div class=\"w-full md:w-[42%] mt-12 md:mt-0\" data-kid=\"142\">\n                        <div class=\"p-8 rounded-3xl glass border border-white/5 step-item-glass transform hover:rotate-2\" data-kid=\"143\">\n                             <div class=\"space-y-3\" data-kid=\"144\">\n                                <div class=\"flex items-center gap-3 p-3 rounded-xl bg-[#2D2A2D]/30 border border-[#2D2A2D]\" data-kid=\"145\">\n                                    <div class=\"w-6 h-6 rounded bg-[#FF003D]/20 border border-[#FF003D]/40 flex items-center justify-center\" data-kid=\"146\">\n                                        <i class=\"ti ti-x text-[10px] text-[#FF003D]\" data-kid=\"147\"></i>\n                                    </div>\n                                    <span class=\"text-xs font-medium\" data-kid=\"148\">Pause \"cheap software\"</span>\n                                </div>\n                                <div class=\"flex items-center gap-3 p-3 rounded-xl bg-[#2D2A2D]/30 border border-[#2D2A2D]\" data-kid=\"149\">\n                                    <div class=\"w-6 h-6 rounded bg-[#00FF94]/20 border border-[#00FF94]/40 flex items-center justify-center\" data-kid=\"150\">\n                                        <i class=\"ti ti-arrow-up text-[10px] text-[#00FF94]\" data-kid=\"151\"></i>\n                                    </div>\n                                    <span class=\"text-xs font-medium\" data-kid=\"152\">Scale \"best audit tool\" +15%</span>\n                                </div>\n                             </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-32 bg-[#100C08] px-6\" id=\"product-peek\" data-kid=\"153\">\n        <div class=\"max-w-6xl mx-auto text-left mb-24 md:pl-20\" data-kid=\"154\">\n            <h2 class=\"text-5xl md:text-6xl font-extrabold mb-8 font-heading\" data-kid=\"155\">Insights that scale.</h2>\n            <p class=\"text-[#8A8A8A] text-xl max-w-2xl leading-relaxed\" data-kid=\"156\">\n                Our recommendation engine finds the signal in the noise across all your networks.\n            </p>\n        </div>\n\n        <div class=\"relative max-w-6xl mx-auto\" data-kid=\"157\">\n            \n            <div class=\"rounded-[40px] border border-[#2D2A2D] bg-[#1A171A]/40 backdrop-blur-3xl p-10 md:p-16 overflow-hidden relative\" data-kid=\"158\">\n                \n                <div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-2/3 h-px bg-gradient-to-r from-transparent via-[#DF00FF]/60 to-transparent\" data-kid=\"159\"></div>\n                \n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-10\" id=\"peek-cards\" data-kid=\"160\">\n                    <div class=\"peek-card p-10 rounded-[32px] bg-[#242124]/50 border border-white/5 relative overflow-hidden group\" data-kid=\"161\">\n                        <div class=\"absolute top-0 left-0 w-1.5 h-full bg-[#FF003D]\" data-kid=\"162\"></div>\n                        <div class=\"flex flex-col h-full\" data-kid=\"163\">\n                            <div class=\"flex justify-between items-start mb-10\" data-kid=\"164\">\n                                <span class=\"px-3 py-1.5 rounded-full bg-[#FF003D]/10 text-[10px] font-black text-[#FF003D] uppercase tracking-widest\" data-kid=\"165\">High Priority</span>\n                                <i class=\"ti ti-flame text-2xl text-[#FF003D]\" data-kid=\"166\"></i>\n                            </div>\n                            <h4 class=\"text-3xl font-extrabold mb-5 font-heading\" data-kid=\"167\">Wasted Spend</h4>\n                            <p class=\"text-[#8A8A8A] text-lg leading-relaxed mb-8\" data-kid=\"168\">Keyword \"business software\" is costing $4.5k/mo with 0.1% conversion.</p>\n                            <div class=\"mt-auto pt-8 border-t border-white/5 flex items-center justify-between\" data-kid=\"169\">\n                                <span class=\"text-[#FF003D] font-bold\" data-kid=\"170\">-$4,520.00 / mo</span>\n                                <button class=\"text-xs font-bold text-white/40 hover:text-white transition-colors\" data-kid=\"171\">FIX NOW</button>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    <div class=\"peek-card p-10 rounded-[32px] bg-[#242124]/50 border border-white/5 relative overflow-hidden group\" data-kid=\"172\">\n                        <div class=\"absolute top-0 left-0 w-1.5 h-full bg-[#FFB800]\" data-kid=\"173\"></div>\n                        <div class=\"flex flex-col h-full\" data-kid=\"174\">\n                            <div class=\"flex justify-between items-start mb-10\" data-kid=\"175\">\n                                <span class=\"px-3 py-1.5 rounded-full bg-[#FFB800]/10 text-[10px] font-black text-[#FFB800] uppercase tracking-widest\" data-kid=\"176\">Overlaps</span>\n                                <i class=\"ti ti-copy text-2xl text-[#FFB800]\" data-kid=\"177\"></i>\n                            </div>\n                            <h4 class=\"text-3xl font-extrabold mb-5 font-heading\" data-kid=\"178\">Bid Conflict</h4>\n                            <div class=\"flex gap-2 mb-6\" data-kid=\"179\">\n                                <div class=\"px-3 py-1 bg-white/5 rounded-lg border border-white/10 text-xs text-[#8A8A8A]\" data-kid=\"180\">Google Ads</div>\n                                <div class=\"px-3 py-1 bg-white/5 rounded-lg border border-white/10 text-xs text-[#8A8A8A]\" data-kid=\"181\">Meta Ads</div>\n                            </div>\n                            <p class=\"text-[#8A8A8A] text-lg leading-relaxed\" data-kid=\"182\">\"SaaS Audit\" is being bid on simultaneously for the same audience.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"peek-card p-10 rounded-[32px] bg-[#242124]/50 border border-white/5 relative overflow-hidden group\" data-kid=\"183\">\n                        <div class=\"absolute top-0 left-0 w-1.5 h-full bg-[#00FF94]\" data-kid=\"184\"></div>\n                        <div class=\"flex flex-col h-full\" data-kid=\"185\">\n                            <div class=\"flex justify-between items-start mb-10\" data-kid=\"186\">\n                                <span class=\"px-3 py-1.5 rounded-full bg-[#00FF94]/10 text-[10px] font-black text-[#00FF94] uppercase tracking-widest\" data-kid=\"187\">Scale</span>\n                                <i class=\"ti ti-rocket text-2xl text-[#00FF94]\" data-kid=\"188\"></i>\n                            </div>\n                            <h4 class=\"text-3xl font-extrabold mb-5 font-heading\" data-kid=\"189\">ROAS Winner</h4>\n                            <div class=\"h-12 w-full bg-white/5 rounded-xl mb-6 overflow-hidden flex items-end px-4 gap-1\" data-kid=\"190\">\n                                <div class=\"w-full bg-[#00FF94]/20 h-1/2 rounded-t\" data-kid=\"191\"></div>\n                                <div class=\"w-full bg-[#00FF94]/40 h-2/3 rounded-t\" data-kid=\"192\"></div>\n                                <div class=\"w-full bg-[#00FF94]/60 h-full rounded-t\" data-kid=\"193\"></div>\n                                <div class=\"w-full bg-[#00FF94]/40 h-3/4 rounded-t\" data-kid=\"194\"></div>\n                            </div>\n                            <p class=\"text-[#8A8A8A] text-lg leading-relaxed\" data-kid=\"195\">\"Retargeting_Q4\" has 12x ROAS but is hitting budget cap early.</p>\n                        </div>\n                    </div>\n\n                    <div class=\"peek-card p-10 rounded-[32px] bg-[#242124]/50 border border-white/5 relative overflow-hidden group\" data-kid=\"196\">\n                        <div class=\"absolute top-0 left-0 w-1.5 h-full bg-[#DF00FF]\" data-kid=\"197\"></div>\n                        <div class=\"flex flex-col h-full\" data-kid=\"198\">\n                            <div class=\"flex justify-between items-start mb-10\" data-kid=\"199\">\n                                <span class=\"px-3 py-1.5 rounded-full bg-[#DF00FF]/10 text-[10px] font-black text-[#DF00FF] uppercase tracking-widest\" data-kid=\"200\">Alert</span>\n                                <i class=\"ti ti-eye-off text-2xl text-[#DF00FF]\" data-kid=\"201\"></i>\n                            </div>\n                            <h4 class=\"text-3xl font-extrabold mb-5 font-heading\" data-kid=\"202\">Ad Fatigue</h4>\n                            <p class=\"text-[#8A8A8A] text-lg leading-relaxed mb-6\" data-kid=\"203\">Video ad CTR has dropped 40% in 14 days. Fresh creative suggested.</p>\n                            <div class=\"mt-auto flex items-center gap-4\" data-kid=\"204\">\n                                <div class=\"w-12 h-12 rounded-xl bg-white/5 border border-white/10\" data-kid=\"205\"></div>\n                                <div class=\"w-12 h-12 rounded-xl bg-white/5 border border-white/10 opacity-50\" data-kid=\"206\"></div>\n                                <div class=\"w-12 h-12 rounded-xl bg-white/5 border border-white/10 opacity-25\" data-kid=\"207\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                \n                <div class=\"absolute bottom-0 left-0 right-0 h-64 bg-gradient-to-t from-[#100C08] to-transparent pointer-events-none z-10\" data-kid=\"208\"></div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"py-32 bg-[#100C08] px-6 text-center relative overflow-hidden\" data-kid=\"209\">\n        <div class=\"absolute inset-0 pointer-events-none\" data-kid=\"210\">\n            <div class=\"absolute bottom-0 left-1/2 -translate-x-1/2 w-full h-[500px] bg-[radial-gradient(circle_at_50%_100%,rgba(223,0,255,0.1),transparent_70%)] opacity-30\" data-kid=\"211\"></div>\n        </div>\n        \n        <div class=\"max-w-4xl mx-auto relative z-10\" data-kid=\"212\">\n            <h2 class=\"text-6xl md:text-8xl font-black mb-12 font-heading tracking-tighter\" data-kid=\"213\">Save your <br data-kid=\"214\"><span class=\"text-[#DF00FF] neon-text-glow\" data-kid=\"215\">Growth.</span></h2>\n            <p class=\"text-[#8A8A8A] text-xl md:text-2xl mb-16 max-w-2xl mx-auto\" data-kid=\"216\">Join 400+ marketing teams auditing over $20M in monthly ad spend.</p>\n            <div class=\"flex flex-col sm:flex-row justify-center gap-8\" data-kid=\"217\">\n                 <button class=\"px-16 py-8 bg-[#DF00FF] text-black font-black rounded-3xl hover:bg-[#FF33FF] transition-all hover:shadow-[0_0_60px_rgba(223,0,255,0.5)] text-2xl hover:scale-105 active:scale-95\" data-kid=\"218\">\n                    Audit for Free\n                </button>\n            </div>\n            <p class=\"text-[#8A8A8A] text-sm mt-12 opacity-50 uppercase tracking-widest font-bold\" data-kid=\"219\">No credit card • GDPR Compliant • 100% Private</p>\n        </div>\n    </section>\n\n    \n    <footer class=\"py-20 bg-[#100C08] border-t border-[#2D2A2D] px-6\" data-kid=\"220\">\n        <div class=\"max-w-7xl mx-auto\" data-kid=\"221\">\n            <div class=\"flex flex-col md:flex-row justify-between items-start gap-12 mb-20\" data-kid=\"222\">\n                <div class=\"max-w-xs\" data-kid=\"223\">\n                    <div class=\"flex items-center gap-2 mb-6\" data-kid=\"224\">\n                        <div class=\"w-8 h-8 bg-[#DF00FF] rounded-lg flex items-center justify-center\" data-kid=\"225\">\n                            <i class=\"ti ti-chart-dots-3 text-black text-xl\" data-kid=\"226\"></i>\n                        </div>\n                        <span class=\"text-xl font-bold tracking-tight font-['Inter']\" data-kid=\"227\">AdAudit AI</span>\n                    </div>\n                    <p class=\"text-[#8A8A8A] text-sm leading-relaxed\" data-kid=\"228\">The standard for modern ad auditing. Data-driven growth for teams that care about efficiency.</p>\n                </div>\n                \n                <div class=\"grid grid-cols-2 md:grid-cols-3 gap-16 md:gap-24\" data-kid=\"229\">\n                    <div data-kid=\"230\">\n                        <h5 class=\"text-[#F5F5F5] font-bold text-sm mb-6 uppercase tracking-widest\" data-kid=\"231\">Product</h5>\n                        <ul class=\"space-y-4\" data-kid=\"232\">\n                            <li data-kid=\"233\"><a href=\"#\" class=\"text-[#8A8A8A] hover:text-[#DF00FF] transition-colors text-sm\" data-kid=\"234\">Dashboard</a></li>\n                            <li data-kid=\"235\"><a href=\"#\" class=\"text-[#8A8A8A] hover:text-[#DF00FF] transition-colors text-sm\" data-kid=\"236\">Integrations</a></li>\n                            <li data-kid=\"237\"><a href=\"#\" class=\"text-[#8A8A8A] hover:text-[#DF00FF] transition-colors text-sm\" data-kid=\"238\">Pricing</a></li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"239\">\n                        <h5 class=\"text-[#F5F5F5] font-bold text-sm mb-6 uppercase tracking-widest\" data-kid=\"240\">Resources</h5>\n                        <ul class=\"space-y-4\" data-kid=\"241\">\n                            <li data-kid=\"242\"><a href=\"#\" class=\"text-[#8A8A8A] hover:text-[#DF00FF] transition-colors text-sm\" data-kid=\"243\">Documentation</a></li>\n                            <li data-kid=\"244\"><a href=\"#\" class=\"text-[#8A8A8A] hover:text-[#DF00FF] transition-colors text-sm\" data-kid=\"245\">Blog</a></li>\n                            <li data-kid=\"246\"><a href=\"#\" class=\"text-[#8A8A8A] hover:text-[#DF00FF] transition-colors text-sm\" data-kid=\"247\">Changelog</a></li>\n                        </ul>\n                    </div>\n                    <div data-kid=\"248\">\n                        <h5 class=\"text-[#F5F5F5] font-bold text-sm mb-6 uppercase tracking-widest\" data-kid=\"249\">Company</h5>\n                        <ul class=\"space-y-4\" data-kid=\"250\">\n                            <li data-kid=\"251\"><a href=\"#\" class=\"text-[#8A8A8A] hover:text-[#DF00FF] transition-colors text-sm\" data-kid=\"252\">About</a></li>\n                            <li data-kid=\"253\"><a href=\"#\" class=\"text-[#8A8A8A] hover:text-[#DF00FF] transition-colors text-sm\" data-kid=\"254\">Contact</a></li>\n                            <li data-kid=\"255\"><a href=\"#\" class=\"text-[#8A8A8A] hover:text-[#DF00FF] transition-colors text-sm\" data-kid=\"256\">Privacy</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"flex flex-col md:flex-row justify-between items-center pt-10 border-t border-[#2D2A2D] gap-6\" data-kid=\"257\">\n                <p class=\"text-[#8A8A8A] text-xs\" data-kid=\"258\">&copy; 2024 AdAudit AI Inc. All rights reserved.</p>\n                <div class=\"flex gap-6\" data-kid=\"259\">\n                    <a href=\"#\" class=\"text-[#8A8A8A] hover:text-[#F5F5F5] transition-colors\" data-kid=\"260\"><i class=\"ti ti-brand-twitter text-xl\" data-kid=\"261\"></i></a>\n                    <a href=\"#\" class=\"text-[#8A8A8A] hover:text-[#F5F5F5] transition-colors\" data-kid=\"262\"><i class=\"ti ti-brand-linkedin text-xl\" data-kid=\"263\"></i></a>\n                    <a href=\"#\" class=\"text-[#8A8A8A] hover:text-[#F5F5F5] transition-colors\" data-kid=\"264\"><i class=\"ti ti-brand-github text-xl\" data-kid=\"265\"></i></a>\n                </div>\n            </div>\n        </div>\n    </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"266\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"267\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.min.js\" data-kid=\"268\"></script>\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.css\" data-kid=\"269\">\n\n<script data-kid=\"270\">\n    document.addEventListener('DOMContentLoaded', () => {\n        gsap.registerPlugin(ScrollTrigger);\n\n        // Initialize Locomotive Scroll v5\n        const locomotiveScroll = new LocomotiveScroll();\n\n        // Hero Animations\n        const heroTl = gsap.timeline({ defaults: { ease: \"power4.out\" } });\n        \n        heroTl.from(\"#hero-title\", {\n            y: 50,\n            autoAlpha: 0,\n            duration: 1.2\n        })\n        .from(\"#hero-subtext\", {\n            y: 30,\n            autoAlpha: 0,\n            duration: 1\n        }, \"-=0.8\")\n        .from(\"#hero-ctas\", {\n            y: 20,\n            autoAlpha: 0,\n            duration: 1\n        }, \"-=0.8\")\n        .from(\".browser-mockup\", {\n            y: 100,\n            autoAlpha: 0,\n            duration: 1.5\n        }, \"-=1\");\n\n        // Step Animations\n        gsap.utils.toArray('.step-container').forEach((step, i) => {\n            gsap.from(step.querySelector('.step-item-content'), {\n                scrollTrigger: {\n                    trigger: step,\n                    start: \"top 80%\",\n                    once: true\n                },\n                x: i % 2 === 0 ? -50 : 50,\n                autoAlpha: 0,\n                duration: 1,\n                ease: \"power3.out\"\n            });\n            \n            gsap.from(step.querySelector('.step-item-glass'), {\n                scrollTrigger: {\n                    trigger: step,\n                    start: \"top 80%\",\n                    once: true\n                },\n                x: i % 2 === 0 ? 50 : -50,\n                autoAlpha: 0,\n                duration: 1.2,\n                delay: 0.2,\n                ease: \"power3.out\"\n            });\n        });\n\n        // Peek Cards Batch Animation\n        gsap.set(\".peek-card\", { autoAlpha: 0, y: 50 });\n        ScrollTrigger.batch(\".peek-card\", {\n            start: \"top 80%\",\n            onEnter: (elements) => {\n                gsap.to(elements, {\n                    autoAlpha: 1,\n                    y: 0,\n                    stagger: 0.15,\n                    duration: 0.8,\n                    ease: \"power3.out\"\n                });\n            }\n        });\n\n        // Nav Scroll Effect\n        window.addEventListener('scroll', () => {\n            const nav = document.querySelector('nav');\n            if (window.scrollY > 50) {\n                nav.classList.add('py-4');\n                nav.querySelector('.max-w-7xl').classList.add('shadow-xl');\n            } else {\n                nav.classList.remove('py-4');\n                nav.querySelector('.max-w-7xl').classList.remove('shadow-xl');\n            }\n        });\n    });\n</script>\n</div>",
